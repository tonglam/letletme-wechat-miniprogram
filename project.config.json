{
  "description": "LetLetMe Fantasy Premier League WeChat Mini Program",
  "miniprogramRoot": "miniprogram/",
  "compileType": "miniprogram",
  "setting": {
    "useCompilerPlugins": [
      "typescript"
    ],
    "babelSetting": {
      "ignore": [],
      "disablePlugins": [],
      "outputPath": ""
    },
    "coverView": false,
    "postcss": false,
    "minified": true,
    "enhance": true,
    "showShadowRootInWxmlPanel": false,
    "packNpmRelationList": [
      {
        "packageJsonPath": "./package.json",
        "miniprogramNpmDistDir": "./miniprogram/"
      }
    ],
    "ignoreUploadUnusedFiles": true,
    "compileHotReLoad": false,
    "skylineRenderEnable": false,
    "es6": true,
    "compileWorklet": false,
    "uglifyFileName": true,
    "uploadWithSourceMap": true,
    "packNpmManually": true,
    "minifyWXSS": true,
    "minifyWXML": true,
    "localPlugins": false,
    "condition": false,
    "swc": false,
    "disableSWC": true,
    "disableUseStrict": false
  },
  "simulatorType": "wechat",
  "simulatorPluginLibVersion": {},
  "condition": {},
  "srcMiniprogramRoot": "miniprogram/",
  "editorSetting": {
    "tabIndent": "insertSpaces",
    "tabSize": 2
  },
  "libVersion": "trial",
  "packOptions": {
    "ignore": [
      {
        "type": "folder",
        "value": "assets/squad-pitch/kits"
      },
      {
        "type": "file",
        "value": "assets/squad-pitch/pitch-background.jpg"
      },
      {
        "type": "file",
        "value": "assets/squad-pitch/pitch-background.svg"
      }
    ],
    "include": []
  },
  "appid": "touristappid"
}
