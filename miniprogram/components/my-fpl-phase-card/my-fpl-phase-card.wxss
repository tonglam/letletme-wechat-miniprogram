.phase-card {
  padding: 32rpx 28rpx;
}

.phase-title {
  color: var(--ink);
  font-size: 34rpx;
  font-weight: 800;
  line-height: 1.3;
}

.phase-description {
  margin-top: 12rpx;
  color: var(--muted-ink);
  font-size: 26rpx;
  line-height: 1.5;
}

.phase-metrics {
  margin-top: 16rpx;
  color: var(--ink);
  font-size: 26rpx;
  font-weight: 700;
  line-height: 1.5;
}

.phase-actions {
  display: flex;
  align-items: center;
  margin-top: 24rpx;
}

/* Size modifiers on the global .btn-primary / .btn-secondary primitives */
.phase-primary {
  min-width: 200rpx;
  min-height: 88rpx;
}

.phase-secondary {
  min-height: 88rpx;
  margin-left: 20rpx;
}
