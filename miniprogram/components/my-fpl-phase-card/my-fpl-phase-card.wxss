.phase-card {
  box-sizing: border-box;
  padding: 32rpx 28rpx;
  background: var(--card, #ffffff);
  border: 1rpx solid var(--line, #ddd4de);
  border-radius: 16rpx;
}

.phase-title {
  color: var(--ink, #301333);
  font-size: 36rpx;
  font-weight: 800;
  line-height: 1.3;
}

.phase-description {
  margin-top: 12rpx;
  color: var(--muted-ink, #6e5a72);
  font-size: 26rpx;
  line-height: 1.5;
}

.phase-metrics {
  margin-top: 16rpx;
  color: var(--ink, #301333);
  font-size: 26rpx;
  font-weight: 700;
  line-height: 1.5;
}

.phase-actions {
  display: flex;
  align-items: center;
  margin-top: 24rpx;
}

.phase-primary {
  min-width: 200rpx;
  min-height: 88rpx;
  line-height: 88rpx;
  padding: 0 40rpx;
  box-sizing: border-box;
  border-radius: 999rpx;
  background: var(--green-ink, #008545);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 700;
  text-align: center;
}

.phase-primary-hover {
  opacity: 0.85;
}

.phase-secondary {
  min-height: 88rpx;
  line-height: 88rpx;
  margin-left: 20rpx;
  padding: 0 32rpx;
  box-sizing: border-box;
  border-radius: 999rpx;
  background: var(--track, #f1efe9);
  color: var(--green-ink, #008545);
  font-size: 26rpx;
  font-weight: 700;
  text-align: center;
}

.phase-secondary-hover {
  background: var(--accent-tint, #dcf6ea);
}
