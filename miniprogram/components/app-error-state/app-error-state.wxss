.error {
  box-sizing: border-box;
  margin: 0 24rpx;
  padding: 42rpx 32rpx 44rpx;
  border: 1rpx solid rgba(201, 24, 63, 0.18);
  border-radius: 20rpx;
  background:
    radial-gradient(circle at 88% 12%, rgba(255, 40, 130, 0.08), rgba(255, 40, 130, 0) 34%),
    #ffffff;
  box-shadow: 0 10rpx 30rpx rgba(56, 0, 60, 0.06);
  text-align: center;
}

.error-visual {
  position: relative;
  width: 104rpx;
  height: 78rpx;
  margin: 0 auto 24rpx;
  overflow: hidden;
  border-radius: 14rpx;
  background: linear-gradient(145deg, var(--fascia-hi, #2b0a33), var(--fascia, #1d0520));
  box-shadow: 0 10rpx 24rpx rgba(56, 0, 60, 0.14);
}

.error-visual::after {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  height: 4rpx;
  background: var(--pink, #ff2882);
  content: "";
}

.error-signal {
  position: absolute;
  bottom: 16rpx;
  width: 8rpx;
  border-radius: 3rpx 3rpx 0 0;
  background: rgba(249, 247, 242, 0.36);
}

.error-signal-one {
  left: 16rpx;
  height: 14rpx;
}

.error-signal-two {
  left: 30rpx;
  height: 26rpx;
}

.error-signal-three {
  left: 44rpx;
  height: 38rpx;
}

.error-mark {
  position: absolute;
  right: 18rpx;
  bottom: 10rpx;
  color: var(--pink, #ff2882);
  font-size: 38rpx;
  font-weight: 900;
  line-height: 1;
}

.error-eyebrow {
  margin-bottom: 10rpx;
  color: var(--danger, #c9183f);
  font-size: 20rpx;
  font-weight: 800;
  letter-spacing: 4rpx;
}

.error-message {
  color: var(--ink, #301333);
  font-size: 29rpx;
  font-weight: 800;
  line-height: 1.45;
}

.error-description {
  max-width: 540rpx;
  margin: 12rpx auto 0;
  color: var(--muted-ink, #6e5a72);
  font-size: 24rpx;
  line-height: 1.65;
}

.error-action {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 220rpx;
  height: 76rpx;
  margin: 28rpx auto 0;
  padding: 0 32rpx;
  border-radius: 12rpx;
  background: var(--cta, #00d16d);
  color: var(--cta-ink, #1a001e);
  font-size: 25rpx;
  font-weight: 800;
  line-height: 76rpx;
}

.error-action::after {
  border: 0;
}

.error-action-hover {
  opacity: 0.82;
}
