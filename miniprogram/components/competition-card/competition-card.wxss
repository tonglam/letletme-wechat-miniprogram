.competition-card {
  box-sizing: border-box;
  padding: 24rpx;
  background: var(--card, #ffffff);
  border: 1rpx solid var(--line, #ddd4de);
  border-radius: 12rpx;
}

.card-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.card-name {
  flex: 1;
  min-width: 0;
  color: var(--ink, #301333);
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1.4;
  word-break: break-all;
}

.card-badge {
  flex-shrink: 0;
  margin-left: 16rpx;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  background: var(--track, #f1efe9);
  color: var(--muted-ink, #6e5a72);
  font-size: 22rpx;
  font-weight: 700;
}

.card-badge.tone-good {
  background: var(--accent-tint, #dcf6ea);
  color: var(--green-ink, #008545);
}

.card-badge.tone-warn {
  color: #b25e09;
}

.card-tags {
  display: flex;
  align-items: center;
  margin-top: 12rpx;
}

.card-tag {
  flex-shrink: 0;
  padding: 2rpx 14rpx;
  border: 1rpx solid var(--line, #ddd4de);
  border-radius: 8rpx;
  color: var(--muted-ink, #6e5a72);
  font-size: 22rpx;
}

.card-meta {
  margin-left: 14rpx;
  overflow: hidden;
  color: var(--muted-ink, #6e5a72);
  font-size: 24rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.card-actions {
  display: flex;
  align-items: center;
  margin-top: 20rpx;
}

.card-primary {
  min-width: 168rpx;
  min-height: 88rpx;
  line-height: 88rpx;
  padding: 0 32rpx;
  box-sizing: border-box;
  border-radius: 999rpx;
  background: var(--green-ink, #008545);
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 700;
  text-align: center;
}

.card-primary-hover {
  opacity: 0.85;
}

.card-secondary {
  min-height: 88rpx;
  line-height: 88rpx;
  margin-left: 20rpx;
  padding: 0 28rpx;
  box-sizing: border-box;
  border-radius: 999rpx;
  background: var(--track, #f1efe9);
  color: var(--green-ink, #008545);
  font-size: 26rpx;
  font-weight: 700;
  text-align: center;
}

.card-secondary-hover {
  background: var(--accent-tint, #dcf6ea);
}
