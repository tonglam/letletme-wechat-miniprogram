<view class="competition-card">
  <view class="card-header">
    <view class="card-name">{{name}}</view>
    <view class="card-badge {{lifecycleTone}}">{{lifecycleLabel}}</view>
  </view>
  <view class="card-tags">
    <text class="card-tag">{{formatLabel}}</text>
    <text wx:if="{{metaText}}" class="card-meta">{{metaText}}</text>
  </view>
  <view class="card-actions">
    <view class="card-primary" hover-class="card-primary-hover" bindtap="onOpen">查看实时</view>
    <view class="card-secondary" hover-class="card-secondary-hover" bindtap="onManage">网页管理</view>
  </view>
</view>
