<view class="card">
  <view class="card-header">
    <view class="card-name">{{name}}</view>
    <view class="card-badge {{lifecycleTone}}">{{lifecycleLabel}}</view>
  </view>
  <view class="card-tags">
    <text class="card-tag">{{formatLabel}}</text>
    <text wx:if="{{metaText}}" class="card-meta">{{metaText}}</text>
  </view>
  <view class="card-actions">
    <view class="btn-primary card-primary" hover-class="hover-dim" bindtap="onOpen">查看实时</view>
    <view class="btn-secondary card-secondary" hover-class="hover-dim" bindtap="onManage">网页管理</view>
  </view>
</view>
