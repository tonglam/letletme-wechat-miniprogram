/* ---------- Shared (compact row + empty state) ---------- */

.entry-content,
.entry-empty,
.entry-desk {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.entry-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.entry-name-block {
  flex: 1;
  min-width: 0;
}

.entry-title {
  overflow: hidden;
  color: var(--ink);
  font-size: 30rpx;
  font-weight: 800;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.entry-subtitle {
  margin-top: 8rpx;
  color: var(--muted-ink);
  font-size: 24rpx;
}

.entry-head .action,
.entry-empty .action {
  flex-shrink: 0;
  padding: 4rpx 0 4rpx 12rpx;
}

.entry-meta {
  flex-shrink: 0;
  color: var(--green-ink);
  font-size: 26rpx;
  font-weight: 700;
}

/* ---------- Rich team desk (home) ---------- */

.entry-desk {
  flex-direction: column;
  align-items: stretch;
  gap: 0;
}

.entry-desk .entry-title {
  font-size: 34rpx;
  letter-spacing: 0.5rpx;
}

.entry-desk .entry-head .action {
  padding-top: 10rpx;
}

/* Metric band — personal scoreboard, echoes the deadline fascia panel */
.entry-metric-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  margin-top: 24rpx;
  padding: 22rpx 0;
  overflow: hidden;
  border: 1rpx solid var(--electric-a28);
  border-radius: 14rpx;
  background:
    radial-gradient(ellipse 120% 90% at 50% -30%, var(--plum-a70), rgba(56, 0, 60, 0) 60%),
    linear-gradient(180deg, var(--fascia-hi), var(--fascia));
  box-shadow: inset 0 1rpx 0 var(--electric-a28);
}

.entry-metric {
  min-width: 0;
  padding: 0 8rpx;
  text-align: center;
  box-sizing: border-box;
}

.entry-metric-value {
  display: block;
  overflow: hidden;
  color: var(--electric);
  font-size: 34rpx;
  font-weight: 800;
  font-variant-numeric: tabular-nums;
  line-height: 1.2;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.entry-metric-label {
  display: block;
  margin-top: 8rpx;
  color: var(--chalk-a60);
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

/* Leagues */
.entry-leagues {
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--line);
}

.entry-leagues-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 4rpx;
}

.entry-leagues-title {
  color: var(--muted-ink);
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.entry-leagues-count {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 32rpx;
  height: 32rpx;
  padding: 0 10rpx;
  border-radius: 16rpx;
  background: var(--plum-a8);
  color: var(--muted-ink);
  font-size: 20rpx;
  box-sizing: border-box;
}

.entry-league-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 14rpx 0;
  border-bottom: 1rpx solid var(--plum-a8);
}

.entry-league-row:last-of-type {
  padding-bottom: 4rpx;
  border-bottom: 0;
}

.entry-league-name {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  color: var(--ink);
  font-size: 26rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.entry-league-rank {
  flex-shrink: 0;
  color: var(--green-ink);
  font-size: 22rpx;
  font-weight: 800;
  font-variant-numeric: tabular-nums;
}
