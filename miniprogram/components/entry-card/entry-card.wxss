/* ---------- Shared (compact row + empty state) ---------- */

.entry-content,
.entry-empty,
.entry-desk {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.entry-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.entry-name-block {
  flex: 1;
  min-width: 0;
}

.entry-title {
  overflow: hidden;
  color: var(--ink);
  font-size: 30rpx;
  font-weight: 800;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.entry-subtitle {
  margin-top: 8rpx;
  color: var(--muted-ink);
  font-size: 24rpx;
}

.entry-head .action,
.entry-empty .action {
  flex-shrink: 0;
  padding: 4rpx 0 4rpx 12rpx;
}

.entry-meta {
  flex-shrink: 0;
  color: var(--green-ink);
  font-size: 26rpx;
  font-weight: 700;
}

/* ---------- Rich team desk (home) ---------- */

.entry-desk {
  flex-direction: column;
  align-items: stretch;
  gap: 0;
}

.entry-desk .entry-title {
  font-size: 34rpx;
  letter-spacing: 0.5rpx;
}

.entry-desk .entry-head .action {
  padding-top: 10rpx;
}

/* Metric band — personal scoreboard, echoes the deadline fascia panel */
.entry-metric-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  margin-top: 24rpx;
  padding: 22rpx 0;
  overflow: hidden;
  border: 1rpx solid var(--electric-a28);
  border-radius: 14rpx;
  background:
    radial-gradient(ellipse 120% 90% at 50% -30%, var(--plum-a70), rgba(56, 0, 60, 0) 60%),
    linear-gradient(180deg, var(--fascia-hi), var(--fascia));
  box-shadow: inset 0 1rpx 0 var(--electric-a28);
}

.entry-metric {
  min-width: 0;
  padding: 0 8rpx;
  text-align: center;
  box-sizing: border-box;
}

.entry-metric-value {
  display: block;
  overflow: hidden;
  color: var(--electric);
  font-size: 34rpx;
  font-weight: 800;
  font-variant-numeric: tabular-nums;
  line-height: 1.2;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.entry-metric-label {
  display: block;
  margin-top: 8rpx;
  color: var(--chalk-a60);
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

/* League panels — Classic / H2H stacked, parallel cards */
.entry-league-stack {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 24rpx;
}

.entry-league-panel {
  padding: 16rpx 18rpx 12rpx;
  border: 1rpx solid var(--line);
  border-radius: 14rpx;
  background: var(--surface, transparent);
}

.entry-leagues-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 4rpx;
}

.entry-leagues-head-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex-shrink: 0;
}

.league-share-btn {
  width: 52rpx;
  height: 52rpx;
  padding: 0;
}

.league-share-btn .tool-icon {
  width: 26rpx;
  height: 26rpx;
}

.entry-leagues-title-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  min-width: 0;
}

.entry-leagues-title {
  color: var(--muted-ink);
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.entry-leagues-count {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 32rpx;
  height: 32rpx;
  padding: 0 10rpx;
  border-radius: 16rpx;
  background: var(--plum-a8);
  color: var(--muted-ink);
  font-size: 20rpx;
  box-sizing: border-box;
}

.entry-league-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 14rpx 0;
  border-bottom: 1rpx solid var(--plum-a8);
}

.entry-league-row:last-of-type {
  padding-bottom: 4rpx;
  border-bottom: 0;
}

.entry-league-name {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  color: var(--ink);
  font-size: 26rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.entry-league-main {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex: 1;
  min-width: 0;
}

.entry-league-badge {
  flex-shrink: 0;
  padding: 3rpx 10rpx;
  border-radius: 8rpx;
  font-size: 18rpx;
  font-weight: 700;
  line-height: 1.4;
}

.entry-league-badge.visibility-public {
  background: var(--accent-tint);
  color: var(--green-ink);
}

.entry-league-badge.visibility-private {
  background: var(--track);
  color: var(--muted-ink);
}

.entry-league-side {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  gap: 10rpx;
}

.entry-league-movement {
  font-size: 20rpx;
  font-weight: 800;
  font-variant-numeric: tabular-nums;
}

.entry-league-movement.movement-up {
  color: var(--green-ink);
}

.entry-league-movement.movement-down {
  color: var(--danger);
}

.entry-league-rank {
  flex-shrink: 0;
  color: var(--green-ink);
  font-size: 22rpx;
  font-weight: 800;
  font-variant-numeric: tabular-nums;
}

.entry-league-more {
  padding: 16rpx 0 4rpx;
  text-align: center;
}

.entry-h2h-row {
  padding: 18rpx 0;
  border-bottom: 1rpx solid var(--plum-a8);
}

.entry-h2h-row:last-of-type {
  padding-bottom: 4rpx;
  border-bottom: 0;
}

.entry-h2h-head,
.entry-h2h-tags,
.entry-h2h-matchup {
  display: flex;
  align-items: center;
}

.entry-h2h-head {
  justify-content: space-between;
  gap: 12rpx;
}

.entry-h2h-tags {
  flex-shrink: 0;
  gap: 6rpx;
}

.entry-h2h-tag,
.entry-h2h-rank {
  padding: 3rpx 8rpx;
  border: 1rpx solid var(--line);
  border-radius: 999rpx;
  color: var(--muted-ink);
  font-size: 18rpx;
  font-weight: 700;
  line-height: 1.3;
}

.entry-h2h-status-live {
  border-color: var(--electric-a28);
  background: var(--electric-a12);
  color: var(--green-ink);
}

.entry-h2h-status-final {
  background: var(--plum-a8);
}

.entry-h2h-rank {
  border: 0;
  padding-right: 0;
}

.entry-h2h-matchup {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
  gap: 12rpx;
  margin-top: 16rpx;
}

.entry-h2h-side {
  min-width: 0;
}

.entry-h2h-viewer {
  text-align: right;
}

.entry-h2h-primary,
.entry-h2h-secondary {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.entry-h2h-primary {
  color: var(--ink);
  font-size: 24rpx;
  font-weight: 800;
}

.entry-h2h-secondary,
.entry-h2h-empty {
  margin-top: 4rpx;
  color: var(--muted-ink);
  font-size: 20rpx;
}

.entry-h2h-center {
  min-width: 76rpx;
  padding: 10rpx 12rpx;
  border: 1rpx solid var(--line);
  border-radius: 10rpx;
  background: var(--surface, transparent);
  color: var(--muted-ink);
  font-size: 20rpx;
  font-weight: 800;
  text-align: center;
  box-sizing: border-box;
}

.entry-h2h-score {
  color: var(--green-ink);
  font-variant-numeric: tabular-nums;
}

.entry-h2h-empty {
  display: block;
  margin-top: 12rpx;
}
