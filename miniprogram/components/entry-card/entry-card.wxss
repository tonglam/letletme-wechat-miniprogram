.entry-card {
  position: relative;
  background: #ffffff;
  border-radius: 8rpx;
  padding: 24rpx;
}

.entry-content,
.entry-empty {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.entry-content-rich {
  align-items: stretch;
}

.entry-main {
  flex: 1;
  min-width: 0;
}

.entry-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.entry-name-block {
  flex: 1;
  min-width: 0;
}

.entry-title {
  color: #111827;
  font-size: 32rpx;
  font-weight: 700;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.entry-subtitle {
  margin-top: 8rpx;
  color: #667085;
  font-size: 24rpx;
}

.entry-meta {
  flex-shrink: 0;
  color: #2563eb;
  font-size: 26rpx;
  font-weight: 600;
}

.entry-meta-line {
  margin-top: 14rpx;
  color: #667085;
  font-size: 22rpx;
}

.entry-stat-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 12rpx;
  margin-top: 18rpx;
}

.entry-stat {
  min-height: 86rpx;
  padding: 14rpx 16rpx;
  background: #f8fafc;
  border: 1rpx solid #eef2f7;
  border-radius: 8rpx;
  box-sizing: border-box;
}

.entry-stat-label {
  display: block;
  color: #667085;
  font-size: 21rpx;
}

.entry-stat-value {
  display: block;
  margin-top: 6rpx;
  color: #111827;
  font-size: 28rpx;
  font-weight: 750;
}

.entry-transfer {
  margin-top: 14rpx;
  color: #667085;
  font-size: 22rpx;
}

.entry-action {
  margin-top: 20rpx;
}

.entry-action-inline {
  flex-shrink: 0;
  margin-top: 0;
  margin-right: 0;
  padding: 0 24rpx;
  min-width: 104rpx;
  height: 52rpx;
  line-height: 50rpx;
  border-radius: 999rpx;
  color: #2563eb;
  background: #eff6ff;
  border-color: #bfdbfe;
  font-size: 15rpx;
}
