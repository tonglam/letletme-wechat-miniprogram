.entry-card {
  position: relative;
  background: var(--card, #ffffff);
  border: 1rpx solid var(--line, #ddd4de);
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(56, 0, 60, 0.04);
}

.entry-content,
.entry-empty {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.entry-content-rich {
  align-items: stretch;
}

.entry-main {
  flex: 1;
  min-width: 0;
}

.entry-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.entry-name-block {
  flex: 1;
  min-width: 0;
}

.entry-title {
  color: var(--ink, #301333);
  font-size: 32rpx;
  font-weight: 700;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.entry-subtitle {
  margin-top: 8rpx;
  color: var(--muted-ink, #6e5a72);
  font-size: 24rpx;
}

.entry-meta {
  flex-shrink: 0;
  color: var(--green-ink, #008545);
  font-size: 26rpx;
  font-weight: 700;
}

.entry-meta-line {
  margin-top: 14rpx;
  color: var(--muted-ink, #6e5a72);
  font-size: 22rpx;
}

.entry-stat-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 12rpx;
  margin-top: 18rpx;
}

.entry-stat {
  min-height: 86rpx;
  padding: 14rpx 16rpx;
  background: var(--track, #f1efe9);
  border-radius: 12rpx;
  box-sizing: border-box;
}

.entry-stat-label {
  display: block;
  color: var(--muted-ink, #6e5a72);
  font-size: 21rpx;
}

.entry-stat-value {
  display: block;
  margin-top: 6rpx;
  color: var(--ink, #301333);
  font-size: 28rpx;
  font-weight: 750;
}

.entry-transfer {
  margin-top: 14rpx;
  color: var(--muted-ink, #6e5a72);
  font-size: 22rpx;
}

.entry-action {
  margin-top: 20rpx;
}

/* Pill CTA — pitch green, plum text (web primary button) */
.entry-action-inline {
  flex-shrink: 0;
  margin-top: 0;
  margin-right: 0;
  padding: 0 24rpx;
  min-width: 104rpx;
  height: 56rpx;
  line-height: 54rpx;
  border-radius: 999rpx;
  color: var(--cta-ink, #1a001e);
  background: var(--cta, #00d16d);
  border-color: transparent;
  font-size: 22rpx;
  font-weight: 700;
}

.entry-action-inline::after {
  border: 0;
}
