<view class="card">
  <view wx:if="{{entry && (entry.entry || entry.entryId || entry.entryName || entry.teamName)}}" class="{{rich ? 'entry-desk' : 'entry-content'}}" hover-class="hover-dim" bindtap="onOpen">
    <view class="entry-head">
      <view class="entry-name-block">
        <view class="entry-title">{{entry.entryName || entry.teamName || '已选择球队'}}</view>
        <view class="entry-subtitle">{{entry.playerName || ''}}</view>
      </view>
      <text wx:if="{{!compact}}" class="action" catchtap="onChange">切换</text>
    </view>

    <view wx:if="{{rich}}" class="entry-metric-grid">
      <view wx:for="{{statRows}}" wx:key="label" class="entry-metric">
        <text class="entry-metric-value">{{item.value}}</text>
        <text class="entry-metric-label">{{item.label}}</text>
      </view>
    </view>

    <view wx:if="{{rich && hasLeaguePanels}}" class="entry-league-stack">
      <view wx:if="{{classicPanel}}" class="entry-league-panel">
        <view class="entry-leagues-head">
          <view class="entry-leagues-title-row">
            <text class="entry-leagues-title">{{classicPanel.title}}</text>
            <text class="entry-leagues-count">{{classicPanel.total}}</text>
          </view>
          <view class="entry-leagues-head-actions">
            <view class="tool-btn league-share-btn {{shareImageBusy ? 'done' : ''}}" catchtap="onShareLeagueImage" data-panel="classic" hover-class="hover-dim">
              <image class="tool-icon" src="/assets/icons/image.svg" mode="aspectFit" />
            </view>
            <text class="action" catchtap="onOpenAllLeagues">全部</text>
          </view>
        </view>
        <view wx:for="{{classicPanel.items}}" wx:key="id" class="entry-league-row">
          <view class="entry-league-main">
            <text wx:if="{{item.visibilityText}}" class="entry-league-badge {{item.visibilityClass}}">{{item.visibilityText}}</text>
            <text class="entry-league-name">{{item.name}}</text>
          </view>
          <view class="entry-league-side">
            <text wx:if="{{item.movementText}}" class="entry-league-movement {{item.movementClass}}">{{item.movementText}}</text>
            <text wx:if="{{item.viewerRank || item.rank}}" class="entry-league-rank">{{item.viewerRank || item.rank}}</text>
          </view>
        </view>
        <view wx:if="{{classicPanel.hasMore}}" class="entry-league-more" hover-class="hover-dim" catchtap="onLoadMoreClassic">
          <text class="action">加载更多</text>
        </view>
      </view>

      <view wx:if="{{h2hPanel}}" class="entry-league-panel">
        <view class="entry-leagues-head">
          <view class="entry-leagues-title-row">
            <text class="entry-leagues-title">{{h2hPanel.title}}</text>
            <text class="entry-leagues-count">{{h2hPanel.total}}</text>
          </view>
          <view class="entry-leagues-head-actions">
            <view class="tool-btn league-share-btn {{shareImageBusy ? 'done' : ''}}" catchtap="onShareLeagueImage" data-panel="h2h" hover-class="hover-dim">
              <image class="tool-icon" src="/assets/icons/image.svg" mode="aspectFit" />
            </view>
            <text class="action" catchtap="onOpenAllLeagues">全部</text>
          </view>
        </view>
        <view wx:for="{{h2hPanel.items}}" wx:key="id" class="entry-h2h-row">
          <view class="entry-h2h-head">
            <text class="entry-league-name">{{item.name}}</text>
            <view class="entry-h2h-tags">
              <text wx:if="{{item.h2h}}" class="entry-h2h-tag">{{item.h2h.eventLabel}}</text>
              <text wx:if="{{item.h2h}}" class="entry-h2h-tag entry-h2h-status entry-h2h-status-{{item.h2h.statusKey}}">{{item.h2h.statusLabel}}</text>
              <text wx:if="{{item.rankText}}" class="entry-h2h-rank">{{item.rankText}}</text>
            </view>
          </view>
          <view wx:if="{{item.h2h}}" class="entry-h2h-matchup">
            <view class="entry-h2h-side entry-h2h-viewer">
              <text class="entry-h2h-primary">{{item.h2h.viewer.primary}}</text>
              <text wx:if="{{item.h2h.viewer.secondary}}" class="entry-h2h-secondary">{{item.h2h.viewer.secondary}}</text>
            </view>
            <view class="entry-h2h-center {{item.h2h.showScore ? 'entry-h2h-score' : ''}}">{{item.h2h.centerLabel}}</view>
            <view class="entry-h2h-side">
              <text class="entry-h2h-primary">{{item.h2h.opponent.primary}}</text>
              <text wx:if="{{item.h2h.opponent.secondary}}" class="entry-h2h-secondary">{{item.h2h.opponent.secondary}}</text>
            </view>
          </view>
          <text wx:else class="entry-h2h-empty">暂无当前对阵</text>
        </view>
        <view wx:if="{{h2hPanel.hasMore}}" class="entry-league-more" hover-class="hover-dim" catchtap="onLoadMoreH2h">
          <text class="action">加载更多</text>
        </view>
      </view>
    </view>

    <view wx:if="{{!rich}}" class="entry-meta">
      <text wx:if="{{entry.totalPoints}}">{{entry.totalPoints}} pts</text>
      <text wx:elif="{{entry.entry || entry.entryId}}">#{{entry.entry || entry.entryId}}</text>
    </view>
  </view>

  <view wx:else class="entry-empty" hover-class="hover-dim" bindtap="onChange">
    <view>
      <view class="entry-title">选择我的球队</view>
      <view class="entry-subtitle">输入 Entry ID，首页会跟着这支球队走</view>
    </view>
    <text wx:if="{{!compact}}" class="action">去选择</text>
  </view>
</view>
