.empty {
  box-sizing: border-box;
  padding: 44rpx 24rpx 48rpx;
  text-align: center;
  color: var(--muted-ink);
}

.empty-visual {
  position: relative;
  width: 104rpx;
  height: 78rpx;
  margin: 0 auto 24rpx;
  overflow: hidden;
  border: 1rpx solid rgba(0, 255, 133, 0.3);
  border-radius: 14rpx;
  background: linear-gradient(145deg, var(--fascia-hi), var(--fascia));
  box-shadow: 0 10rpx 24rpx rgba(56, 0, 60, 0.14);
}

.empty-visual::after {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  height: 4rpx;
  background: var(--electric);
  content: "";
}

.visual-head {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 10rpx 12rpx 0;
}

.visual-live {
  width: 8rpx;
  height: 8rpx;
  flex-shrink: 0;
  border-radius: 50%;
  background: var(--pink);
  box-shadow: 0 0 10rpx rgba(255, 40, 130, 0.7);
}

.visual-head-line {
  width: 30rpx;
  height: 4rpx;
  border-radius: 999rpx;
  background: rgba(249, 247, 242, 0.34);
}

.visual-bars {
  position: absolute;
  bottom: 14rpx;
  left: 14rpx;
  display: flex;
  align-items: flex-end;
  gap: 6rpx;
  height: 34rpx;
}

.visual-bar {
  width: 8rpx;
  border-radius: 3rpx 3rpx 0 0;
  background: var(--electric);
  opacity: 0.84;
}

.visual-bar-short {
  height: 12rpx;
}

.visual-bar-mid {
  height: 20rpx;
}

.visual-bar-tall {
  height: 30rpx;
}

.visual-zero {
  position: absolute;
  right: 14rpx;
  bottom: 10rpx;
  color: rgba(249, 247, 242, 0.72);
  font-size: 34rpx;
  font-weight: 800;
  line-height: 1;
}

.empty-eyebrow {
  margin-bottom: 10rpx;
  color: var(--green-ink);
  font-size: 20rpx;
  font-weight: 800;
  letter-spacing: 4rpx;
}

.empty-title {
  color: var(--ink);
  font-size: 28rpx;
  font-weight: 800;
  line-height: 1.4;
}

.empty-description {
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.65;
}

/* Layout-only; visuals come from the global .btn-primary primitive */
.empty-action {
  margin: 28rpx auto 0;
}

/* Featured shell — global .card base + feature modifiers */
.empty-featured {
  position: relative;
  min-height: 430rpx;
  padding: 54rpx 42rpx 58rpx;
  overflow: hidden;
  border-radius: 20rpx;
  background:
    radial-gradient(circle at 88% 12%, rgba(0, 255, 133, 0.12), rgba(0, 255, 133, 0) 30%),
    linear-gradient(180deg, var(--card), var(--card));
  box-shadow: 0 10rpx 32rpx rgba(56, 0, 60, 0.07);
}

.empty-featured::before {
  position: absolute;
  top: 0;
  right: 0;
  left: 0;
  height: 6rpx;
  background: linear-gradient(90deg, var(--electric), var(--pink));
  content: "";
}

.empty-featured .empty-visual {
  width: 176rpx;
  height: 126rpx;
  margin-bottom: 32rpx;
  border-radius: 20rpx;
  box-shadow: 0 18rpx 38rpx rgba(56, 0, 60, 0.2);
}

.empty-featured .visual-head {
  gap: 12rpx;
  padding: 16rpx 18rpx 0;
}

.empty-featured .visual-live {
  width: 11rpx;
  height: 11rpx;
}

.empty-featured .visual-head-line {
  width: 52rpx;
  height: 6rpx;
}

.empty-featured .visual-bars {
  bottom: 20rpx;
  left: 22rpx;
  gap: 9rpx;
  height: 54rpx;
}

.empty-featured .visual-bar {
  width: 12rpx;
  border-radius: 4rpx 4rpx 0 0;
}

.empty-featured .visual-bar-short {
  height: 20rpx;
}

.empty-featured .visual-bar-mid {
  height: 34rpx;
}

.empty-featured .visual-bar-tall {
  height: 50rpx;
}

.empty-featured .visual-zero {
  right: 22rpx;
  bottom: 17rpx;
  font-size: 56rpx;
}

.empty-featured .empty-title {
  font-size: 34rpx;
  font-weight: 900;
}

.empty-featured .empty-description {
  max-width: 540rpx;
  margin-right: auto;
  margin-left: auto;
}
