.data-status {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  box-sizing: border-box;
  margin: 16rpx 0;
  padding: 18rpx 20rpx;
  border: 1rpx solid rgba(48, 19, 51, 0.12);
  border-radius: 14rpx;
  background: #f8f5ef;
  color: #5f4d62;
  font-size: 23rpx;
  line-height: 1.45;
}

.data-status-stale,
.data-status-offline {
  border-color: rgba(179, 117, 0, 0.22);
  background: #fff8e7;
  color: #785400;
}

.data-status-error,
.data-status-partial {
  border-color: rgba(201, 24, 63, 0.2);
  background: #fff3f5;
  color: #8f1735;
}

.data-status-dot {
  flex: 0 0 auto;
  width: 12rpx;
  height: 12rpx;
  margin-top: 10rpx;
  border-radius: 50%;
  background: currentColor;
}

.data-status-copy {
  display: flex;
  flex: 1;
  flex-direction: column;
  min-width: 0;
}

.data-status-message {
  font-weight: 700;
}

.data-status-time {
  margin-top: 4rpx;
  opacity: 0.72;
  font-size: 20rpx;
}

.data-status-action {
  flex: 0 0 auto;
  color: var(--ink, #301333);
  font-weight: 800;
}
