.data-status {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  box-sizing: border-box;
  margin: 16rpx 0;
  padding: 18rpx 20rpx;
  border: 1rpx solid var(--ink-a12);
  border-radius: 14rpx;
  background: var(--bg);
  color: var(--muted-ink);
  font-size: 22rpx;
  line-height: 1.45;
}

.data-status-stale,
.data-status-offline {
  border-color: var(--warning-a25);
  background: var(--warning-tint);
  color: var(--warning);
}

.data-status-error,
.data-status-partial {
  border-color: var(--danger-a20);
  background: var(--danger-tint);
  color: var(--danger);
}

.data-status-dot {
  flex: 0 0 auto;
  width: 12rpx;
  height: 12rpx;
  margin-top: 10rpx;
  border-radius: 50%;
  background: currentColor;
}

.data-status-copy {
  display: flex;
  flex: 1;
  flex-direction: column;
  min-width: 0;
}

.data-status-message {
  font-weight: 700;
}

.data-status-time {
  margin-top: 4rpx;
  opacity: 0.72;
  font-size: 20rpx;
}

.data-status-action {
  flex: 0 0 auto;
  color: var(--ink);
  font-weight: 800;
}
