<view wx:if="{{visible}}" class="data-status data-status-{{status}}" role="status">
  <view class="data-status-dot"></view>
  <view class="data-status-copy">
    <text class="data-status-message">{{displayMessage}}</text>
    <text wx:if="{{storedAtText}}" class="data-status-time">上次成功 {{storedAtText}}</text>
  </view>
  <view wx:if="{{showRetry}}" class="data-status-action {{retryDisabled ? 'is-disabled' : ''}}" role="button" aria-disabled="{{retryDisabled}}" hover-class="hover-dim" bindtap="onRetry">{{retryButtonText}}</view>
</view>
