<wxs src="/components/pos.wxs" module="pos" />
<view class="player-row {{player.statusClass || ''}}" hover-class="hover-dim" bindtap="onOpen">
  <view class="player-main">
    <view class="player-title-line">
      <view class="player-name">{{player.name || player.webName || '-'}}</view>
      <text wx:if="{{player.roleText}}" class="role-badge">{{player.roleText}}</text>
      <text wx:if="{{player.autoSubArrow}}" class="autosub-badge {{player.autoSubIncoming ? 'autosub-in' : 'autosub-out'}} {{player.autoSubPredicted ? 'autosub-predicted' : ''}}">{{player.autoSubArrow}}</text>
    </view>
    <view class="player-meta">
      <text wx:if="{{showTeam}}">{{player.team || player.teamShortName || ''}}</text>
      <text wx:if="{{player.position || player.elementTypeName}}" class="pos-badge {{pos.cls(player.position || player.elementTypeName)}} player-pos">{{player.position || player.elementTypeName}}</text>
      <text wx:if="{{player.statText}}" class="stat-text"> · {{player.statText}}</text>
      <text wx:if="{{showLiveMeta && player.metaText}}"> · {{player.metaText}}</text>
    </view>
  </view>
  <view class="player-side">
    <text wx:if="{{showPoints}}" class="player-points">{{player.pointsText || player.points || player.livePoints || player.totalPoints || 0}}分</text>
    <text wx:elif="{{showPrice}}">{{player.priceText || player.price || ''}}</text>
    <text wx:if="{{showPoints && showPrice && player.priceText}}" class="player-price-sub">{{player.priceText}}</text>
    <text wx:if="{{showLiveMeta && player.statusText}}" class="status-text">{{player.statusText}}</text>
  </view>
</view>
