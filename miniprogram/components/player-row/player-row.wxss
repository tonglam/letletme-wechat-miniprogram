.player-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 0;
  border-bottom: 1rpx solid var(--line, #ddd4de);
}

.player-row.live-playing {
  background: linear-gradient(90deg, rgba(0, 209, 109, 0.12), rgba(255, 255, 255, 0));
}

.player-row.live-partial {
  background: linear-gradient(90deg, rgba(146, 74, 7, 0.1), rgba(255, 255, 255, 0));
}

.player-row.live-finished {
  color: var(--muted-ink, #6e5a72);
}

.player-row.live-blank {
  opacity: 0.58;
}

.player-main {
  min-width: 0;
  padding-right: 20rpx;
}

.player-title-line {
  display: flex;
  align-items: center;
  min-width: 0;
}

.player-name {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: var(--ink, #301333);
  font-size: 28rpx;
  font-weight: 600;
}

.role-badge {
  flex-shrink: 0;
  margin-left: 10rpx;
  padding: 2rpx 8rpx;
  border-radius: 6rpx;
  font-size: 18rpx;
  font-weight: 800;
  line-height: 28rpx;
}

/* Captain / vice-captain marker — plum board, electric letter */
.role-badge {
  background: var(--plum, #38003c);
  color: var(--electric, #00ff85);
}

.player-meta {
  display: flex;
  align-items: center;
  margin-top: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: var(--muted-ink, #6e5a72);
  font-size: 22rpx;
}

.player-pos {
  margin-left: 10rpx;
}

.player-side {
  flex-shrink: 0;
  min-width: 104rpx;
  color: var(--green-ink, #008545);
  font-size: 24rpx;
  font-weight: 700;
  text-align: right;
}

.status-text {
  display: block;
  margin-top: 6rpx;
  color: var(--muted-ink, #6e5a72);
  font-size: 20rpx;
  font-weight: 500;
}
