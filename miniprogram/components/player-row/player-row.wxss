.player-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #eef2f7;
}

.player-row.live-playing {
  background: linear-gradient(90deg, rgba(22, 163, 74, 0.08), rgba(255, 255, 255, 0));
}

.player-row.live-partial {
  background: linear-gradient(90deg, rgba(245, 158, 11, 0.08), rgba(255, 255, 255, 0));
}

.player-row.live-finished {
  color: #475467;
}

.player-row.live-blank {
  opacity: 0.58;
}

.player-main {
  min-width: 0;
  padding-right: 20rpx;
}

.player-title-line {
  display: flex;
  align-items: center;
  min-width: 0;
}

.player-name {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: #111827;
  font-size: 28rpx;
  font-weight: 600;
}

.role-badge {
  flex-shrink: 0;
  margin-left: 10rpx;
  padding: 2rpx 8rpx;
  border-radius: 6rpx;
  font-size: 18rpx;
  font-weight: 800;
  line-height: 28rpx;
}

.role-badge {
  background: #111827;
  color: #ffffff;
}

.player-meta {
  margin-top: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: #667085;
  font-size: 22rpx;
}

.player-side {
  flex-shrink: 0;
  min-width: 104rpx;
  color: #2563eb;
  font-size: 24rpx;
  font-weight: 600;
  text-align: right;
}

.status-text {
  display: block;
  margin-top: 6rpx;
  color: #667085;
  font-size: 20rpx;
  font-weight: 500;
}
