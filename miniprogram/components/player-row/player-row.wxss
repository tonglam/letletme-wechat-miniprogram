.player-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.player-row.live-playing {
  background: linear-gradient(90deg, var(--cta-a12), rgba(255, 255, 255, 0));
}

.player-row.live-partial {
  background: linear-gradient(90deg, var(--warning-a10), rgba(255, 255, 255, 0));
}

.player-row.live-finished {
  color: var(--muted-ink);
}

.player-row.live-blank {
  opacity: 0.58;
}

.player-main {
  min-width: 0;
  padding-right: 16rpx;
}

.player-title-line {
  display: flex;
  align-items: center;
  min-width: 0;
}

.player-name {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: var(--ink);
  font-size: 24rpx;
  font-weight: 700;
}

/* Captain / vice-captain marker — plum board, electric letter */
.role-badge {
  flex-shrink: 0;
  margin-left: 8rpx;
  padding: 0 8rpx;
  border-radius: 6rpx;
  background: var(--plum);
  color: var(--electric);
  font-size: 18rpx;
  font-weight: 800;
  line-height: 24rpx;
}

.player-meta {
  display: flex;
  align-items: center;
  margin-top: 4rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: var(--muted-ink);
  font-size: 20rpx;
}

.player-pos {
  margin-left: 8rpx;
}

.player-side {
  flex-shrink: 0;
  min-width: 80rpx;
  color: var(--green-ink);
  font-size: 24rpx;
  font-weight: 800;
  text-align: right;
}

.player-points {
  font-variant-numeric: tabular-nums;
}

/* Secondary line under the points value — directory price (web player-stats row). */
.player-price-sub {
  display: block;
  margin-top: 4rpx;
  color: var(--muted-ink);
  font-size: 18rpx;
  font-weight: 700;
}

.stat-text {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.status-text {
  display: block;
  margin-top: 4rpx;
  color: var(--muted-ink);
  font-size: 18rpx;
  font-weight: 500;
}
