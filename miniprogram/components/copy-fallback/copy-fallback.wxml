<view wx:if="{{show}}" class="cf-root">
  <view class="cf-mask" bindtap="onClose" catchtouchmove="onNoop"></view>
  <view class="cf-sheet" catchtap="onNoop">
    <view class="cf-head">
      <view class="cf-title">长按复制下面的文本</view>
      <text class="action" bindtap="onClose" hover-class="hover-dim">关闭</text>
    </view>
    <scroll-view scroll-y class="cf-body" enhanced="{{true}}" show-scrollbar="{{true}}">
      <text user-select="{{true}}" class="cf-text">{{text}}</text>
    </scroll-view>
  </view>
</view>
