.cf-root {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 240;
}

.cf-mask {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: var(--black-a25);
}

.cf-sheet {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  max-height: 78vh;
  padding: 24rpx 28rpx calc(24rpx + env(safe-area-inset-bottom));
  border-radius: 28rpx 28rpx 0 0;
  background: var(--card);
}

.cf-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.cf-title {
  color: var(--ink);
  font-size: 28rpx;
  font-weight: 800;
}

.cf-body {
  max-height: 58vh;
}

.cf-text {
  display: block;
  color: var(--ink);
  font-size: 24rpx;
  line-height: 1.55;
  white-space: pre-wrap;
  word-break: break-all;
}
