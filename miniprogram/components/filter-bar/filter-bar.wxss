/* Unified search capsule — input + actions live in one track pill */
.filter-bar {
  display: flex;
  align-items: center;
  gap: 4rpx;
  padding: 0 10rpx 0 20rpx;
  border-radius: 16rpx;
  background: var(--track);
}

.filter-input {
  flex: 1;
  min-width: 0;
  height: 80rpx;
  min-height: 80rpx;
  padding: 0;
  border: 0;
  border-radius: 0;
  background: transparent;
  font-size: 28rpx;
  line-height: 80rpx;
}

.filter-placeholder {
  color: var(--muted-ink);
  font-size: 28rpx;
  line-height: 80rpx;
}

.filter-submit,
.filter-reset {
  flex-shrink: 0;
  padding: 12rpx 10rpx;
  font-size: 26rpx;
}
