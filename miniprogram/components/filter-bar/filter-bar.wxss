.filter-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.filter-input {
  flex: 1;
  height: 80rpx;
  padding: 0 24rpx;
  background: var(--card);
  border: 1rpx solid var(--line);
  border-radius: 12rpx;
  color: var(--ink);
  box-sizing: border-box;
}

.filter-button {
  flex-shrink: 0;
  height: 80rpx;
  margin: 0;
  padding: 0 22rpx;
  border-radius: 12rpx;
  background: var(--card);
  color: var(--ink);
  border: 1rpx solid var(--line);
  font-size: 24rpx;
  font-weight: 600;
  line-height: 78rpx;
  box-sizing: border-box;
}

.filter-button::after {
  border: 0;
}

.filter-button.primary {
  background: var(--cta);
  color: var(--cta-ink);
  border-color: transparent;
  font-weight: 700;
}
