<view class="filter-bar">
  <input class="input filter-input" placeholder="{{placeholder}}" value="{{keyword}}" confirm-type="search" bindinput="onInput" bindconfirm="onConfirm" />
  <button class="filter-button primary" size="mini" hover-class="hover-dim" bindtap="onSubmit">{{actionText}}</button>
  <button class="filter-button" size="mini" hover-class="hover-dim" bindtap="onReset">重置</button>
</view>
