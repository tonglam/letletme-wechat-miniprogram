.status-bar {
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 88rpx;
  padding: 12rpx 20rpx;
  background: var(--card);
  border: 1rpx solid var(--line);
  border-radius: 12rpx;
}

.status-main {
  display: flex;
  align-items: center;
  min-width: 0;
  flex: 1;
}

.status-dot {
  width: 12rpx;
  height: 12rpx;
  flex-shrink: 0;
  border-radius: 50%;
  margin-right: 12rpx;
  background: var(--muted-ink);
}

.tone-good .status-dot {
  background: var(--green-ink);
}

.tone-busy .status-dot {
  background: var(--green-ink);
  animation: status-pulse 1.2s ease-in-out infinite;
}

.tone-warn .status-dot {
  background: var(--warning);
}

.tone-bad .status-dot {
  background: var(--danger);
}

@keyframes status-pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.35; }
}

.status-label {
  flex-shrink: 0;
  color: var(--ink);
  font-size: 24rpx;
  font-weight: 700;
}

.tone-warn .status-label {
  color: var(--warning);
}

.tone-bad .status-label {
  color: var(--danger);
}

.status-meta {
  margin-left: 14rpx;
  overflow: hidden;
  color: var(--muted-ink);
  font-size: 22rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.status-refresh {
  flex-shrink: 0;
  min-width: 88rpx;
  height: 56rpx;
  line-height: 56rpx;
  margin-left: 16rpx;
  padding: 0 20rpx;
  box-sizing: border-box;
  border-radius: 999rpx;
  background: var(--track);
  color: var(--green-ink);
  font-size: 24rpx;
  font-weight: 700;
  text-align: center;
}

.status-refresh-hover {
  background: var(--accent-tint);
}

.status-bar-compact {
  min-height: 72rpx;
  padding: 8rpx 16rpx;
}
