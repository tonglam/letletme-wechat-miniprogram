/* FDR 1-5 palette mirrors the web FDR_CELL scale
   (success / success-soft / muted / warning / destructive) on mini tokens. */

.fixture-chip {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  width: 100%;
  min-width: 0;
  padding: 10rpx 6rpx;
  border: 1rpx solid var(--line);
  border-radius: 8rpx;
  background: var(--track);
  color: var(--ink);
  font-size: 20rpx;
  font-weight: 600;
  box-sizing: border-box;
}

.fixture-chip.fdr-1 {
  border-color: var(--green-ink-a40);
  background: var(--accent-tint);
  color: var(--ink);
}

.fixture-chip.fdr-2 {
  border-color: var(--green-ink-a30);
  background: var(--cta-a12);
  color: var(--ink);
}

.fixture-chip.fdr-3 {
  border-color: var(--line);
  background: var(--track);
  color: var(--ink);
}

.fixture-chip.fdr-4 {
  border-color: var(--warning-a45);
  background: var(--warning-tint);
  color: var(--ink);
}

.fixture-chip.fdr-5 {
  border-color: var(--danger-a40);
  background: var(--danger-tint);
  color: var(--ink);
}

.home-away {
  opacity: 0.8;
}
