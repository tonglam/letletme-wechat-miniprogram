/* Layout modifiers on the global .fdr primitive
   (background levels come from .fdr-1..5 via apply-shared) */
.fixture-chip {
  gap: 8rpx;
  min-width: 96rpx;
  padding: 8rpx 12rpx;
  font-size: 22rpx;
  font-weight: 600;
  box-sizing: border-box;
}

/* Unknown/unrated — muted chip instead of a difficulty colour */
.fdr-unknown {
  background: var(--track);
  color: var(--muted-ink);
}

.home-away {
  opacity: 0.8;
}
