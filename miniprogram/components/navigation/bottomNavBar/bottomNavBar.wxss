/* bottomNavBar — dark fascia tab bar (mirrors web footer: fascia + electric top edge)
 *
 * The icon+label cluster is centered in the FULL visual bar, including the
 * min floor / home-indicator inset. Vant's tabbar cannot do this: its items
 * are height:100% of a 50px content box, so labels sit in the upper strip.
 *
 *   [electric edge]
 *   [ equal space ]
 *   [ icon + label ]
 *   [ equal space ]
 */
.ll-tabbar {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 100;
  display: flex;
  align-items: stretch;
  box-sizing: border-box;
  height: calc(var(--tabbar-height) + var(--tabbar-floor));
  height: calc(var(--tabbar-height) + max(var(--tabbar-floor), constant(safe-area-inset-bottom)));
  height: calc(var(--tabbar-height) + max(var(--tabbar-floor), env(safe-area-inset-bottom)));
  background: var(--tabbar-background-color);
}

.ll-tabbar-item {
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-width: 0;
  height: 100%;
  color: var(--tabbar-item-text-color);
}

.ll-tabbar-item.is-active {
  color: var(--tabbar-item-active-color);
}

.ll-tabbar-icon {
  position: relative;
  flex: none;
  width: 22px;
  height: 22px;
}

.ll-tabbar-icon-core,
.ll-tabbar-icon::before,
.ll-tabbar-icon::after {
  position: absolute;
  box-sizing: border-box;
  content: "";
}

/* Live signal: a solid source with two restrained broadcast rings. */
.ll-tabbar-icon--live .ll-tabbar-icon-core {
  top: 8px;
  left: 8px;
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: currentColor;
}

.ll-tabbar-icon--live::before,
.ll-tabbar-icon--live::after {
  border: 1px solid currentColor;
  border-radius: 50%;
}

.ll-tabbar-icon--live::before {
  top: 4px;
  left: 4px;
  width: 14px;
  height: 14px;
}

.ll-tabbar-icon--live::after {
  top: 1px;
  left: 1px;
  width: 20px;
  height: 20px;
  opacity: 0.55;
}

/* My FPL: a compact pitch, centre line and centre circle. */
.ll-tabbar-icon--myFpl .ll-tabbar-icon-core {
  top: 4px;
  left: 3px;
  width: 16px;
  height: 14px;
  border: 1px solid currentColor;
  border-radius: 2px;
}

.ll-tabbar-icon--myFpl::before {
  top: 5px;
  left: 10px;
  height: 12px;
  border-left: 1px solid currentColor;
}

.ll-tabbar-icon--myFpl::after {
  top: 9px;
  left: 8px;
  width: 5px;
  height: 5px;
  border: 1px solid currentColor;
  border-radius: 50%;
}

/* Explore: conventional compass ring and needle. */
.ll-tabbar-icon--explore::before {
  top: 2px;
  left: 2px;
  width: 18px;
  height: 18px;
  border: 1px solid currentColor;
  border-radius: 50%;
}

.ll-tabbar-icon--explore .ll-tabbar-icon-core {
  top: 6px;
  left: 8px;
  width: 0;
  height: 0;
  border-right: 3px solid transparent;
  border-bottom: 10px solid currentColor;
  border-left: 3px solid transparent;
  transform: rotate(38deg);
}

/* Me: head and shoulder outline. */
.ll-tabbar-icon--me .ll-tabbar-icon-core {
  top: 2px;
  left: 7px;
  width: 8px;
  height: 8px;
  border: 1px solid currentColor;
  border-radius: 50%;
}

.ll-tabbar-icon--me::after {
  bottom: 2px;
  left: 4px;
  width: 14px;
  height: 8px;
  border: 1px solid currentColor;
  border-bottom: 0;
  border-radius: 12px 12px 0 0;
}

/* Performance: three ascending bars. */
.ll-tabbar-icon--perf .ll-tabbar-icon-core {
  bottom: 3px;
  left: 4px;
  width: 3px;
  height: 7px;
  border-radius: 1px 1px 0 0;
  background: currentColor;
  box-shadow: 6px -4px 0 currentColor, 12px -9px 0 currentColor;
}

.ll-tabbar-label {
  margin-top: 2px;
  font-size: 20rpx;
  line-height: 1;
}

.ll-tabbar-placeholder {
  height: calc(var(--tabbar-height) + var(--tabbar-floor));
  height: calc(var(--tabbar-height) + max(var(--tabbar-floor), constant(safe-area-inset-bottom)));
  height: calc(var(--tabbar-height) + max(var(--tabbar-floor), env(safe-area-inset-bottom)));
}

.tabbar-edge {
  position: fixed;
  right: 0;
  bottom: calc(var(--tabbar-height) + var(--tabbar-floor));
  bottom: calc(var(--tabbar-height) + max(var(--tabbar-floor), constant(safe-area-inset-bottom)));
  bottom: calc(var(--tabbar-height) + max(var(--tabbar-floor), env(safe-area-inset-bottom)));
  left: 0;
  z-index: 101;
  height: 4rpx;
  background: var(--electric);
  pointer-events: none;
}
