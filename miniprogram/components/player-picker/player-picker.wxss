.input {
  height: 80rpx;
  padding: 0 24rpx;
  background: var(--card, #ffffff);
  border: 1rpx solid var(--line, #ddd4de);
  border-radius: 12rpx;
  color: var(--ink, #301333);
  box-sizing: border-box;
}

.option {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--line, #ddd4de);
  font-size: 26rpx;
}

.muted {
  color: var(--muted-ink, #6e5a72);
  font-size: 22rpx;
}
