.input {
  height: 80rpx;
  padding: 0 24rpx;
  background: var(--card);
  border: 1rpx solid var(--line);
  border-radius: 12rpx;
  color: var(--ink);
  box-sizing: border-box;
}

.option {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--line);
  font-size: 26rpx;
}

.muted {
  color: var(--muted-ink);
  font-size: 22rpx;
}
