.gw-picker {
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  min-height: 64rpx;
  padding: 0 18rpx;
  border: 1rpx solid var(--line);
  border-radius: 10rpx;
  background: var(--card);
  color: var(--ink);
  font-size: 24rpx;
  font-weight: 800;
}

.gw-picker-action {
  color: var(--green-ink);
  font-size: 22rpx;
  font-weight: 700;
}
