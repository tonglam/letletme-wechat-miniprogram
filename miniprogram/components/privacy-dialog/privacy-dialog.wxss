.pd-root {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 400;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  box-sizing: border-box;
}

.pd-mask {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: var(--black-a25);
}

.pd-card {
  position: relative;
  width: 100%;
  max-width: 620rpx;
  padding: 36rpx 28rpx 28rpx;
  border-radius: 24rpx;
  background: var(--card);
  box-shadow: 0 12rpx 48rpx var(--plum-a8);
  box-sizing: border-box;
}

.pd-title {
  color: var(--ink);
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1.3;
}

.pd-body {
  margin-top: 16rpx;
  color: var(--muted-ink);
  font-size: 24rpx;
  line-height: 1.55;
}

.pd-link {
  color: var(--green-ink);
  font-weight: 700;
}

.pd-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 28rpx;
}

.pd-btn {
  flex: 1;
  min-width: 0;
}
