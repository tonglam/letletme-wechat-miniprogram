.pls-root {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 200;
}

.pls-mask {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: var(--black-a25);
}

.pls-sheet {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  max-height: 82vh;
  padding: 0 28rpx calc(24rpx + env(safe-area-inset-bottom));
  overflow-y: auto;
  border-radius: 28rpx 28rpx 0 0;
  background: var(--card);
  box-shadow: 0 -8rpx 32rpx var(--plum-a8);
}

/* Hero — dark fascia band, same recipe as the page scoreboard */
.pls-hero {
  position: relative;
  margin: 0 -28rpx;
  padding: 12rpx 28rpx 24rpx;
  border: 0;
  border-bottom: 1rpx solid var(--electric-a28);
  border-radius: 28rpx 28rpx 0 0;
  background:
    radial-gradient(ellipse 120% 90% at 50% -30%, var(--plum-a70), rgba(56, 0, 60, 0) 60%),
    linear-gradient(180deg, var(--fascia-hi), var(--fascia));
  box-shadow: inset 0 1rpx 0 rgba(0, 255, 133, 0.2);
}

.pls-handle {
  width: 64rpx;
  height: 8rpx;
  margin: 8rpx auto 20rpx;
  border-radius: 8rpx;
  background: var(--chalk-a30);
}

.pls-close {
  position: absolute;
  top: 24rpx;
  right: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 48rpx;
  height: 48rpx;
  border-radius: 999rpx;
  background: var(--white-a10);
}

.pls-close-icon {
  width: 22rpx;
  height: 22rpx;
  opacity: 0.7;
}

/* Sheet share action — sits left of the close button on the dark hero */
.pls-share {
  position: absolute;
  top: 24rpx;
  right: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 48rpx;
  height: 48rpx;
  padding: 0;
  border: 1rpx solid var(--electric-a28, rgba(0, 255, 133, 0.28));
  border-radius: 999rpx;
  background: var(--black-a25, rgba(0, 0, 0, 0.25));
  box-sizing: border-box;
}

.pls-share-icon {
  width: 22rpx;
  height: 22rpx;
}

.pls-share.done {
  opacity: 0.65;
}

/* Position badge on the dark hero — solid pills, web market-position-badge palette */
.pls-hero .pos-badge {
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  font-size: 18rpx;
  line-height: 1.6;
}

.pls-hero .pos-badge.pos-gkp {
  background: var(--pos-gkp);
  color: var(--pos-gkp-ink);
}

.pls-hero .pos-badge.pos-def {
  background: var(--electric);
  color: var(--plum);
}

.pls-hero .pos-badge.pos-mid {
  background: var(--pink);
  color: var(--plum);
}

.pls-hero .pos-badge.pos-fwd {
  background: var(--plum);
  color: var(--electric);
}

.pls-hero-row {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 20rpx;
}

.pls-identity {
  min-width: 0;
  flex: 1;
}

.pls-name {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: var(--chalk);
  font-size: 38rpx;
  font-weight: 800;
  line-height: 1.2;
}

.pls-meta {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  margin-top: 8rpx;
  color: var(--chalk-a60);
  font-size: 22rpx;
}

/* Points pill — same pill shape as bonus/BPS, value keeps the hero green */
.pls-pts-value {
  color: var(--electric);
}

/* BPS / bonus pills on the dark band */
.pls-hero-foot {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 20rpx;
}

.pls-pill {
  display: inline-flex;
  align-items: baseline;
  gap: 8rpx;
  padding: 8rpx 16rpx;
  border: 1rpx solid var(--chalk-a30);
  border-radius: 999rpx;
  background: var(--white-a10);
}

.pls-pill-label {
  color: var(--chalk-a60);
  font-size: 18rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.pls-pill-value {
  color: var(--chalk);
  font-size: 24rpx;
  font-weight: 800;
  font-variant-numeric: tabular-nums;
}

.pls-bps-high {
  color: var(--electric);
}

.pls-bps-mid,
.pls-bps-ok {
  color: var(--chalk);
}

.pls-bps-low {
  color: var(--danger-bright);
}

.pls-pill-bonus {
  color: var(--warning-bright);
}

/* Captain / vice-captain role pill — plum board, electric text (GW pill language) */
.pls-pill-role {
  border-color: var(--electric-a35);
  background: var(--plum);
}

.pls-pill-role-value {
  color: var(--electric);
  letter-spacing: 1rpx;
}

/* Live opportunity rows — icon tile + label + progress bar */
.pls-opps {
  overflow: hidden;
  border: 1rpx solid var(--line);
  border-radius: 12rpx;
  background: var(--card);
}

.pls-opp {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 16rpx 20rpx;
  border-bottom: 1rpx solid var(--line);
}

.pls-opp:last-child {
  border-bottom: 0;
}

.pls-opp-main {
  min-width: 0;
  flex: 1;
}

.pls-opp-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
}

.pls-opp-label {
  color: var(--ink);
  font-size: 26rpx;
  font-weight: 600;
}

.pls-opp-text {
  flex-shrink: 0;
  color: var(--muted-ink);
  font-size: 20rpx;
  font-variant-numeric: tabular-nums;
}

.pls-opp-track {
  height: 8rpx;
  margin-top: 10rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: var(--track);
}

.pls-opp-fill {
  height: 100%;
  border-radius: 999rpx;
  background: var(--green-ink);
}

.pls-opp-fill-defensive {
  background: var(--info);
}

/* Section head row — title left, multiplier note right */
.pls-section-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 14rpx;
}

.pls-section-head .pls-section-title {
  margin-bottom: 0;
}

.pls-mult {
  flex-shrink: 0;
  color: var(--warning);
  font-size: 20rpx;
  font-weight: 800;
}

/* Body sections on the white card */
.pls-section {
  margin-top: 28rpx;
}

.pls-section-title {
  margin-bottom: 14rpx;
  color: var(--muted-ink);
  font-size: 20rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
}

.pls-stats {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 10rpx;
}

.pls-stat {
  padding: 14rpx 10rpx;
  border: 1rpx solid var(--line);
  border-radius: 12rpx;
  background: var(--card);
}

.pls-stat-label {
  color: var(--muted-ink);
  font-size: 18rpx;
  font-weight: 700;
}

.pls-stat-value {
  margin-top: 4rpx;
  color: var(--ink);
  font-size: 30rpx;
  font-weight: 800;
  font-variant-numeric: tabular-nums;
}

.pls-stat.muted {
  background: transparent;
}

.pls-stat.muted .pls-stat-value {
  color: var(--muted-ink);
}

.pls-empty,
.pls-hint {
  color: var(--muted-ink);
  font-size: 22rpx;
  line-height: 1.5;
}

.pls-hint {
  margin-bottom: 12rpx;
}

.pls-break {
  overflow: hidden;
  border: 1rpx solid var(--line);
  border-radius: 12rpx;
  background: var(--card);
}

.pls-break-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 14rpx 20rpx;
  border-bottom: 1rpx solid var(--line);
}

.pls-break-row:last-child {
  border-bottom: 0;
}

/* Kind icon tiles — same vocabulary as the match event rows */
.pls-break-badge {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  width: 40rpx;
  height: 40rpx;
  border-radius: 10rpx;
}

.pls-break-icon {
  width: 28rpx;
  height: 28rpx;
}

.pls-break-badge-bonus {
  background: var(--warning-tint);
}

.pls-break-badge-goals,
.pls-break-badge-cleansheet,
.pls-break-badge-pensaved {
  background: var(--accent-tint);
}

.pls-break-badge-assists,
.pls-break-badge-defensive,
.pls-break-badge-saves {
  background: var(--info-tint);
}

.pls-break-badge-minutes {
  background: var(--track);
}

.pls-break-badge-yellow {
  background: var(--warning-a25);
}

.pls-break-badge-red,
.pls-break-badge-penmissed,
.pls-break-badge-owngoal {
  background: var(--danger-tint);
}

/* Literal yellow / red card glyph (same as match page CardGlyph) */
.pls-card {
  width: 16rpx;
  height: 24rpx;
  border-radius: 3rpx;
  box-shadow: inset 0 0 0 1rpx var(--plum-a8);
}

.pls-card-yellow {
  background: var(--warning-bright);
}

.pls-card-red {
  background: var(--danger);
}

.pls-break-label {
  min-width: 0;
  flex: 1;
  color: var(--ink);
  font-size: 26rpx;
  font-weight: 600;
}

.pls-break-count {
  margin-left: 10rpx;
  color: var(--muted-ink);
  font-size: 22rpx;
  font-weight: 500;
}

.pls-break-pts {
  flex-shrink: 0;
  font-size: 26rpx;
  font-weight: 800;
  font-variant-numeric: tabular-nums;
}

.pls-break-pts.pos {
  color: var(--green-ink);
}

.pls-break-pts.neg {
  color: var(--danger);
}

.pls-break-sum {
  border-bottom: 0;
  background: var(--plum-a4);
  color: var(--ink);
  font-size: 26rpx;
  font-weight: 800;
}
