page {
  min-height: 100%;
  background: #f5f6f8;
  color: #111827;
  font-size: 28rpx;
}

.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 24rpx;
}

.section {
  margin-bottom: 24rpx;
}

.card {
  background: #ffffff;
  border-radius: 8rpx;
  padding: 24rpx;
  box-sizing: border-box;
}

.title {
  font-size: 36rpx;
  font-weight: 700;
  color: #111827;
}

.subtitle {
  margin-top: 8rpx;
  color: #667085;
  font-size: 24rpx;
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.muted {
  color: #667085;
}

.action {
  color: #2563eb;
}
