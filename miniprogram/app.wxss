/* ============================================================
   LetLetMe Matchday Design Tokens — mirrors letletme-web
   (plum / electric / pink FPL broadcast kit, light chalk theme)

   Rules of the system:
   - Colors MUST come from var(--token). Raw hex is allowed only
     inside this file's token definitions (guarded by
     scripts/check-style-drift.mjs).
   - WXSS cannot derive alpha from a var, so alpha variants are
     precomputed tokens (--<base>-a<N>) and must stay in sync
     with their base color.
   ============================================================ */
page {
  min-height: 100%;

  /* Brand */
  --plum: #38003c;
  --fascia: #1d0520;
  --fascia-hi: #2b0a33;
  --electric: #00ff85;
  --pink: #ff2882;
  --chalk: #f9f7f2;

  /* Semantic (web light-theme values) */
  --green-ink: #008545;   /* primary-ink / success on light surfaces */
  --cta: #00d16d;         /* primary button green */
  --cta-ink: #1a001e;     /* text on CTA green */
  --danger: #c9183f;
  --warning: #924a07;
  --info: #82208a;

  /* Surfaces & text */
  --bg: #f9f8f4;
  --ink: #301333;
  --muted-ink: #6e5a72;
  --card: #ffffff;
  --line: #ddd4de;
  --track: #f1efe9;
  --accent-tint: #dcf6ea; /* soft green highlight */
  --danger-tint: #fbe3e9;
  --warning-tint: #f6ead9;
  --info-tint: #f0e3f2;

  /* Bright semantic variants — for text/bars on dark fascia surfaces
     (base --warning/--danger are too dark to read on --fascia) */
  --warning-bright: #fbbf24;
  --danger-bright: #f87171;

  /* Position-badge palette (official FPL position colours) */
  --pos-gkp: #fcd34d;
  --pos-gkp-ink: #451a03;
  --pos-mid-ink: #500724;

  /* Alpha variants — keep in sync with the base tokens above */
  --plum-a4: rgba(56, 0, 60, 0.04);
  --plum-a8: rgba(56, 0, 60, 0.08);
  --plum-a70: rgba(56, 0, 60, 0.7);
  --chalk-a12: rgba(249, 247, 242, 0.12);
  --chalk-a30: rgba(249, 247, 242, 0.3);
  --chalk-a45: rgba(249, 247, 242, 0.45);
  --chalk-a60: rgba(249, 247, 242, 0.6);
  --electric-a28: rgba(0, 255, 133, 0.28);
  --electric-a35: rgba(0, 255, 133, 0.35);
  --electric-a45: rgba(0, 255, 133, 0.45);
  --green-ink-a25: rgba(0, 133, 69, 0.25);
  --green-ink-a30: rgba(0, 133, 69, 0.3);
  --green-ink-a70: rgba(0, 133, 69, 0.7);
  --cta-a12: rgba(0, 209, 109, 0.12);
  --cta-a45: rgba(0, 209, 109, 0.45);
  --danger-a20: rgba(201, 24, 63, 0.2);
  --danger-a30: rgba(201, 24, 63, 0.3);
  --danger-a35: rgba(201, 24, 63, 0.35);
  --warning-a10: rgba(146, 74, 7, 0.1);
  --warning-a25: rgba(146, 74, 7, 0.25);
  --warning-a80: rgba(146, 74, 7, 0.8);
  --ink-a12: rgba(48, 19, 51, 0.12);
  --white-a10: rgba(255, 255, 255, 0.1);
  --white-a15: rgba(255, 255, 255, 0.15);
  --black-a25: rgba(0, 0, 0, 0.25);

  /* Vant theming (custom properties cascade into components) */
  --tabbar-background-color: #1d0520;
  --tabbar-item-text-color: rgba(249, 247, 242, 0.55);
  --tabbar-item-active-color: #00ff85;

  background: var(--bg);
  color: var(--ink);
  font-size: 28rpx;
}

/* ---------- Layout primitives ---------- */

.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 24rpx;
}

/* Pages rendering <bottomNavBar />: clear the fixed bar + home indicator */
.page-tabbar {
  padding-bottom: calc(140rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
}

.section {
  margin-bottom: 24rpx;
}

.card {
  background: var(--card);
  border: 1rpx solid var(--line);
  border-radius: 16rpx;
  padding: 24rpx;
  box-sizing: border-box;
  box-shadow: 0 2rpx 8rpx var(--plum-a4);
}

.title {
  font-size: 38rpx;
  font-weight: 800;
  color: var(--ink);
  letter-spacing: 0.5rpx;
}

/* Section heading under a page title (was per-page .title overrides) */
.section-title {
  margin-bottom: 14rpx;
  color: var(--ink);
  font-size: 34rpx;
  font-weight: 800;
}

.subtitle {
  margin-top: 8rpx;
  color: var(--muted-ink);
  font-size: 24rpx;
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.muted {
  color: var(--muted-ink);
}

.action {
  color: var(--green-ink);
  font-weight: 600;
}

/* Universal press feedback: hover-class="hover-dim" */
.hover-dim {
  opacity: 0.82;
}

/* ---------- Controls ---------- */

.btn-primary {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 220rpx;
  min-height: 76rpx;
  padding: 0 32rpx;
  border-radius: 12rpx;
  background: var(--cta);
  color: var(--cta-ink);
  font-size: 24rpx;
  font-weight: 800;
  box-sizing: border-box;
}

.btn-primary::after {
  border: 0;
}

.btn-secondary {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 76rpx;
  padding: 0 32rpx;
  border: 1rpx solid var(--line);
  border-radius: 12rpx;
  background: var(--card);
  color: var(--ink);
  font-size: 24rpx;
  font-weight: 700;
  box-sizing: border-box;
}

.btn-secondary::after {
  border: 0;
}

.input {
  padding: 18rpx 20rpx;
  background: var(--card);
  border: 1rpx solid var(--line);
  border-radius: 12rpx;
  box-sizing: border-box;
  color: var(--ink);
  font-size: 24rpx;
}

.picker {
  min-height: 72rpx;
  padding: 18rpx 20rpx;
  background: var(--card);
  border: 1rpx solid var(--line);
  border-radius: 12rpx;
  box-sizing: border-box;
  color: var(--ink);
}

/* ---------- Inline error banner (soft, retryable) ---------- */

.inline-error {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 24rpx;
  background: var(--card);
  border: 1rpx solid var(--line);
  border-radius: 12rpx;
  color: var(--warning);
  font-size: 24rpx;
}

.inline-error-retry {
  flex-shrink: 0;
  min-height: 64rpx;
  padding: 0 24rpx;
  border: 1rpx solid var(--line);
  border-radius: 10rpx;
  background: var(--track);
  color: var(--ink);
  font-size: 22rpx;
  font-weight: 700;
  line-height: 64rpx;
}

/* Danger variant — live data refresh failures */
.live-refresh-error {
  padding: 18rpx 22rpx;
  border: 1rpx solid var(--danger-a30);
  border-radius: 12rpx;
  background: var(--danger-tint);
  color: var(--danger);
  font-size: 24rpx;
  line-height: 1.45;
}

/* ---------- Tab strip (segmented control) ---------- */

.tab-strip {
  display: grid;
  grid-auto-flow: column;
  grid-auto-columns: 1fr;
  gap: 8rpx;
  padding: 8rpx;
  border-radius: 12rpx;
  background: var(--track);
}

.tab-item {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 64rpx;
  border-radius: 8rpx;
  color: var(--muted-ink);
  font-size: 24rpx;
  font-weight: 700;
}

.tab-active {
  background: var(--card);
  color: var(--ink);
  box-shadow: 0 2rpx 6rpx var(--plum-a8);
}

/* ---------- Metric tiles ---------- */

.metric-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
}

.metric-grid-three {
  grid-template-columns: repeat(3, minmax(0, 1fr));
}

.metric-card {
  min-width: 0;
  padding: 18rpx;
  border-radius: 12rpx;
  background: var(--track);
}

.metric-label {
  color: var(--muted-ink);
  font-size: 22rpx;
}

.metric-value {
  display: block;
  margin-top: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: var(--ink);
  font-size: 30rpx;
  font-weight: 800;
}

.metric-value-bad {
  color: var(--danger);
}

/* ---------- Matchday utilities ---------- */

/* Broadcast chyron label — green tick + tracked caps */
.chyron {
  display: inline-flex;
  align-items: center;
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
  text-transform: uppercase;
  color: var(--muted-ink);
}

.chyron::before {
  content: '';
  width: 8rpx;
  height: 26rpx;
  margin-right: 14rpx;
  background: var(--cta);
  box-shadow: 0 0 10rpx var(--electric-a45);
}

/* Scoreboard — dark fascia panel with an electric edge */
.scoreboard {
  position: relative;
  overflow: hidden;
  border: 1rpx solid var(--electric-a28);
  border-radius: 20rpx;
  background:
    radial-gradient(ellipse 120% 90% at 50% -30%, var(--plum-a70), rgba(56, 0, 60, 0) 60%),
    linear-gradient(180deg, var(--fascia-hi), var(--fascia));
  color: var(--chalk);
  box-shadow: inset 0 1rpx 0 rgba(0, 255, 133, 0.2);
}

.scoreboard .muted {
  color: var(--chalk-a60);
}

/* GW pill — plum board, electric text (web GW badge) */
.gw-pill-dark {
  display: inline-flex;
  align-items: center;
  padding: 8rpx 16rpx;
  border: 1rpx solid var(--electric-a35);
  border-radius: 8rpx;
  background: var(--plum);
  color: var(--electric);
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

/* Position badges — official FPL position colours */
.pos-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  background: var(--track);
  color: var(--muted-ink);
  font-size: 18rpx;
  font-weight: 800;
  line-height: 1.5;
}

.pos-gkp { background: var(--pos-gkp); color: var(--pos-gkp-ink); }
.pos-def { background: var(--electric); color: var(--plum); }
.pos-mid { background: var(--pink); color: var(--pos-mid-ink); }
.pos-fwd { background: var(--plum); color: var(--electric); }

/* Fixture difficulty rating — web DIFFICULTY_COLORS scale */
.fdr {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 76rpx;
  padding: 4rpx 8rpx;
  border-radius: 6rpx;
  color: var(--card);
  font-size: 18rpx;
  font-weight: 700;
  line-height: 1.2;
}

.fdr-1 { background: var(--green-ink); }
.fdr-2 { background: var(--green-ink-a70); }
.fdr-3 { background: var(--warning); }
.fdr-4 { background: var(--warning-a80); }
.fdr-5 { background: var(--danger); }

/* ---------- Form fields ---------- */

.field-label {
  color: var(--ink);
  font-size: 26rpx;
  font-weight: 700;
}

.field-help {
  margin-top: 6rpx;
  color: var(--muted-ink);
  font-size: 22rpx;
}
