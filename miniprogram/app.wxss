/* ============================================================
   LetLetMe Matchday Design Tokens — mirrors letletme-web
   (plum / electric / pink FPL broadcast kit, light chalk theme)

   Rules of the system:
   - Colors MUST come from var(--token). Raw hex is allowed only
     inside this file's token definitions (guarded by
     scripts/check-style-drift.mjs).
   - WXSS cannot derive alpha from a var, so alpha variants are
     precomputed tokens (--<base>-a<N>) and must stay in sync
     with their base color.
   ============================================================ */
page {
  min-height: 100%;

  /* Brand */
  --plum: #38003c;
  --fascia: #1d0520;
  --fascia-hi: #2b0a33;
  --electric: #00ff85;
  --pink: #ff2882;
  --chalk: #f9f7f2;

  /* Semantic (web light-theme values) */
  --green-ink: #008545;   /* primary-ink / success on light surfaces */
  --cta: #00d16d;         /* primary button green */
  --cta-ink: #1a001e;     /* text on CTA green */
  --danger: #c9183f;
  --warning: #924a07;
  --info: #82208a;

  /* Surfaces & text */
  --bg: #f9f8f4;
  --ink: #301333;
  --muted-ink: #6e5a72;
  --card: #ffffff;
  --line: #ddd4de;
  --track: #f1efe9;
  --accent-tint: #dcf6ea; /* soft green highlight */
  --danger-tint: #fbe3e9;
  --warning-tint: #f6ead9;
  --info-tint: #f0e3f2;

  /* Bright semantic variants — for text/bars on dark fascia surfaces
     (base --warning/--danger are too dark to read on --fascia) */
  --warning-bright: #fbbf24;
  --danger-bright: #f87171;

  /* Position-badge palette (official FPL position colours) */
  --pos-gkp: #fcd34d;
  --pos-gkp-ink: #451a03;
  --pos-mid-ink: #500724;

  /* Alpha variants — keep in sync with the base tokens above */
  --plum-a4: rgba(56, 0, 60, 0.04);
  --plum-a8: rgba(56, 0, 60, 0.08);
  --plum-a55: rgba(56, 0, 60, 0.55);
  --plum-a70: rgba(56, 0, 60, 0.7);

  /* Squad pitch (web SquadPitch cream / fascia) */
  --pitch-green: #2d8a4e;
  --pitch-green-dark: #1e6b3a;
  --pitch-cream: #f8f6ef;
  --pitch-dark: #210025;
  --pitch-marker: #111315;
  --pitch-marker-ink: #f5f1e8;
  --pitch-bench: #b8d9b9;
  --pitch-cream-a30: rgba(248, 246, 239, 0.3);
  --pitch-cream-a45: rgba(248, 246, 239, 0.45);
  --pitch-cream-a55: rgba(248, 246, 239, 0.55);
  --pitch-cream-a70: rgba(248, 246, 239, 0.7);
  --pitch-cream-a95: rgba(248, 246, 239, 0.95);
  --pitch-dark-a55: rgba(33, 0, 37, 0.55);
  --pitch-bench-a90: rgba(184, 217, 185, 0.9);
  --chalk-a12: rgba(249, 247, 242, 0.12);
  --chalk-a30: rgba(249, 247, 242, 0.3);
  --chalk-a45: rgba(249, 247, 242, 0.45);
  --chalk-a60: rgba(249, 247, 242, 0.6);
  --electric-a28: rgba(0, 255, 133, 0.28);
  --electric-a35: rgba(0, 255, 133, 0.35);
  --electric-a45: rgba(0, 255, 133, 0.45);
  --green-ink-a25: rgba(0, 133, 69, 0.25);
  --green-ink-a30: rgba(0, 133, 69, 0.3);
  --green-ink-a40: rgba(0, 133, 69, 0.4);
  --green-ink-a70: rgba(0, 133, 69, 0.7);
  --cta-a12: rgba(0, 209, 109, 0.12);
  --cta-a45: rgba(0, 209, 109, 0.45);
  --danger-a20: rgba(201, 24, 63, 0.2);
  --danger-a30: rgba(201, 24, 63, 0.3);
  --danger-a35: rgba(201, 24, 63, 0.35);
  --danger-a40: rgba(201, 24, 63, 0.4);
  --warning-a10: rgba(146, 74, 7, 0.1);
  --warning-a25: rgba(146, 74, 7, 0.25);
  --warning-a45: rgba(146, 74, 7, 0.45);
  --warning-a80: rgba(146, 74, 7, 0.8);
  --muted-ink-a50: rgba(110, 90, 114, 0.5);
  --ink-a12: rgba(48, 19, 51, 0.12);
  --white-a10: rgba(255, 255, 255, 0.1);
  --white-a15: rgba(255, 255, 255, 0.15);
  --black-a25: rgba(0, 0, 0, 0.25);

  /* Vant theming (custom properties cascade into components) */
  --tabbar-background-color: #1d0520;
  --tabbar-item-text-color: rgba(249, 247, 242, 0.55);
  --tabbar-item-active-color: #00ff85;
  /* Interactive strip. Total bar = this + max(--tabbar-floor, safe-area). */
  --tabbar-height: 42px;
  /* Floor when env(safe-area-inset-bottom) is 0 (SE / many Androids / DevTools). */
  --tabbar-floor: 6px;

  background: var(--bg);
  color: var(--ink);
  font-size: 28rpx;
}

/* ---------- Layout primitives ---------- */

.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 24rpx;
}

/* Pages rendering <bottomNavBar />: content box + floor/safe-area + scroll peek */
.page-tabbar {
  padding-bottom: calc(var(--tabbar-height) + var(--tabbar-floor) + 24px);
  padding-bottom: calc(var(--tabbar-height) + 24px + max(var(--tabbar-floor), constant(safe-area-inset-bottom)));
  padding-bottom: calc(var(--tabbar-height) + 24px + max(var(--tabbar-floor), env(safe-area-inset-bottom)));
}

.section {
  margin-bottom: 24rpx;
}

.card {
  background: var(--card);
  border: 0;
  border-radius: 16rpx;
  padding: 24rpx;
  box-sizing: border-box;
  box-shadow: 0 2rpx 8rpx var(--plum-a4);
}

.title {
  font-size: 38rpx;
  font-weight: 800;
  color: var(--ink);
  letter-spacing: 0.5rpx;
}

/* Section heading under a page title (was per-page .title overrides) */
.section-title {
  margin-bottom: 14rpx;
  color: var(--ink);
  font-size: 34rpx;
  font-weight: 800;
}

/* Sub-section / card-level heading — live desk benchmark (was per-page
   .section-heading / .section-title-small copies) */
.section-heading {
  margin-bottom: 8rpx;
  color: var(--ink);
  font-size: 28rpx;
  font-weight: 800;
}

.subtitle {
  margin-top: 8rpx;
  color: var(--muted-ink);
  font-size: 24rpx;
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.muted {
  color: var(--muted-ink);
}

/* Quiet text control — desks, card headers, inline switches.
   Not a button. Web personal desk / live strip use this language. */
.action {
  color: var(--green-ink);
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1;
}

.action-muted {
  color: var(--muted-ink);
  font-weight: 700;
}

/* Universal press feedback: hover-class="hover-dim" */
.hover-dim {
  opacity: 0.82;
}

/* Compact outline tools — Lucide copy / compare, same language as web */
.tool-btn {
  position: relative;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 64rpx;
  height: 64rpx;
  border: 0;
  border-radius: 12rpx;
  background: var(--track);
  box-sizing: border-box;
}

.tool-btn.on {
  background: var(--accent-tint);
}

/* Labeled variant — icon + 2-char verb so the action is discoverable */
.tool-btn-labeled {
  width: auto;
  padding: 0 22rpx;
  gap: 8rpx;
}

.tool-btn-labeled .tool-icon {
  width: 30rpx;
  height: 30rpx;
}

.tool-label {
  color: var(--ink);
  font-size: 22rpx;
  font-weight: 800;
}

.tool-btn.done .tool-label {
  color: var(--green-ink);
}

.tool-icon {
  width: 36rpx;
  height: 36rpx;
}

.tool-badge {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  min-width: 28rpx;
  height: 28rpx;
  padding: 0 6rpx;
  border-radius: 14rpx;
  background: var(--plum);
  color: var(--electric);
  font-size: 18rpx;
  font-weight: 800;
  line-height: 28rpx;
  text-align: center;
}

/* ---------- Controls ---------- */

/* Form / recovery CTAs only. Never put these on a desk or list card. */
.btn-primary,
.btn-secondary,
.btn-text {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  margin: 0;
  min-height: 76rpx;
  padding: 0 32rpx;
  border-radius: 12rpx;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1;
}

.btn-primary {
  min-width: 220rpx;
  background: var(--cta);
  color: var(--cta-ink);
  font-weight: 800;
}

.btn-primary[disabled] {
  background: var(--cta-a45);
  color: var(--cta-ink);
}

.btn-secondary {
  border: 1rpx solid var(--line);
  background: var(--card);
  color: var(--ink);
}

.btn-text {
  min-height: 64rpx;
  padding: 0 8rpx;
  background: transparent;
  color: var(--muted-ink);
  font-weight: 600;
}

.btn-primary.btn-compact,
.btn-secondary.btn-compact {
  min-width: 104rpx;
  min-height: 64rpx;
  padding: 0 24rpx;
  font-size: 20rpx;
}

.btn-block {
  display: flex;
  width: 100%;
}

.btn-primary::after,
.btn-secondary::after,
.btn-text::after {
  border: 0;
}

.input {
  height: 80rpx;
  min-height: 80rpx;
  padding: 0 20rpx;
  background: var(--track);
  border: 0;
  border-radius: 12rpx;
  box-sizing: border-box;
  color: var(--ink);
  font-size: 28rpx;
  line-height: 80rpx;
}

.picker {
  min-height: 72rpx;
  padding: 18rpx 20rpx;
  background: var(--track);
  border: 0;
  border-radius: 12rpx;
  box-sizing: border-box;
  color: var(--ink);
}

/* ---------- Inline error banner (soft, retryable) ---------- */

.inline-error {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 24rpx;
  background: var(--card);
  border: 0;
  border-radius: 12rpx;
  box-shadow: 0 2rpx 8rpx var(--plum-a4);
  color: var(--warning);
  font-size: 24rpx;
}

.inline-error-retry {
  flex-shrink: 0;
  min-height: 64rpx;
  padding: 0 24rpx;
  border: 1rpx solid var(--line);
  border-radius: 10rpx;
  background: var(--track);
  color: var(--ink);
  font-size: 22rpx;
  font-weight: 700;
  line-height: 64rpx;
}

/* Danger variant — live data refresh failures */
.live-refresh-error {
  padding: 18rpx 22rpx;
  border: 1rpx solid var(--danger-a30);
  border-radius: 12rpx;
  background: var(--danger-tint);
  color: var(--danger);
  font-size: 24rpx;
  line-height: 1.45;
}

/* ---------- Tab strip (segmented control) ---------- */

.tab-strip {
  display: grid;
  grid-auto-flow: column;
  grid-auto-columns: 1fr;
  gap: 8rpx;
  padding: 8rpx;
  border-radius: 12rpx;
  background: var(--track);
}

.tab-item {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 64rpx;
  border-radius: 8rpx;
  color: var(--muted-ink);
  font-size: 24rpx;
  font-weight: 700;
}

.tab-active {
  background: var(--card);
  color: var(--ink);
  box-shadow: 0 2rpx 6rpx var(--plum-a8);
}

/* ---------- Metric tiles ---------- */

.metric-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
}

.metric-grid-three {
  grid-template-columns: repeat(3, minmax(0, 1fr));
}

.metric-card {
  min-width: 0;
  padding: 14rpx 6rpx;
}

.metric-label {
  color: var(--muted-ink);
  font-size: 22rpx;
}

.metric-value {
  display: block;
  margin-top: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: var(--ink);
  font-size: 30rpx;
  font-weight: 800;
}

.metric-value-bad {
  color: var(--danger);
}

/* ---------- Matchday utilities ---------- */

/* Broadcast chyron label — green tick + tracked caps */
.chyron {
  display: inline-flex;
  align-items: center;
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
  text-transform: uppercase;
  color: var(--muted-ink);
}

.chyron::before {
  content: '';
  width: 8rpx;
  height: 26rpx;
  margin-right: 14rpx;
  background: var(--cta);
  box-shadow: 0 0 10rpx var(--electric-a45);
}

/* Scoreboard — dark fascia panel with an electric edge */
.scoreboard {
  position: relative;
  overflow: hidden;
  border: 1rpx solid var(--electric-a28);
  border-radius: 20rpx;
  background:
    radial-gradient(ellipse 120% 90% at 50% -30%, var(--plum-a70), rgba(56, 0, 60, 0) 60%),
    linear-gradient(180deg, var(--fascia-hi), var(--fascia));
  color: var(--chalk);
  box-shadow: inset 0 1rpx 0 rgba(0, 255, 133, 0.2);
}

.scoreboard .muted {
  color: var(--chalk-a60);
}

/* Score-hero internals — dark fascia identity + big electric stat.
   Benchmark: live entry desk; shared by every page hero. */
.score-card {
  padding: 32rpx 28rpx 24rpx;
  box-sizing: border-box;
}

.score-top {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 28rpx;
}

.score-identity {
  flex: 1;
  min-width: 0;
  padding-bottom: 6rpx;
}

.score-team {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: var(--chalk);
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1.25;
}

.score-manager {
  margin-top: 10rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: var(--chalk-a60);
  font-size: 24rpx;
}

.score-hero {
  flex-shrink: 0;
  text-align: right;
}

.score-label {
  color: var(--muted-ink);
  font-size: 24rpx;
}

.score-card .score-label {
  margin: 0;
  color: var(--chalk-a60);
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.score {
  margin-top: 8rpx;
  color: var(--electric);
  font-size: 56rpx;
  font-weight: 800;
  line-height: 1;
}

.score-sub {
  margin-top: 24rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid var(--white-a10);
  color: var(--chalk-a60);
  font-size: 20rpx;
}

/* Pitch — dark formation card: position lines + player chips */
.pitch-card {
  padding: 28rpx;
}

.pitch-line {
  margin-bottom: 26rpx;
}

.pitch-line:last-child {
  margin-bottom: 0;
}

.pitch-pos {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 14rpx;
  color: var(--chalk-a60);
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
}

.pitch-tick {
  width: 18rpx;
  height: 4rpx;
  border-radius: 2rpx;
  background: var(--electric);
}

.pitch-players {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 14rpx;
}

.pitch-chip {
  min-width: 176rpx;
  padding: 14rpx 18rpx;
  border: 1rpx solid var(--electric-a28);
  border-radius: 12rpx;
  background: var(--white-a10);
  text-align: center;
}

.pitch-name {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: var(--chalk);
  font-size: 22rpx;
  font-weight: 700;
}

.pitch-team {
  margin-left: 8rpx;
  color: var(--chalk-a60);
  font-size: 18rpx;
  font-weight: 700;
}

.pitch-points {
  margin-top: 4rpx;
  color: var(--electric);
  font-size: 24rpx;
  font-weight: 800;
}

.pitch-empty {
  padding: 16rpx 0;
  color: var(--chalk-a60);
  font-size: 22rpx;
  text-align: center;
}

/* GW pill — plum board, electric text (web GW badge) */
.gw-pill-dark {
  display: inline-flex;
  align-items: center;
  padding: 8rpx 16rpx;
  border: 1rpx solid var(--electric-a35);
  border-radius: 8rpx;
  background: var(--plum);
  color: var(--electric);
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

/* Position labels — same muted ink for every position */
.pos-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  padding: 0;
  background: transparent;
  color: var(--muted-ink);
  font-size: 18rpx;
  font-weight: 800;
  line-height: 1.5;
  letter-spacing: 0.5rpx;
}

/* Fixture difficulty rating — web DIFFICULTY_COLORS scale */
.fdr {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 76rpx;
  padding: 4rpx 8rpx;
  border-radius: 6rpx;
  color: var(--card);
  font-size: 18rpx;
  font-weight: 700;
  line-height: 1.2;
}

.fdr-1 { background: var(--green-ink); }
.fdr-2 { background: var(--green-ink-a70); color: var(--cta-ink); }
.fdr-3 { background: var(--warning); }
.fdr-4 { background: var(--warning-a80); color: var(--cta-ink); }
.fdr-5 { background: var(--danger); }

/* ---------- Form fields ---------- */

.field-label {
  color: var(--ink);
  font-size: 26rpx;
  font-weight: 700;
}

.field-help {
  margin-top: 6rpx;
  color: var(--muted-ink);
  font-size: 22rpx;
}
