<view class="page page-tabbar">
  <view class="section">
    <view class="subtitle">20 支球队的阵容、赛程和定位球。</view>
  </view>

  <app-error-state id="perf-primary-content" wx:if="{{error}}" message="{{error}}" workload="{{errorWorkload}}" bind:retry="onRetry" />
  <app-loading wx:elif="{{loading}}" text="加载球队" />
  <view id="perf-primary-content" wx:else class="section card team-list">
    <app-empty-state
      wx:if="{{teams.length === 0}}"
      eyebrow="名单待就绪"
      title="球队名单还没有同步"
      description="新赛季球队数据准备好后会显示在这里"
      actionText="重新加载"
      bind:action="onRetry"
    />
    <view wx:for="{{teams}}" wx:key="id" class="team-row" data-team="{{item.id}}" hover-class="hover-dim" bindtap="onOpenTeam">
      <view class="team-badge">{{item.shortName || ''}}</view>
      <view class="team-name">{{item.name}}</view>
    </view>
  </view>
  <bottomNavBar />
</view>
