<view class="page">
  <view class="section">
    <view class="title">球队数据</view>
    <view class="subtitle">选择球队查看详情。</view>
  </view>

  <app-error-state id="perf-primary-content" wx:if="{{error}}" message="{{error}}" bind:retry="onRetry" />
  <app-loading wx:elif="{{loading}}" text="加载球队" />
  <view id="perf-primary-content" wx:else class="section card">
    <app-empty-state
      wx:if="{{teams.length === 0}}"
      eyebrow="名单待就绪"
      title="球队名单还没有同步"
      description="新赛季球队数据准备好后会显示在这里"
      actionText="重新加载"
      bind:action="onRetry"
    />
    <view wx:for="{{teams}}" wx:key="id" class="team-row" data-team="{{item.id}}" bindtap="onOpenTeam">
      <text>{{item.name}}</text>
      <text class="muted">{{item.shortName || ''}}</text>
    </view>
  </view>
  <bottomNavBar />
</view>
