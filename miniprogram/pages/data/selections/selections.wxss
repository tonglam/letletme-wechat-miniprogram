.selections-header,
.control-card,
.stat-row,
.stat-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.header-copy {
  min-width: 0;
  padding-right: 20rpx;
}

.field-label {
  color: var(--ink);
  font-size: 26rpx;
  font-weight: 700;
}

.field-help {
  margin-top: 6rpx;
  color: var(--muted-ink);
  font-size: 22rpx;
}

.picker-value {
  max-width: 360rpx;
  height: 72rpx;
  padding: 0 20rpx;
  overflow: hidden;
  border: 1rpx solid var(--line);
  border-radius: 12rpx;
  color: var(--ink);
  font-size: 24rpx;
  line-height: 72rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
  box-sizing: border-box;
}

.tab-strip {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 8rpx;
  padding: 8rpx;
  background: var(--track);
  border-radius: 12rpx;
}

.tab-item {
  height: 68rpx;
  border-radius: 8rpx;
  color: var(--muted-ink);
  font-size: 24rpx;
  font-weight: 700;
  line-height: 68rpx;
  text-align: center;
}

.tab-active {
  background: var(--card);
  color: var(--ink);
  box-shadow: 0 2rpx 6rpx var(--plum-a8);
}

.stat-card {
  padding-top: 8rpx;
  padding-bottom: 8rpx;
}

.stat-row {
  min-height: 104rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.stat-row:last-child {
  border-bottom: 0;
}

.rank-badge {
  flex-shrink: 0;
  width: 56rpx;
  color: var(--muted-ink);
  font-size: 22rpx;
  font-weight: 800;
  text-align: left;
}

.stat-main {
  min-width: 0;
  flex: 1;
  padding: 0 18rpx;
}

.player-name {
  min-width: 0;
  overflow: hidden;
  color: var(--ink);
  font-size: 26rpx;
  font-weight: 800;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.player-meta {
  flex-shrink: 0;
  margin-left: 12rpx;
  color: var(--muted-ink);
  font-size: 20rpx;
}

.bar-track {
  height: 10rpx;
  margin-top: 16rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: var(--track);
}

/* Bar fills — web semantic hues (selection=info, captain=warning, in=success, out=danger) */
.bar-fill {
  height: 100%;
  min-width: 8rpx;
  border-radius: 999rpx;
  background: var(--info);
}

.tab-captain {
  background: var(--warning);
}

.tab-transfersIn {
  background: var(--green-ink);
}

.tab-transfersOut {
  background: var(--danger);
}

.stat-side {
  flex-shrink: 0;
  width: 104rpx;
  text-align: right;
}

.primary-value,
.secondary-value {
  display: block;
  color: var(--ink);
  font-size: 24rpx;
  font-weight: 800;
}

.secondary-value {
  margin-top: 6rpx;
  color: var(--muted-ink);
  font-size: 22rpx;
}

.side-label {
  display: block;
  margin-top: 2rpx;
  color: var(--muted-ink);
  font-size: 18rpx;
  font-weight: 700;
}
