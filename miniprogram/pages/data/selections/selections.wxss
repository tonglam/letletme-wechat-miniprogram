.selections-header,
.control-card,
.stat-row,
.stat-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.header-copy {
  min-width: 0;
  padding-right: 20rpx;
}

.field-label {
  color: #111827;
  font-size: 26rpx;
  font-weight: 700;
}

.field-help {
  margin-top: 6rpx;
  color: #667085;
  font-size: 22rpx;
}

.picker-value {
  max-width: 360rpx;
  height: 72rpx;
  padding: 0 20rpx;
  overflow: hidden;
  border: 1rpx solid #d0d5dd;
  border-radius: 8rpx;
  color: #111827;
  font-size: 24rpx;
  line-height: 72rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
  box-sizing: border-box;
}

.tab-strip {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 8rpx;
  padding: 8rpx;
  background: #e5e7eb;
  border-radius: 8rpx;
}

.tab-item {
  height: 68rpx;
  border-radius: 6rpx;
  color: #475467;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 68rpx;
  text-align: center;
}

.tab-active {
  background: #ffffff;
  color: #111827;
  box-shadow: 0 8rpx 18rpx rgba(17, 24, 39, 0.08);
}

.stat-card {
  padding-top: 8rpx;
  padding-bottom: 8rpx;
}

.stat-row {
  min-height: 104rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #eef2f7;
}

.stat-row:last-child {
  border-bottom: 0;
}

.rank-badge {
  flex-shrink: 0;
  width: 56rpx;
  color: #667085;
  font-size: 22rpx;
  font-weight: 800;
  text-align: left;
}

.stat-main {
  min-width: 0;
  flex: 1;
  padding: 0 18rpx;
}

.player-name {
  min-width: 0;
  overflow: hidden;
  color: #111827;
  font-size: 26rpx;
  font-weight: 800;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.player-meta {
  flex-shrink: 0;
  margin-left: 12rpx;
  color: #667085;
  font-size: 20rpx;
}

.bar-track {
  height: 10rpx;
  margin-top: 16rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: #eef2f7;
}

.bar-fill {
  height: 100%;
  min-width: 8rpx;
  border-radius: 999rpx;
  background: #2563eb;
}

.tab-captain {
  background: #d97706;
}

.tab-transfersIn {
  background: #059669;
}

.tab-transfersOut {
  background: #dc2626;
}

.stat-side {
  flex-shrink: 0;
  width: 104rpx;
  text-align: right;
}

.primary-value,
.secondary-value {
  display: block;
  color: #111827;
  font-size: 24rpx;
  font-weight: 800;
}

.secondary-value {
  margin-top: 6rpx;
  color: #475467;
  font-size: 22rpx;
}

.side-label {
  display: block;
  margin-top: 2rpx;
  color: #98a2b3;
  font-size: 18rpx;
  font-weight: 700;
}
