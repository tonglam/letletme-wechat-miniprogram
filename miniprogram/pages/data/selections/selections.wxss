/* Tournament picker — strip language (首页 bind-strip / 账户页 me-strip) */

.sel-strip {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 22rpx 24rpx;
  border-radius: 12rpx;
  background: var(--track);
  box-sizing: border-box;
}

.sel-strip-main {
  min-width: 0;
}

.sel-strip-kicker {
  color: var(--muted-ink);
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.sel-strip-title {
  margin-top: 4rpx;
  overflow: hidden;
  color: var(--ink);
  font-size: 28rpx;
  font-weight: 800;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* Per-tab accents — match the bar-fill semantic hues below */
.accent-captain .tab-active {
  color: var(--warning);
}

.accent-transfersIn .tab-active {
  color: var(--green-ink);
}

.accent-transfersOut .tab-active {
  color: var(--danger);
}

.stat-card {
  padding-top: 8rpx;
  padding-bottom: 8rpx;
}

.stat-row,
.stat-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.stat-row {
  min-height: 104rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.stat-row:last-child {
  border-bottom: 0;
}

.rank-badge {
  flex-shrink: 0;
  width: 56rpx;
  color: var(--muted-ink);
  font-size: 22rpx;
  font-weight: 800;
  text-align: left;
}

.stat-main {
  min-width: 0;
  flex: 1;
  padding: 0 18rpx;
}

.player-name {
  min-width: 0;
  overflow: hidden;
  color: var(--ink);
  font-size: 26rpx;
  font-weight: 800;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.player-meta {
  flex-shrink: 0;
  margin-left: 12rpx;
  color: var(--muted-ink);
  font-size: 20rpx;
}

.bar-track {
  height: 10rpx;
  margin-top: 16rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: var(--track);
}

/* Bar fills — web semantic hues (selection=info, captain=warning, in=success, out=danger) */
.bar-fill {
  height: 100%;
  min-width: 8rpx;
  border-radius: 999rpx;
  background: var(--info);
}

.tab-captain {
  background: var(--warning);
}

.tab-transfersIn {
  background: var(--green-ink);
}

.tab-transfersOut {
  background: var(--danger);
}

.stat-side {
  flex-shrink: 0;
  min-width: 120rpx;
  text-align: right;
}

/* Primary value echoes the active board's hue */
.primary-value {
  display: block;
  color: var(--info);
  font-size: 28rpx;
  font-weight: 800;
}

.tab-text-captain {
  color: var(--warning);
}

.tab-text-transfersIn {
  color: var(--green-ink);
}

.tab-text-transfersOut {
  color: var(--danger);
}

/* Share row above the board — same language as the market desk */
.result-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 10rpx;
}

.result-row .result-count {
  color: var(--muted-ink);
  font-size: 22rpx;
  font-weight: 700;
}
