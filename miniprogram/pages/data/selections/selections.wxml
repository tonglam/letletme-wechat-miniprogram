<view class="page page-tabbar selections-page">
  <view class="section selections-header">
    <view class="header-copy">
      <view class="title">阵容选择</view>
      <view class="subtitle">{{headerSubtitle || '联赛选择率、队长和转会趋势'}}</view>
    </view>
    <gw-picker wx:if="{{tournaments.length}}" value="{{event}}" max="{{maxGw}}" bind:change="onEventChange" />
  </view>

  <view wx:if="{{tournaments.length}}" class="section card control-card">
    <view>
      <view class="field-label">联赛</view>
      <view class="field-help">{{totalEntriesText || '选择联赛查看数据'}}</view>
    </view>
    <picker mode="selector" range="{{tournamentNames}}" value="{{selectedTournamentIndex}}" bindchange="onTournamentChange">
      <view class="picker-value">{{selectedTournamentName || '请选择联赛'}}</view>
    </picker>
  </view>

  <app-error-state id="perf-primary-content" wx:if="{{error}}" message="{{error}}" bind:retry="onRetry" />
  <app-loading wx:elif="{{loadingTournaments}}" text="加载联赛" />
  <view id="perf-primary-content" wx:elif="{{emptyState}}" class="section">
    <app-empty-state
      eyebrow="{{emptyEyebrow}}"
      title="{{emptyTitle}}"
      description="{{emptyDescription}}"
      actionText="{{emptyActionText}}"
      featured="{{true}}"
      bind:action="onEmptyAction"
    />
  </view>

  <block wx:else>
    <view class="section tab-strip">
      <view wx:for="{{tabs}}" wx:key="key" class="tab-item {{activeTab === item.key ? 'tab-active' : ''}}" data-tab="{{item.key}}" hover-class="hover-dim" catchtap="onTabTap">
        {{item.label}}
      </view>
    </view>

    <app-loading wx:if="{{loadingStats}}" text="加载阵容选择" />
    <view id="perf-primary-content" wx:else class="section card stat-card">
      <app-empty-state
        wx:if="{{visibleRows.length === 0}}"
        title="{{statsEmptyTitle}}"
        description="{{statsEmptyDescription}}"
        actionText="重新加载"
        bind:action="onRetry"
      />
      <view wx:else>
        <view wx:for="{{visibleRows}}" wx:key="id" class="stat-row">
          <view class="rank-badge">{{item.rank}}</view>
          <view class="stat-main">
            <view class="stat-top">
              <text class="player-name">{{item.name}}</text>
              <text class="player-meta">{{item.meta}}</text>
            </view>
            <view class="bar-track">
              <view class="bar-fill tab-{{activeTab}}" style="{{item.barStyle}}"></view>
            </view>
          </view>
          <view class="stat-side">
            <text class="primary-value">{{item.primaryValue}}</text>
            <text class="side-label">{{item.primaryLabel}}</text>
            <text class="secondary-value">{{item.secondaryValue}}</text>
            <text class="side-label">{{item.secondaryLabel}}</text>
          </view>
        </view>
      </view>
    </view>

    <view class="section">
      <evidence-source text="范围:本赛事全部成员 · 精确 · LetLetMe 计算" />
    </view>
  </block>

  <bottomNavBar active="explore" />
</view>
