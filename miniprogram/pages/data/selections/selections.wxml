<view class="page page-tabbar selections-page">
  <view class="section">
    <view class="score-card scoreboard">
      <view class="score-top">
        <view class="score-identity">
          <view class="score-team">{{selectedTournamentName || '阵容选择'}}</view>
          <view class="score-manager">GW{{event}}{{totalEntriesText ? ' · ' + totalEntriesText : ''}}</view>
        </view>
        <gw-picker wx:if="{{tournaments.length}}" compact="{{true}}" dark="{{true}}" value="{{event}}" max="{{maxGw}}" bind:change="onEventChange" />
      </view>
    </view>
  </view>

  <view wx:if="{{tournaments.length}}" class="section">
    <picker mode="selector" range="{{tournamentNames}}" value="{{selectedTournamentIndex}}" bindchange="onTournamentChange">
      <view class="sel-strip" hover-class="hover-dim">
        <view class="sel-strip-main">
          <view class="sel-strip-kicker">赛事{{totalEntriesText ? ' · ' + totalEntriesText : ''}}</view>
          <view class="sel-strip-title">{{selectedTournamentName || '请选择赛事'}}</view>
        </view>
        <text class="action">切换 ›</text>
      </view>
    </picker>
  </view>

  <app-error-state id="perf-primary-content" wx:if="{{error}}" message="{{error}}" bind:retry="onRetry" />
  <app-loading wx:elif="{{loadingTournaments}}" text="加载赛事" />
  <view id="perf-primary-content" wx:elif="{{emptyState}}" class="section">
    <app-empty-state
      eyebrow="{{emptyEyebrow}}"
      title="{{emptyTitle}}"
      description="{{emptyDescription}}"
      actionText="{{emptyActionText}}"
      featured="{{true}}"
      bind:action="onEmptyAction"
    />
  </view>

  <block wx:else>
    <view class="section tab-strip accent-{{activeTab}}">
      <view wx:for="{{tabs}}" wx:key="key" class="tab-item {{activeTab === item.key ? 'tab-active' : ''}}" data-tab="{{item.key}}" hover-class="hover-dim" catchtap="onTabTap">
        {{item.label}}
      </view>
    </view>

    <app-loading wx:if="{{loadingStats}}" text="加载阵容选择" />
    <block wx:else>
      <view wx:if="{{visibleRows.length}}" class="section result-row">
        <view class="result-count">{{activeTabLabel}} · 前 {{visibleRows.length}} 名</view>
        <view class="tool-btn tool-btn-labeled {{shareCopied ? 'done' : ''}}" bindtap="onCopyShare" hover-class="hover-dim">
          <image wx:if="{{shareCopied}}" class="tool-icon" src="/assets/icons/check.svg" mode="aspectFit" />
          <image wx:else class="tool-icon" src="/assets/icons/copy.svg" mode="aspectFit" />
          <text class="tool-label">{{shareCopied ? '已复制' : '分享文字'}}</text>
        </view>
      </view>
      <view id="perf-primary-content" class="section card stat-card">
      <app-empty-state
        wx:if="{{visibleRows.length === 0}}"
        title="{{statsEmptyTitle}}"
        description="{{statsEmptyDescription}}"
        actionText="重新加载"
        bind:action="onRetry"
      />
      <view wx:else>
        <view wx:for="{{visibleRows}}" wx:key="id" class="stat-row">
          <view class="rank-badge">{{item.rank}}</view>
          <view class="stat-main">
            <view class="stat-top">
              <text class="player-name">{{item.name}}</text>
              <text class="player-meta">{{item.meta}}</text>
            </view>
            <view class="bar-track">
              <view class="bar-fill tab-{{activeTab}}" style="{{item.barStyle}}"></view>
            </view>
          </view>
          <view class="stat-side">
            <text class="primary-value tab-text-{{activeTab}}">{{item.primaryValue}}</text>
          </view>
        </view>
      </view>
      </view>
    </block>

    <view class="section">
      <evidence-source text="范围:本赛事全部成员 · 精确 · LetLetMe 计算" />
    </view>
  </block>

  <copy-fallback show="{{shareSheetOpen}}" text="{{shareText}}" bind:close="onCloseShareSheet" />
  <bottomNavBar active="explore" />
</view>
