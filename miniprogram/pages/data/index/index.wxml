<view class="page">
  <view class="section">
    <view class="title">数据</view>
    <view class="subtitle">球员、球队、赛程、身价和筛选器。</view>
  </view>

  <view wx:for="{{cards}}" wx:key="url" class="card data-card" data-url="{{item.url}}" bindtap="onOpenCard">
    <view>
      <view class="card-title">{{item.title}}</view>
      <view class="card-desc">{{item.description}}</view>
    </view>
    <text class="action">打开</text>
  </view>
  <bottomNavBar active="data" />
</view>
