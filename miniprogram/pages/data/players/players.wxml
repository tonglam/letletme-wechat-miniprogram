<view class="page">
  <view class="section">
    <view class="title">球员数据</view>
    <view class="subtitle">搜索球员并进入详情。</view>
  </view>

  <view class="section">
    <filter-bar keyword="{{keyword}}" placeholder="搜索球员" bind:search="onSearch" bind:reset="onResetSearch" />
  </view>

  <app-error-state wx:if="{{error}}" message="{{error}}" bind:retry="onRetry" />
  <app-loading wx:elif="{{loading}}" text="加载球员" />
  <view wx:else class="section card">
    <app-empty-state
      wx:if="{{players.length === 0}}"
      eyebrow="名单待就绪"
      title="球员名单还没有同步"
      description="新赛季球员数据准备好后会显示在这里"
      actionText="重新加载"
      bind:action="onRetry"
    />
    <app-empty-state
      wx:elif="{{displayedPlayers.length === 0}}"
      eyebrow="没有匹配"
      title="没有找到“{{keyword}}”"
      description="换个名字试试，或清除当前搜索"
      actionText="清除搜索"
      bind:action="onResetSearch"
    />
    <player-row wx:for="{{displayedPlayers}}" wx:key="code" player="{{item}}" showPrice="{{true}}" bind:open="onOpenPlayer" />
  </view>
  <bottomNavBar />
</view>
