.result-summary {
  margin-bottom: 16rpx;
  color: var(--muted-ink);
  font-size: 24rpx;
}

.load-more-error {
  display: flex;
  gap: 16rpx;
  align-items: center;
  justify-content: space-between;
  margin-top: 18rpx;
  padding: 16rpx;
  border-radius: 12rpx;
  background: var(--warning-tint);
  color: var(--warning);
  font-size: 24rpx;
}

.load-more-button {
  margin: 20rpx auto 0;
  border-color: var(--line);
  background: var(--card);
  color: var(--ink);
}

.list-end {
  padding: 24rpx 0 8rpx;
  color: var(--muted-ink);
  font-size: 22rpx;
  text-align: center;
}
