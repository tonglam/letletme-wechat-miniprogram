<view class="page page-tabbar">
  <view id="perf-primary-content" wx:if="{{emptyState}}" class="section">
    <app-empty-state
      eyebrow="还没选球员"
      title="先从球员列表选择一名球员"
      description="进入详情前需要一个具体球员，返回列表即可继续"
      actionText="返回球员列表"
      featured="{{true}}"
      bind:action="onBackToPlayers"
    />
  </view>
  <app-error-state id="perf-primary-content" wx:elif="{{error}}" message="{{error}}" workload="{{errorWorkload}}" bind:retry="onRetry" />
  <app-loading wx:elif="{{loading}}" text="加载球员详情" />
  <block wx:else>
    <view id="perf-primary-content" class="section">
      <view class="score-card scoreboard">
        <view class="score-top">
          <view class="score-identity">
            <view class="score-team">{{player.name || '-'}}</view>
            <view class="score-manager">{{player.team || ''}} · {{player.position || ''}}<text wx:if="{{player.teamName}}"> · {{player.teamName}}</text></view>
          </view>
          <view class="score-hero">
            <view class="score-label">身价</view>
            <view class="score">{{player.priceText || '-'}}</view>
          </view>
        </view>
      </view>
      <view wx:if="{{dataAvailabilityIssues.length}}" class="section-notice" role="status">
        <view class="notice-title">部分数据不是权威结果</view>
        <view class="notice-description">过期数据可能较旧，降级数据使用能力较弱的来源，不可用数据当前无法确认。</view>
        <view class="availability-issues">
          <view
            wx:for="{{dataAvailabilityIssues}}"
            wx:key="section"
            class="availability-issue availability-issue-{{item.tone}}"
          >
            {{item.sectionLabel}}：{{item.stateLabel}}
          </view>
        </view>
        <button class="notice-retry" bindtap="onRetry" disabled="{{loading}}">重新获取</button>
      </view>
      <view wx:if="{{injuryAvailability}}" class="injury-notice" role="status">
        <view class="notice-title">伤病与出场状态</view>
        <view class="injury-status">
          {{injuryAvailability.statusLabel}}
          <text wx:if="{{injuryAvailability.stale}}" class="injury-stale">来源已过期</text>
        </view>
        <view wx:if="{{injuryAvailability.news}}" class="notice-description">{{injuryAvailability.news}}</view>
      </view>
    </view>
    <view class="section">
      <view class="section-heading">赛季数据</view>
      <view class="metric-grid">
        <view wx:for="{{metrics}}" wx:key="label" class="metric-card">
          <text class="metric-label">{{item.label}}</text>
          <text class="metric-value">{{item.value}}</text>
        </view>
      </view>
    </view>
  </block>
  <bottomNavBar />
</view>
