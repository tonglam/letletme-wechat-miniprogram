<view class="page page-tabbar">
  <view id="perf-primary-content" wx:if="{{emptyState}}" class="section">
    <app-empty-state
      eyebrow="还没选球员"
      title="先从球员列表选择一名球员"
      description="进入详情前需要一个具体球员，返回列表即可继续"
      actionText="返回球员列表"
      featured="{{true}}"
      bind:action="onBackToPlayers"
    />
  </view>
  <app-error-state id="perf-primary-content" wx:elif="{{error}}" message="{{error}}" bind:retry="onRetry" />
  <app-loading wx:elif="{{loading}}" text="加载球员详情" />
  <view id="perf-primary-content" wx:else class="section card">
    <view class="title">{{player.name || '球员详情'}}</view>
    <view class="subtitle">{{player.team || ''}} {{player.position || ''}}</view>
    <view class="detail-row">
      <text>总分</text>
      <text>{{player.totalPoints || '-'}}</text>
    </view>
    <view class="detail-row">
      <text>价格</text>
      <text>{{player.price || '-'}}</text>
    </view>
  </view>
  <bottomNavBar />
</view>
