.mode-tabs {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 12rpx;
  padding: 8rpx;
  background: var(--track);
  border-radius: 12rpx;
}

.mode-tab {
  height: 72rpx;
  border-radius: 8rpx;
  color: var(--muted-ink);
  font-size: 26rpx;
  font-weight: 700;
  line-height: 72rpx;
  text-align: center;
}

.mode-tab.active {
  background: var(--card);
  color: var(--ink);
  box-shadow: 0 2rpx 6rpx var(--plum-a8);
}

.control-card,
.picker-head,
.date-picker,
.panel-head,
.price-change-row,
.selected-player,
.player-option,
.history-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.date-picker {
  min-width: 250rpx;
  height: 72rpx;
  padding: 0 20rpx;
  border: 1rpx solid var(--line);
  border-radius: 12rpx;
  color: var(--ink);
  font-size: 24rpx;
  box-sizing: border-box;
}

.picker-action {
  margin-left: 20rpx;
  color: var(--green-ink);
  font-size: 22rpx;
  font-weight: 700;
}

.price-columns {
  display: grid;
  grid-template-columns: 1fr;
  gap: 20rpx;
}

.price-panel {
  padding-bottom: 8rpx;
}

.panel-head {
  margin-bottom: 14rpx;
  color: var(--ink);
  font-size: 28rpx;
  font-weight: 800;
}

.panel-count {
  min-width: 44rpx;
  height: 36rpx;
  padding: 0 10rpx;
  border-radius: 999rpx;
  background: var(--track);
  color: var(--muted-ink);
  font-size: 22rpx;
  line-height: 36rpx;
  text-align: center;
}

.price-change-row,
.history-row {
  padding: 20rpx 0;
  border-top: 1rpx solid var(--line);
}

.change-main,
.history-main,
.player-option-main {
  min-width: 0;
  padding-right: 18rpx;
}

.change-player,
.player-option-name,
.selected-name,
.history-date {
  overflow: hidden;
  color: var(--ink);
  font-size: 26rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.change-meta,
.player-option-meta,
.selected-meta,
.history-transfer {
  margin-top: 6rpx;
  overflow: hidden;
  color: var(--muted-ink);
  font-size: 22rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.change-side,
.history-side {
  flex-shrink: 0;
  text-align: right;
}

.price-arrow,
.history-price {
  display: block;
  color: var(--ink);
  font-size: 22rpx;
  font-weight: 700;
}

.movement,
.history-movement,
.history-change {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  font-weight: 800;
}

.rise,
.movement-rise {
  color: var(--green-ink);
}

.fall,
.movement-fall {
  color: var(--danger);
}

.movement-flat {
  color: var(--muted-ink);
}

.picker-card {
  padding-bottom: 8rpx;
}

.clear-button {
  flex-shrink: 0;
  margin: 0;
  color: var(--muted-ink);
}

.filter-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 14rpx;
  margin-top: 20rpx;
}

.filter-picker,
.search-input {
  height: 72rpx;
  padding: 0 20rpx;
  border: 1rpx solid var(--line);
  border-radius: 12rpx;
  background: var(--card);
  color: var(--ink);
  font-size: 24rpx;
  line-height: 72rpx;
  box-sizing: border-box;
}

.filter-picker {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.search-box {
  position: relative;
  margin-top: 14rpx;
}

.search-input {
  width: 100%;
  padding-right: 72rpx;
}

.search-clear {
  position: absolute;
  top: 0;
  right: 0;
  width: 72rpx;
  height: 72rpx;
  color: var(--muted-ink);
  font-size: 34rpx;
  line-height: 68rpx;
  text-align: center;
}

/* Selected player — pitch-green highlight */
.selected-player {
  margin-top: 18rpx;
  padding: 18rpx 20rpx;
  border: 1rpx solid var(--green-ink-a30);
  border-radius: 12rpx;
  background: var(--accent-tint);
}

.selected-price,
.player-option-side {
  flex-shrink: 0;
  color: var(--green-ink);
  font-size: 24rpx;
  font-weight: 800;
}

.result-count {
  padding: 18rpx 0 6rpx;
  color: var(--muted-ink);
  font-size: 22rpx;
}

.player-option {
  padding: 20rpx 0;
  border-top: 1rpx solid var(--line);
}

.player-option.selected {
  margin: 0 -12rpx;
  padding-right: 12rpx;
  padding-left: 12rpx;
  border-radius: 12rpx;
  background: var(--accent-tint);
}

.history-card {
  padding-bottom: 8rpx;
}

.history-placeholder,
.player-list-placeholder {
  padding: 28rpx 0 12rpx;
  color: var(--muted-ink);
  font-size: 24rpx;
  text-align: center;
}
.load-more-error {
  margin-top: 18rpx;
}

.load-more-button {
  margin: 20rpx auto 0;
}
