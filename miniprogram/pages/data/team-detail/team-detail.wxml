<view class="page page-tabbar">
  <view id="perf-primary-content" wx:if="{{emptyState}}" class="section">
    <app-empty-state
      eyebrow="还没选球队"
      title="先从球队列表选择一支球队"
      description="进入详情前需要一支具体球队，返回列表即可继续"
      actionText="返回球队列表"
      featured="{{true}}"
      bind:action="onBackToTeams"
    />
  </view>
  <app-error-state id="perf-primary-content" wx:elif="{{error}}" message="{{error}}" workload="{{errorWorkload}}" bind:retry="onRetry" />
  <app-loading wx:elif="{{loading}}" text="加载球队详情" />
  <block wx:else>
    <view id="perf-primary-content" class="section">
      <view class="score-card scoreboard">
        <view class="score-top">
          <view class="score-identity">
            <view class="score-team">{{team.name || '-'}}</view>
            <view class="score-manager">{{team.shortName || ''}}<text wx:if="{{season}}"> · {{season}}</text></view>
          </view>
        </view>
      </view>
    </view>
    <view class="section card">
      <view class="strength-row">
        <text class="strength-label">强度</text>
        <view wx:if="{{hasStrength}}" class="strength-dots">
          <view wx:for="{{strengthDots}}" wx:key="index" class="strength-dot {{item ? 'on' : ''}}"></view>
        </view>
        <text wx:if="{{hasStrength}}" class="strength-value">{{team.strength}} / 5</text>
        <text wx:else class="strength-pending">综合强度待同步</text>
      </view>
    </view>
    <view class="section card team-detail-card">
      <view class="section-heading">赛季战绩</view>
      <view wx:if="{{hasSeasonRecord}}" class="team-metric-grid">
        <view wx:for="{{seasonMetrics}}" wx:key="label" class="team-metric">
          <text class="team-metric-label">{{item.label}}</text>
          <text class="team-metric-value">{{item.value}}</text>
        </view>
      </view>
      <view wx:else class="team-data-note">赛季战绩尚未同步，以下仅展示已发布的球队强度。</view>
    </view>
    <view wx:if="{{venueStrengths.length}}" class="section card team-detail-card">
      <view class="section-heading">主客场强度</view>
      <view class="venue-strength-list">
        <view wx:for="{{venueStrengths}}" wx:key="label" class="venue-strength-row">
          <text class="team-metric-label">{{item.label}}</text>
          <text class="team-metric-value">{{item.value}}</text>
        </view>
      </view>
    </view>
  </block>
  <bottomNavBar />
</view>
