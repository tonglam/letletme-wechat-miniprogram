/* Header */
.perf-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.perf-actions {
  display: flex;
  gap: 16rpx;
  padding-top: 6rpx;
  flex-shrink: 0;
}

.perf-btn {
  padding: 10rpx 22rpx;
  background: var(--track);
  color: var(--ink);
  font-size: 24rpx;
  border-radius: 8rpx;
  font-weight: 600;
}

.perf-btn-danger {
  background: var(--danger-tint);
  color: var(--danger);
}

/* Score Card — scoreboard panel */
.score-card {
  padding: 28rpx;
}

.score-body {
  display: flex;
  align-items: center;
  gap: 28rpx;
}

.score-ring {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 128rpx;
  height: 128rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
}

.score-ring-good { background: rgba(0, 209, 109, 0.25); }
.score-ring-avg  { background: var(--warning-a25); }
.score-ring-poor { background: var(--danger-a35); }
.score-ring-none { background: var(--chalk-a12); }

.score-number {
  font-size: 48rpx;
  font-weight: 800;
  line-height: 1;
}

.score-denom {
  font-size: 20rpx;
  opacity: 0.55;
  margin-top: 4rpx;
}

.score-info {
  flex: 1;
  min-width: 0;
}

.score-grade-lbl {
  font-size: 30rpx;
  font-weight: 700;
  margin-bottom: 16rpx;
}

.score-grade-good { color: var(--electric); }
.score-grade-avg  { color: var(--warning); }
.score-grade-poor { color: var(--danger); }
.score-grade-none { color: var(--chalk-a60); }

.score-bar-track {
  height: 12rpx;
  background: var(--white-a15);
  border-radius: 6rpx;
  overflow: hidden;
  margin-bottom: 14rpx;
}

.score-bar-fill {
  height: 100%;
  border-radius: 6rpx;
}

.score-fill-good { background: var(--electric); }
.score-fill-avg  { background: var(--warning); }
.score-fill-poor { background: var(--danger); }
.score-fill-none { background: var(--chalk-a30); }

.score-time {
  font-size: 22rpx;
  color: var(--chalk-a45);
}

/* Section heading */
.card-heading {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--ink);
  margin-bottom: 20rpx;
}

/* Metrics */
.metric-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.metric-row:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.metric-label {
  font-size: 26rpx;
  width: 150rpx;
  flex-shrink: 0;
}

.metric-right {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 14rpx;
  min-width: 0;
}

.metric-bar-track {
  flex: 1;
  height: 10rpx;
  background: var(--track);
  border-radius: 5rpx;
  overflow: hidden;
}

.metric-bar-fill {
  height: 100%;
  border-radius: 5rpx;
}

.metric-fill-good { background: var(--cta); }
.metric-fill-avg  { background: var(--warning); }
.metric-fill-poor { background: var(--danger); }
.metric-fill-none { background: var(--line); }

.metric-value {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--ink);
  width: 96rpx;
  text-align: right;
  flex-shrink: 0;
}

.metric-badge {
  font-size: 20rpx;
  font-weight: 700;
  padding: 4rpx 10rpx;
  border-radius: 6rpx;
  flex-shrink: 0;
  text-align: center;
  min-width: 44rpx;
}

.metric-badge-good { background: var(--accent-tint); color: var(--green-ink); }
.metric-badge-avg  { background: var(--warning-tint); color: var(--warning); }
.metric-badge-poor { background: var(--danger-tint); color: var(--danger); }
.metric-badge-none { background: var(--track); color: var(--muted-ink); }

/* Env */
.env-row {
  display: flex;
  align-items: center;
}

.env-item {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.env-key {
  font-size: 24rpx;
}

.env-val {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--ink);
}

.env-div {
  width: 1rpx;
  height: 28rpx;
  background: var(--line);
  margin: 0 28rpx;
}

/* API Table */
.api-summary {
  font-size: 22rpx;
  margin-bottom: 16rpx;
}

.api-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.api-row:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.api-name {
  flex: 1;
  font-size: 24rpx;
  color: var(--muted-ink);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-right: 16rpx;
}

.api-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-shrink: 0;
}

.api-ms {
  font-size: 22rpx;
  font-weight: 700;
  padding: 4rpx 10rpx;
  border-radius: 6rpx;
  min-width: 80rpx;
  text-align: center;
}

.api-count {
  font-size: 22rpx;
  min-width: 48rpx;
  text-align: right;
}

/* Misc */
.perf-hint {
  font-size: 26rpx;
  padding: 8rpx 0 16rpx;
}
