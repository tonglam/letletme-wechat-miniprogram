/* Header */
.perf-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.perf-actions {
  display: flex;
  gap: 16rpx;
  padding-top: 6rpx;
  flex-shrink: 0;
}

.perf-btn {
  padding: 10rpx 22rpx;
  background: var(--track, #f1efe9);
  color: var(--ink, #301333);
  font-size: 24rpx;
  border-radius: 8rpx;
  font-weight: 600;
}

.perf-btn-danger {
  background: var(--danger-tint, #fbe3e9);
  color: var(--danger, #c9183f);
}

/* Score Card — scoreboard panel */
.score-card {
  padding: 28rpx;
}

.score-body {
  display: flex;
  align-items: center;
  gap: 28rpx;
}

.score-ring {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 128rpx;
  height: 128rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
}

.score-ring-good { background: rgba(0, 209, 109, 0.25); }
.score-ring-avg  { background: rgba(251, 191, 36, 0.25); }
.score-ring-poor { background: rgba(201, 24, 63, 0.35); }
.score-ring-none { background: rgba(249, 247, 242, 0.12); }

.score-number {
  font-size: 48rpx;
  font-weight: 800;
  line-height: 1;
}

.score-denom {
  font-size: 20rpx;
  opacity: 0.55;
  margin-top: 4rpx;
}

.score-info {
  flex: 1;
  min-width: 0;
}

.score-grade-lbl {
  font-size: 32rpx;
  font-weight: 700;
  margin-bottom: 16rpx;
}

.score-grade-good { color: var(--electric, #00ff85); }
.score-grade-avg  { color: #fbbf24; }
.score-grade-poor { color: #f87171; }
.score-grade-none { color: rgba(249, 247, 242, 0.6); }

.score-bar-track {
  height: 12rpx;
  background: rgba(255, 255, 255, 0.15);
  border-radius: 6rpx;
  overflow: hidden;
  margin-bottom: 14rpx;
}

.score-bar-fill {
  height: 100%;
  border-radius: 6rpx;
}

.score-fill-good { background: var(--electric, #00ff85); }
.score-fill-avg  { background: #fbbf24; }
.score-fill-poor { background: #f87171; }
.score-fill-none { background: rgba(249, 247, 242, 0.3); }

.score-time {
  font-size: 22rpx;
  color: rgba(249, 247, 242, 0.45);
}

/* Section heading */
.card-heading {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--ink, #301333);
  margin-bottom: 20rpx;
}

/* Metrics */
.metric-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid var(--line, #ddd4de);
}

.metric-row:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.metric-label {
  font-size: 26rpx;
  width: 150rpx;
  flex-shrink: 0;
}

.metric-right {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 14rpx;
  min-width: 0;
}

.metric-bar-track {
  flex: 1;
  height: 10rpx;
  background: var(--track, #f1efe9);
  border-radius: 5rpx;
  overflow: hidden;
}

.metric-bar-fill {
  height: 100%;
  border-radius: 5rpx;
}

.metric-fill-good { background: var(--cta, #00d16d); }
.metric-fill-avg  { background: #f59e0b; }
.metric-fill-poor { background: var(--danger, #c9183f); }
.metric-fill-none { background: var(--line, #ddd4de); }

.metric-value {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--ink, #301333);
  width: 96rpx;
  text-align: right;
  flex-shrink: 0;
}

.metric-badge {
  font-size: 20rpx;
  font-weight: 700;
  padding: 4rpx 10rpx;
  border-radius: 6rpx;
  flex-shrink: 0;
  text-align: center;
  min-width: 44rpx;
}

.metric-badge-good { background: var(--accent-tint, #dcf6ea); color: var(--green-ink, #008545); }
.metric-badge-avg  { background: var(--warning-tint, #f6ead9); color: var(--warning, #924a07); }
.metric-badge-poor { background: var(--danger-tint, #fbe3e9); color: var(--danger, #c9183f); }
.metric-badge-none { background: var(--track, #f1efe9); color: var(--muted-ink, #6e5a72); }

/* Env */
.env-row {
  display: flex;
  align-items: center;
}

.env-item {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.env-key {
  font-size: 24rpx;
}

.env-val {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--ink, #301333);
}

.env-div {
  width: 1rpx;
  height: 28rpx;
  background: var(--line, #ddd4de);
  margin: 0 28rpx;
}

/* API Table */
.api-summary {
  font-size: 22rpx;
  margin-bottom: 16rpx;
}

.api-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--line, #ddd4de);
}

.api-row:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.api-name {
  flex: 1;
  font-size: 24rpx;
  color: var(--muted-ink, #6e5a72);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-right: 16rpx;
}

.api-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-shrink: 0;
}

.api-ms {
  font-size: 22rpx;
  font-weight: 700;
  padding: 4rpx 10rpx;
  border-radius: 6rpx;
  min-width: 80rpx;
  text-align: center;
}

.api-count {
  font-size: 22rpx;
  min-width: 48rpx;
  text-align: right;
}

/* Misc */
.perf-hint {
  font-size: 26rpx;
  padding: 8rpx 0 16rpx;
}
