.controls {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.controls gw-picker {
  flex: 1;
}

.mode-tabs {
  display: flex;
  gap: 8rpx;
  padding: 8rpx;
  background: var(--track);
  border-radius: 12rpx;
}

.mode-tab {
  min-width: 96rpx;
  height: 64rpx;
  border-radius: 8rpx;
  color: var(--muted-ink);
  font-size: 26rpx;
  font-weight: 700;
  line-height: 64rpx;
  text-align: center;
}

.mode-tab.active {
  background: var(--card);
  color: var(--ink);
  box-shadow: 0 2rpx 6rpx var(--plum-a8);
}

.team-card {
  padding: 20rpx 24rpx;
}

.team-card + .team-card {
  margin-top: 16rpx;
}

.team-name {
  color: var(--ink);
  font-size: 28rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
}

.chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.chip-wrap {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.chip-finished {
  opacity: 0.45;
}

.chip-event {
  color: var(--muted-ink);
  font-size: 22rpx;
}

.chip-empty {
  font-size: 24rpx;
}
