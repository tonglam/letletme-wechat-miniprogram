.controls {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.mode-tabs {
  display: flex;
  gap: 8rpx;
  padding: 8rpx;
  background: var(--track);
  border-radius: 12rpx;
}

.mode-tab {
  min-width: 84rpx;
  height: 64rpx;
  border-radius: 8rpx;
  color: var(--muted-ink);
  font-size: 26rpx;
  font-weight: 700;
  line-height: 64rpx;
  text-align: center;
}

.mode-tab.active {
  background: var(--card);
  color: var(--ink);
  box-shadow: 0 2rpx 6rpx var(--plum-a8);
}

/* FDR legend — same 1-5 palette as fixture-chip (page-scoped copy). */
.legend-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.legend-label {
  color: var(--muted-ink);
  font-size: 22rpx;
  font-weight: 700;
}

.legend-items {
  display: flex;
  gap: 8rpx;
}

.legend-item {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  min-width: 56rpx;
  height: 40rpx;
  padding: 0 10rpx;
  border: 1rpx solid var(--line);
  border-radius: 8rpx;
  font-size: 20rpx;
  font-weight: 700;
  box-sizing: border-box;
}

/* Web legend recipe: soft pill + solid band dot (text stays plain ink). */
.legend-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
}

.fdr-dot-1 { background: var(--green-ink); }
.fdr-dot-2 { background: var(--green-ink-a70); }
.fdr-dot-3 { background: var(--muted-ink-a50); }
.fdr-dot-4 { background: var(--warning); }
.fdr-dot-5 { background: var(--danger); }

.legend-hint {
  color: var(--muted-ink);
  font-size: 20rpx;
}

.fdr-1 {
  border-color: var(--green-ink-a40);
  background: var(--accent-tint);
  color: var(--ink);
}

.fdr-2 {
  border-color: var(--green-ink-a30);
  background: var(--cta-a12);
  color: var(--ink);
}

.fdr-3 {
  border-color: var(--line);
  background: var(--track);
  color: var(--ink);
}

.fdr-4 {
  border-color: var(--warning-a45);
  background: var(--warning-tint);
  color: var(--ink);
}

.fdr-5 {
  border-color: var(--danger-a40);
  background: var(--danger-tint);
  color: var(--ink);
}

/* Glance strip — web at-a-glance cards (best/worst run, softest/hardest next). */
.glance-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.glance-card {
  width: calc(50% - 6rpx);
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  background: var(--card);
  box-shadow: 0 2rpx 8rpx var(--plum-a4);
  box-sizing: border-box;
  text-align: center;
}

.glance-label {
  color: var(--muted-ink);
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.glance-value {
  display: inline-block;
  margin-top: 8rpx;
  padding: 2rpx 14rpx;
  border: 1rpx solid var(--line);
  border-radius: 8rpx;
  color: var(--ink);
  font-size: 30rpx;
  font-weight: 800;
}

.glance-sub {
  margin-top: 8rpx;
  color: var(--muted-ink);
  font-size: 20rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.team-card {
  padding: 20rpx 24rpx;
}

.team-card + .team-card {
  margin-top: 16rpx;
}

.team-head {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 12rpx;
}

.team-name {
  min-width: 0;
  flex: 1;
  color: var(--ink);
  font-size: 28rpx;
  font-weight: 700;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.team-meta {
  color: var(--muted-ink);
  font-size: 20rpx;
}

.avg-badge {
  min-width: 64rpx;
  padding: 4rpx 10rpx;
  border: 1rpx solid var(--line);
  border-radius: 8rpx;
  background: var(--track);
  color: var(--ink);
  font-size: 22rpx;
  font-weight: 800;
  text-align: center;
  box-sizing: border-box;
}

/* One column per GW, mirroring the web FDR matrix. */
.cell-row {
  display: flex;
  align-items: flex-start;
  gap: 8rpx;
}

.run-cell {
  flex: 1 1 0;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.cell-head {
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.cell-event {
  color: var(--muted-ink);
  font-size: 20rpx;
}

.cell-dgw {
  color: var(--green-ink);
  font-size: 18rpx;
  font-weight: 700;
}

.cell-blank {
  padding: 10rpx 6rpx;
  border: 1rpx dashed var(--line);
  border-radius: 8rpx;
  color: var(--muted-ink);
  font-size: 20rpx;
  text-align: center;
  box-sizing: border-box;
}

.chip-wrap {
  display: flex;
}

.chip-finished {
  opacity: 0.45;
}
