.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 24rpx 24rpx 40rpx;
  background: var(--bg, #f9f8f4);
}

.section {
  margin-bottom: 24rpx;
}

.title {
  color: var(--ink, #301333);
  font-size: 34rpx;
  font-weight: 800;
}

.subtitle {
  margin-top: 8rpx;
  color: var(--muted-ink, #6e5a72);
  font-size: 24rpx;
}

.controls {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.controls gw-picker {
  flex: 1;
}

.mode-tabs {
  display: flex;
  gap: 8rpx;
  padding: 8rpx;
  background: var(--track, #f1efe9);
  border-radius: 12rpx;
}

.mode-tab {
  min-width: 96rpx;
  height: 64rpx;
  border-radius: 8rpx;
  color: var(--muted-ink, #6e5a72);
  font-size: 26rpx;
  font-weight: 700;
  line-height: 64rpx;
  text-align: center;
}

.mode-tab.active {
  background: var(--card, #ffffff);
  color: var(--ink, #301333);
  box-shadow: 0 2rpx 6rpx rgba(56, 0, 60, 0.08);
}

.inline-error {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 24rpx;
  background: var(--card, #ffffff);
  border: 1rpx solid var(--line, #ddd4de);
  border-radius: 12rpx;
  color: #b25e09;
  font-size: 24rpx;
}

.inline-error-retry {
  flex-shrink: 0;
  min-width: 88rpx;
  min-height: 56rpx;
  line-height: 56rpx;
  margin-left: 16rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  border-radius: 999rpx;
  background: var(--track, #f1efe9);
  color: var(--green-ink, #008545);
  font-weight: 700;
  text-align: center;
}

.team-card {
  padding: 20rpx 24rpx;
  background: var(--card, #ffffff);
  border: 1rpx solid var(--line, #ddd4de);
  border-radius: 12rpx;
}

.team-card + .team-card {
  margin-top: 16rpx;
}

.team-name {
  color: var(--ink, #301333);
  font-size: 28rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
}

.chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.chip-wrap {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.chip-finished {
  opacity: 0.45;
}

.chip-event {
  color: var(--muted-ink, #6e5a72);
  font-size: 22rpx;
}

.chip-empty {
  color: var(--muted-ink, #6e5a72);
  font-size: 24rpx;
}
