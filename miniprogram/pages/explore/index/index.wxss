.group-title {
  margin-bottom: 12rpx;
  color: var(--muted-ink, #6e5a72);
  font-size: 22rpx;
  font-weight: 700;
}

.route-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
}

.route-card {
  display: flex;
  flex-direction: column;
  align-items: stretch;
  justify-content: space-between;
  min-width: 0;
  min-height: 156rpx;
  margin: 0;
  padding: 18rpx 20rpx;
}

.route-card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-width: 0;
  gap: 12rpx;
}

.card-title {
  min-width: 0;
  font-size: 27rpx;
  font-weight: 700;
}

.card-desc {
  margin-top: 10rpx;
  color: var(--muted-ink, #6e5a72);
  font-size: 21rpx;
  line-height: 1.35;
}

.route-card .action {
  flex-shrink: 0;
  font-size: 21rpx;
}
