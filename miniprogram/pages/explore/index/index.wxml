<view class="page">
  <view class="section">
    <view class="title">探索</view>
    <view wx:if="{{contextText}}" class="subtitle">{{contextText}}</view>
  </view>

  <view class="section">
    <filter-bar keyword="{{keyword}}" placeholder="搜索球员" actionText="查询" bind:search="onSearch" bind:submit="onSubmitSearch" bind:reset="onResetSearch" />
  </view>

  <view wx:for="{{groups}}" wx:key="title" class="section">
    <view class="group-title">{{item.title}}</view>
    <view class="route-grid">
      <view
        wx:for="{{item.cards}}"
        wx:for-item="card"
        wx:key="url"
        class="card route-card"
        data-url="{{card.url}}"
        bindtap="onOpenCard"
      >
        <view class="route-card-head">
          <view class="card-title">{{card.title}}</view>
          <text class="action">打开</text>
        </view>
        <view class="card-desc">{{card.description}}</view>
      </view>
    </view>
  </view>

  <bottomNavBar active="explore" />
</view>
