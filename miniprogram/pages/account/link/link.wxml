<view class="page">
  <view id="perf-primary-content" class="section card">
    <view class="subtitle">可选。关联后会同步网页端已验证的球队。</view>
    <input class="input" type="text" placeholder="邮箱" value="{{email}}" bindinput="onEmailInput" />
    <button class="btn-secondary btn-block link-button" loading="{{sending}}" disabled="{{sending}}" bindtap="sendCode">发送验证码</button>
    <input class="input" type="number" placeholder="邮箱验证码" value="{{code}}" bindinput="onCodeInput" />
    <button class="btn-primary btn-block link-button" loading="{{confirming}}" disabled="{{confirming}}" bindtap="confirm">确认并登录</button>
    <view wx:if="{{error}}" class="inline-error">{{error}}</view>
    <view class="legal-note">确认时使用当前微信登录凭据，成功后此设备会保持 30 天会话。不关联也可以在查找球队页手动选择。</view>
    <button class="btn-text link-text" bindtap="logout">退出当前设备</button>
  </view>
  <privacy-dialog />
</view>
