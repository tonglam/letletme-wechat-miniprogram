<view class="page">
  <view class="section card">
    <view class="title">关联你的 LetLetMe 账户</view>
    <view class="subtitle">输入网站账户邮箱。确认时会使用当前微信登录凭据，成功后会创建此设备的 30 天会话。</view>
    <input class="input" type="text" placeholder="邮箱" value="{{email}}" bindinput="onEmailInput" />
    <button class="secondary-button" loading="{{sending}}" disabled="{{sending}}" bindtap="sendCode">发送验证码</button>
    <input class="input" type="number" placeholder="邮箱验证码" value="{{code}}" bindinput="onCodeInput" />
    <button class="primary-button" loading="{{confirming}}" disabled="{{confirming}}" bindtap="confirm">确认并登录</button>
    <view wx:if="{{error}}" class="inline-error">{{error}}</view>
    <button class="text-button" bindtap="logout">退出当前设备</button>
  </view>
</view>
