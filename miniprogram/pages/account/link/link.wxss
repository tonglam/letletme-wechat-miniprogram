/* Page uses global .card/.title/.subtitle/.inline-error primitives. */

/* Extends global .input — taller field with vertical rhythm */
.input {
  height: 88rpx;
  padding: 0 24rpx;
  margin: 18rpx 0;
  display: flex;
  align-items: center;
}

.primary-button,
.secondary-button {
  margin-top: 18rpx;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  font-weight: 700;
  padding: 0;
}

.primary-button::after,
.secondary-button::after {
  border: 0;
}

.primary-button {
  background: var(--cta);
  color: var(--cta-ink);
}

.primary-button[disabled] {
  background: var(--cta-a45);
  color: var(--cta-ink);
  opacity: 1;
}

.secondary-button {
  background: var(--card);
  color: var(--ink);
  border: 1rpx solid var(--line);
}

.text-button { margin-top: 24rpx; color: var(--muted-ink); background: transparent; font-size: 28rpx; }
.text-button::after { border: 0; }
