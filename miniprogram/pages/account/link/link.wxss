.card { padding: 32rpx; margin: 32rpx; }
.title { font-size: 40rpx; font-weight: 600; margin-bottom: 16rpx; }
.subtitle { color: #667085; line-height: 1.6; margin-bottom: 24rpx; }
.input { border: 1px solid #d0d5dd; border-radius: 12rpx; padding: 22rpx; margin: 18rpx 0; }
.primary-button, .secondary-button { margin-top: 18rpx; }
.text-button { margin-top: 24rpx; color: #475467; background: transparent; font-size: 28rpx; }
.inline-error { color: #b42318; margin-top: 16rpx; }
