.card { padding: 32rpx; margin: 32rpx; }
.title { font-size: 40rpx; font-weight: 600; margin-bottom: 16rpx; }
.subtitle { color: var(--muted-ink, #6e5a72); line-height: 1.6; margin-bottom: 24rpx; }

.input {
  height: 88rpx;
  padding: 0 24rpx;
  margin: 18rpx 0;
  border: 1rpx solid var(--line, #ddd4de);
  border-radius: 12rpx;
  background: var(--card, #ffffff);
  color: var(--ink, #301333);
  box-sizing: border-box;
  display: flex;
  align-items: center;
}

.primary-button,
.secondary-button {
  margin-top: 18rpx;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  font-weight: 700;
  padding: 0;
}

.primary-button::after,
.secondary-button::after {
  border: 0;
}

.primary-button {
  background: var(--cta, #00d16d);
  color: var(--cta-ink, #1a001e);
}

.primary-button[disabled] {
  background: rgba(0, 209, 109, 0.45);
  color: var(--cta-ink, #1a001e);
  opacity: 1;
}

.secondary-button {
  background: var(--card, #ffffff);
  color: var(--ink, #301333);
  border: 1rpx solid var(--line, #ddd4de);
}

.text-button { margin-top: 24rpx; color: var(--muted-ink, #6e5a72); background: transparent; font-size: 28rpx; }
.text-button::after { border: 0; }
.inline-error { color: var(--danger, #c9183f); margin-top: 16rpx; }
