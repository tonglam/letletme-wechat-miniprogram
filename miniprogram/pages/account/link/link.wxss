/* Page uses global .card/.title/.subtitle/.inline-error primitives. */

/* Extends global .input — taller field with vertical rhythm */
.input {
  height: 88rpx;
  padding: 0 24rpx;
  margin: 18rpx 0;
  display: flex;
  align-items: center;
}

.link-button {
  margin-top: 18rpx;
}

.legal-note {
  margin-top: 20rpx;
  color: var(--muted-ink);
  font-size: 22rpx;
  line-height: 1.5;
}

.link-text {
  margin-top: 24rpx;
}
