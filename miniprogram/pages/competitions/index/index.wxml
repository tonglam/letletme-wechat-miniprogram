<view class="page page-tabbar">
  <view class="section">
    <view class="section-title">我的赛事</view>
    <view class="subtitle">你参与的已筹备赛事 · 创建与管理在网页版进行</view>
  </view>

  <view wx:if="{{entryId}}" class="section">
    <filter-bar keyword="{{keyword}}" placeholder="搜索赛事" actionText="查询" bind:search="onKeyword" bind:submit="onKeyword" bind:reset="onResetSearch" />
  </view>

  <view wx:if="{{error}}" class="section">
    <view class="inline-error">
      <text>{{error}}</text>
      <view class="inline-error-retry" hover-class="hover-dim" bindtap="onRetry">重试</view>
    </view>
  </view>

  <app-loading wx:if="{{loading}}" text="加载赛事" />
  <view id="perf-primary-content" wx:elif="{{!entryId}}" class="section">
    <app-empty-state
      eyebrow="需要球队"
      title="先选择我的球队"
      description="查找球队并设为我的球队后，即可看到你参与的赛事。"
      actionText="去选择球队"
      featured="{{true}}"
      bind:action="onEmptyAction"
    />
  </view>
  <view id="perf-primary-content" wx:elif="{{items.length === 0 && !error}}" class="section">
    <app-empty-state
      title="暂无已筹备赛事"
      description="赛事分两种：追踪官方 FPL 联赛的赛事，以及按自定义规则进行的赛事。创建和筹备请在网页版完成。"
      actionText="在网页创建赛事"
      featured="{{true}}"
      bind:action="onCreateCompetition"
    />
  </view>
  <view id="perf-primary-content" wx:elif="{{displayItems.length === 0 && keyword && !error}}" class="section">
    <app-empty-state
      title="没有匹配的赛事"
      description="换个关键词试试。"
      actionText="清除搜索"
      bind:action="onResetSearch"
    />
  </view>
  <block wx:else>
    <view wx:if="{{fromCache}}" class="section">
      <view class="cache-hint">当前显示上次成功结果</view>
    </view>
    <view id="perf-primary-content" class="section competition-list">
      <competition-card
        wx:for="{{displayItems}}"
        wx:key="competitionId"
        item="{{item}}"
        data-index="{{index}}"
        bind:open="onOpenCompetition"
        bind:manage="onManageCompetition"
      />
    </view>
  </block>

  <bottomNavBar active="competitions" />
</view>
