.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 24rpx 24rpx 40rpx;
  background: var(--bg, #f9f8f4);
}

.section {
  margin-bottom: 24rpx;
}

.title {
  color: var(--ink, #301333);
  font-size: 34rpx;
  font-weight: 800;
}

.subtitle {
  margin-top: 8rpx;
  color: var(--muted-ink, #6e5a72);
  font-size: 24rpx;
}

.inline-error {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 24rpx;
  background: var(--card, #ffffff);
  border: 1rpx solid var(--line, #ddd4de);
  border-radius: 12rpx;
  color: #b25e09;
  font-size: 24rpx;
}

.inline-error-retry {
  flex-shrink: 0;
  min-width: 88rpx;
  min-height: 56rpx;
  line-height: 56rpx;
  margin-left: 16rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  border-radius: 999rpx;
  background: var(--track, #f1efe9);
  color: var(--green-ink, #008545);
  font-weight: 700;
  text-align: center;
}

.cache-hint {
  color: #b25e09;
  font-size: 22rpx;
}

.competition-list competition-card {
  display: block;
}

.competition-list competition-card + competition-card {
  margin-top: 20rpx;
}
