<view class="page">
  <view class="entry-hero section">
    <view class="title">查看 FPL 球队</view>
    <view class="subtitle">账户绑定只能在 LetLetMe 网页端通过球队名称验证完成。</view>
  </view>

  <view class="bind-card section">
    <view class="field-label">FPL Entry ID</view>
    <view class="input-shell">
      <input
        class="entry-input"
        type="number"
        placeholder="例如 123456"
        placeholder-class="input-placeholder"
        value="{{manualEntryId}}"
        confirm-type="done"
        bindinput="onManualEntryInput"
        bindconfirm="onEntryConfirm"
      />
    </view>
    <view class="field-help">可在 FPL 官网球队页面 URL 中找到 Entry ID。</view>
    <view class="guide">
      <view class="guide-title">如何找到你的 Entry ID</view>
      <view class="guide-steps">
        <view class="guide-step"><text class="step-num">1</text>打开 fantasy.premierleague.com 并登录</view>
        <view class="guide-step"><text class="step-num">2</text>进入 "Points" 或 "Pick Team" 页面</view>
        <view class="guide-step"><text class="step-num">3</text>URL 中的数字就是你的 Entry ID</view>
        <view class="guide-step"><text class="step-num">4</text>例如 …/entry/<text class="step-hl">123456</text>/event/…</view>
      </view>
    </view>
    <button class="primary-button" loading="{{loading}}" disabled="{{loading}}" bindtap="onValidateAndSaveEntry">
      验证球队
    </button>
  </view>

  <view wx:if="{{error}}" class="inline-error section">{{error}}</view>

  <view wx:if="{{hasPreview}}" class="preview-card section">
    <view class="preview-title">{{previewTitle}}</view>
    <view class="preview-subtitle">{{previewSubtitle}}</view>
    <view class="preview-stats">
      <view class="preview-stat">
        <view class="stat-value">{{previewTotalPoints}}</view>
        <view class="stat-label">总分</view>
      </view>
      <view class="preview-stat">
        <view class="stat-value">{{previewOverallRank}}</view>
        <view class="stat-label">总排名</view>
      </view>
    </view>
  </view>

</view>
