.page {
  padding: 36rpx 28rpx 56rpx;
}

.entry-hero {
  padding: 8rpx 2rpx 4rpx;
}

.title {
  margin-top: 10rpx;
  font-size: 42rpx;
  line-height: 1.18;
  font-weight: 800;
  color: var(--ink, #301333);
}

.subtitle {
  margin-top: 14rpx;
  color: var(--muted-ink, #6e5a72);
  font-size: 26rpx;
  line-height: 1.45;
}

.lookup-card,
.preview-card {
  background: var(--card, #ffffff);
  border: 1rpx solid var(--line, #ddd4de);
  border-radius: 16rpx;
  padding: 28rpx;
  box-sizing: border-box;
}

.field-label {
  margin-bottom: 14rpx;
  color: var(--ink, #301333);
  font-size: 26rpx;
  font-weight: 700;
}

.input-shell {
  height: 88rpx;
  padding: 0 24rpx;
  background: var(--card, #ffffff);
  border: 1rpx solid var(--line, #ddd4de);
  border-radius: 12rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
}

.entry-input {
  width: 100%;
  height: 86rpx;
  color: var(--ink, #301333);
  font-size: 30rpx;
  line-height: 86rpx;
}

.input-placeholder {
  color: var(--muted-ink, #6e5a72);
  font-size: 30rpx;
}

.field-help {
  margin-top: 12rpx;
  color: var(--muted-ink, #6e5a72);
  font-size: 22rpx;
  line-height: 1.4;
}

/* Guide — pitch-green info box */
.guide {
  margin-top: 20rpx;
  padding: 20rpx 22rpx;
  background: var(--accent-tint, #dcf6ea);
  border: 1rpx solid rgba(0, 133, 69, 0.25);
  border-radius: 12rpx;
}

.guide-title {
  color: var(--green-ink, #008545);
  font-size: 24rpx;
  font-weight: 700;
  margin-bottom: 14rpx;
}

.guide-steps {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.guide-step {
  display: flex;
  align-items: baseline;
  color: var(--ink, #301333);
  font-size: 22rpx;
  line-height: 1.5;
}

.step-num {
  flex-shrink: 0;
  width: 32rpx;
  height: 32rpx;
  line-height: 32rpx;
  text-align: center;
  margin-right: 14rpx;
  background: var(--green-ink, #008545);
  color: #ffffff;
  font-size: 20rpx;
  font-weight: 700;
  border-radius: 50%;
}

.step-hl {
  color: var(--green-ink, #008545);
  font-weight: 700;
}

/* Primary CTA — pitch green, plum text (web primary button) */
.primary-button {
  margin: 28rpx 0 0;
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 12rpx;
  background: var(--cta, #00d16d);
  color: var(--cta-ink, #1a001e);
  font-size: 28rpx;
  font-weight: 800;
  padding: 0;
}

.primary-button[disabled] {
  background: rgba(0, 209, 109, 0.45);
  color: var(--cta-ink, #1a001e);
  opacity: 1;
}

.primary-button::after {
  border: 0;
}

.inline-error {
  padding: 18rpx 22rpx;
  background: var(--danger-tint, #fbe3e9);
  border: 1rpx solid rgba(201, 24, 63, 0.3);
  border-radius: 12rpx;
  color: var(--danger, #c9183f);
  font-size: 24rpx;
  line-height: 1.45;
}

.preview-title {
  color: var(--ink, #301333);
  font-size: 32rpx;
  font-weight: 800;
  line-height: 1.3;
}

.preview-subtitle {
  margin-top: 8rpx;
  color: var(--muted-ink, #6e5a72);
  font-size: 24rpx;
}

.preview-stats {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12rpx;
  margin-top: 22rpx;
}

.preview-stat {
  padding: 18rpx;
  background: var(--track, #f1efe9);
  border-radius: 12rpx;
}

.stat-value {
  color: var(--ink, #301333);
  font-size: 30rpx;
  font-weight: 800;
}

.stat-label {
  margin-top: 4rpx;
  color: var(--muted-ink, #6e5a72);
  font-size: 22rpx;
}

.current-entry-hint {
  margin-top: 22rpx;
  text-align: center;
  color: var(--green-ink, #008545);
  font-size: 24rpx;
  font-weight: 700;
}

.sync-hint {
  text-align: center;
  color: var(--green-ink, #008545);
  font-size: 24rpx;
  font-weight: 700;
}
