.entry-hero {
  padding: 8rpx 2rpx 4rpx;
}

.title {
  margin-top: 10rpx;
  font-size: 38rpx;
  line-height: 1.18;
  font-weight: 800;
  color: var(--ink);
}

.subtitle {
  margin-top: 14rpx;
  color: var(--muted-ink);
  font-size: 26rpx;
  line-height: 1.45;
}

.current-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 22rpx 28rpx;
}

.current-main {
  min-width: 0;
}

.current-label {
  color: var(--muted-ink);
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.current-id {
  margin-top: 4rpx;
  color: var(--ink);
  font-size: 28rpx;
  font-weight: 800;
  font-variant-numeric: tabular-nums;
}

.current-unbind {
  flex-shrink: 0;
  color: var(--danger);
}

.lookup-card,
.preview-card {
  padding: 28rpx;
}

.field-label {
  margin-bottom: 14rpx;
  color: var(--ink);
  font-size: 26rpx;
  font-weight: 700;
}

.input-shell {
  height: 88rpx;
  padding: 0 24rpx;
  background: var(--track);
  border: 0;
  border-radius: 14rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
}

.entry-input {
  width: 100%;
  height: 86rpx;
  color: var(--ink);
  font-size: 30rpx;
  line-height: 86rpx;
}

.input-placeholder {
  color: var(--muted-ink);
  font-size: 30rpx;
}

.field-help {
  margin-top: 12rpx;
  color: var(--muted-ink);
  font-size: 22rpx;
  line-height: 1.4;
}

/* Guide — pitch-green info box */
.guide {
  margin-top: 20rpx;
  padding: 20rpx 22rpx;
  background: var(--accent-tint);
  border: 1rpx solid var(--green-ink-a25);
  border-radius: 12rpx;
}

.guide + .guide {
  margin-top: 12rpx;
}

.guide-title {
  color: var(--green-ink);
  font-size: 24rpx;
  font-weight: 700;
  margin-bottom: 14rpx;
}

.guide-steps {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.guide-step {
  display: flex;
  align-items: baseline;
  color: var(--ink);
  font-size: 22rpx;
  line-height: 1.5;
}

.step-num {
  flex-shrink: 0;
  width: 32rpx;
  height: 32rpx;
  line-height: 32rpx;
  text-align: center;
  margin-right: 14rpx;
  background: var(--green-ink);
  color: var(--card);
  font-size: 20rpx;
  font-weight: 700;
  border-radius: 50%;
}

.step-hl {
  color: var(--green-ink);
  font-weight: 700;
}

.search-button {
  margin: 28rpx 0 0;
}

.hits-card {
  padding: 24rpx 28rpx;
}

.search-hit {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.search-hit:last-child {
  border-bottom: 0;
  padding-bottom: 4rpx;
}

.hit-main {
  min-width: 0;
}

.hit-name {
  color: var(--ink);
  font-size: 28rpx;
  font-weight: 800;
  line-height: 1.3;
}

.hit-meta {
  margin-top: 4rpx;
  color: var(--muted-ink);
  font-size: 22rpx;
}

.hit-id {
  flex-shrink: 0;
  color: var(--green-ink);
  font-size: 22rpx;
  font-weight: 700;
}

.preview-title {
  color: var(--ink);
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1.3;
}

.preview-subtitle {
  margin-top: 8rpx;
  color: var(--muted-ink);
  font-size: 24rpx;
}

.preview-stats {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12rpx;
  margin-top: 22rpx;
}

.preview-stat {
  padding: 18rpx;
  background: var(--track);
  border-radius: 12rpx;
}

.stat-value {
  color: var(--ink);
  font-size: 30rpx;
  font-weight: 800;
}

.stat-label {
  margin-top: 4rpx;
  color: var(--muted-ink);
  font-size: 22rpx;
}

.current-entry-hint {
  margin-top: 22rpx;
  text-align: center;
  color: var(--green-ink);
  font-size: 24rpx;
  font-weight: 700;
}

.sync-hint {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 64rpx;
  box-sizing: border-box;
  text-align: center;
}
