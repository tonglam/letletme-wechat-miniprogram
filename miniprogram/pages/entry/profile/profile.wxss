.stats {
  margin-top: 24rpx;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.stat {
  display: flex;
  flex-direction: column;
}

.label {
  color: var(--muted-ink, #6e5a72);
  font-size: 24rpx;
}

.value {
  margin-top: 8rpx;
  font-size: 34rpx;
  font-weight: 700;
  color: var(--ink, #301333);
}
