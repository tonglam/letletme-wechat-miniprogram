<view class="page page-tabbar">
  <view id="perf-primary-content" wx:if="{{emptyState}}" class="section">
    <app-empty-state
      eyebrow="需要球队"
      title="先选择我的球队"
      description="查找球队并设为我的球队后即可查看；关联 LetLetMe 账户可自动同步网页已验证球队"
      actionText="去选择球队"
      featured="{{true}}"
      bind:action="onLinkAccount"
    />
  </view>
  <app-error-state id="perf-primary-content" wx:elif="{{error}}" message="{{error}}" workload="interactive" bind:retry="onRetry" />
  <app-loading wx:elif="{{loading}}" text="加载球队资料" />
  <block wx:else>
    <entry-card id="perf-primary-content" entry="{{entry}}" bind:change="onChangeEntry" />
    <view class="section">
      <view class="metric-grid">
        <view class="metric-card">
          <text class="metric-label">总分</text>
          <text class="metric-value">{{entry.totalPoints || '-'}}</text>
        </view>
        <view class="metric-card">
          <text class="metric-label">总排名</text>
          <text class="metric-value">{{entry.overallRank || '-'}}</text>
        </view>
      </view>
    </view>
  </block>
  <bottomNavBar />
</view>
