<view class="page page-tabbar">
  <data-status wx:if="{{staleNotice}}" status="stale" message="{{staleNotice}}" transient="{{true}}" />
  <view class="section">
    <view class="score-card scoreboard">
      <view class="score-top">
        <view class="score-identity">
          <view class="score-team">本轮总结</view>
          <view class="score-manager">总览 · 梦之队 · 高分 · 转会</view>
        </view>
        <gw-picker compact="{{true}}" dark="{{true}}" value="{{event}}" max="{{maxGw}}" bind:change="onGwChange" />
      </view>
    </view>
  </view>

  <app-error-state id="perf-primary-content" wx:if="{{error}}" message="{{error}}" bind:retry="onRetry" />
  <app-loading wx:elif="{{loading}}" text="加载 GW 总结" />

  <block wx:else>
    <view id="perf-primary-content" class="section tab-strip">
      <view class="tab-item {{showSummary ? 'tab-active' : ''}}" data-tab="summary" catchtap="onTabTap" hover-class="hover-dim">总览</view>
      <view class="tab-item {{showDreamTeam ? 'tab-active' : ''}}" data-tab="dreamTeam" catchtap="onTabTap" hover-class="hover-dim">梦之队</view>
      <view class="tab-item {{showElite ? 'tab-active' : ''}}" data-tab="elite" catchtap="onTabTap" hover-class="hover-dim">高分</view>
      <view class="tab-item {{showTransfers ? 'tab-active' : ''}}" data-tab="transfers" catchtap="onTabTap" hover-class="hover-dim">转会</view>
    </view>

    <view wx:if="{{showSummary}}" class="section">
      <app-error-state wx:if="{{summaryError}}" message="{{summaryError}}" bind:retry="onRetry" />
      <app-empty-state
        wx:elif="{{!hasSummary}}"
        title="GW{{event}} 总览还没生成"
        description="比赛周开始或官方数据同步后会显示整体得分与开卡情况"
        actionText="重新加载"
        bind:action="onRetry"
      />
      <block wx:else>
        <view wx:if="{{headlineStats.length}}" class="card headline-card">
          <view wx:for="{{headlineStats}}" wx:key="label" class="headline-stat">
            <view class="headline-label">{{item.label}}</view>
            <view class="headline-value">{{item.value}}</view>
            <view wx:if="{{item.meta}}" class="headline-meta">{{item.meta}}</view>
          </view>
        </view>
        <view wx:if="{{mostRows.length}}" class="card most-card">
          <view class="section-heading">本轮之最</view>
          <view wx:for="{{mostRows}}" wx:key="label" class="most-row">
            <text class="most-label">{{item.label}}</text>
            <view class="most-value">{{item.value}}<text wx:if="{{item.meta}}" class="most-meta">{{item.meta}}</text></view>
          </view>
        </view>
        <view wx:if="{{chipRows.length}}" class="card chip-card">
          <view class="section-heading">开卡情况</view>
          <view wx:for="{{chipRows}}" wx:key="id" class="chip-row">
            <text class="chip-title">{{item.title}}</text>
            <view class="chip-track"><view class="chip-fill" style="{{item.barStyle}}"></view></view>
            <text class="chip-value">{{item.value}}</text>
          </view>
        </view>
      </block>
    </view>

    <view wx:if="{{showDreamTeam}}" class="section">
      <app-error-state wx:if="{{dreamTeamError}}" message="{{dreamTeamError}}" bind:retry="onRetry" />
      <app-empty-state
        wx:elif="{{!hasDreamTeam}}"
        title="GW{{event}} 梦之队还没公布"
        description="本轮产生球员得分后会按位置生成"
        actionText="重新加载"
        bind:action="onRetry"
      />
      <view wx:else class="dream-pitch-section">
        <view class="live-pitch-bar">
          <text class="live-pitch-label">梦之队</text>
          <view
            class="tool-btn tool-btn-labeled {{shareBusy ? 'done' : ''}}"
            bindtap="onShareDreamPitch"
            hover-class="hover-dim"
          >
            <text class="tool-label">{{shareBusy ? '生成中' : '分享图片'}}</text>
          </view>
        </view>
        <squad-pitch
          id="dream-squad-pitch"
          players="{{pitchPlayers}}"
          benchPlayers="{{pitchBench}}"
          header="{{pitchHeader}}"
          benchBoost="{{false}}"
          bind:playertap="onDreamPlayerTap"
        />
      </view>
    </view>

    <view wx:if="{{showElite}}" class="section card">
      <app-error-state wx:if="{{eliteError}}" message="{{eliteError}}" bind:retry="onRetry" />
      <app-empty-state
        wx:elif="{{!hasElite}}"
        title="还没有达到 10 分的球员"
        description="GW{{event}} 出现高分表现后会显示在这里"
      />
      <block wx:else>
        <view
          wx:for="{{eliteRows}}"
          wx:key="id"
          class="elite-row"
          data-id="{{item.id}}"
          bindtap="onElitePlayerTap"
          hover-class="hover-dim"
        >
          <view class="elite-rank {{index < 3 ? 'elite-rank-top' : ''}}">{{index + 1}}</view>
          <view class="row-main">
            <view class="row-title">{{item.title}}</view>
            <view wx:if="{{item.description}}" class="row-meta">{{item.description}}</view>
          </view>
          <text class="elite-points">{{item.value}}</text>
        </view>
      </block>
    </view>

    <view wx:if="{{showTransfers}}" class="section transfer-grid">
      <app-error-state wx:if="{{transfersError}}" message="{{transfersError}}" bind:retry="onRetry" />
      <block wx:else>
      <view class="card flow-card">
        <view class="flow-head flow-head-in">
          <text class="flow-arrow flow-arrow-in">↓</text>
          <text class="flow-title flow-title-in">转入最多</text>
        </view>
        <view class="flow-body">
          <app-empty-state wx:if="{{transfersInRows.length === 0}}" title="还没有转入趋势" description="本轮产生转会后会显示热门转入" />
          <block wx:else>
            <view wx:for="{{transfersInRows}}" wx:key="id" class="summary-row">
              <view class="row-main">
                <view class="row-title">{{item.title}}<text wx:if="{{item.meta}}" class="row-title-meta">{{item.meta}}</text></view>
              </view>
              <text class="row-value row-value-good">{{item.value}}</text>
            </view>
          </block>
        </view>
      </view>
      <view class="card flow-card">
        <view class="flow-head flow-head-out">
          <text class="flow-arrow flow-arrow-out">↑</text>
          <text class="flow-title flow-title-out">转出最多</text>
        </view>
        <view class="flow-body">
          <app-empty-state wx:if="{{transfersOutRows.length === 0}}" title="还没有转出趋势" description="本轮产生转会后会显示热门转出" />
          <block wx:else>
            <view wx:for="{{transfersOutRows}}" wx:key="id" class="summary-row">
              <view class="row-main">
                <view class="row-title">{{item.title}}<text wx:if="{{item.meta}}" class="row-title-meta">{{item.meta}}</text></view>
              </view>
              <text class="row-value row-value-bad">{{item.value}}</text>
            </view>
          </block>
        </view>
      </view>
      </block>
    </view>

    <view class="section">
      <evidence-source evidenceClass="OFFICIAL_FPL" freshness="本轮统计" />
    </view>
  </block>

  <player-live-sheet wx:if="{{!error && !loading}}" show="{{playerDetailOpen}}" detail="{{playerDetail}}" bind:close="onCloseDreamPlayer" />
  <bottomNavBar active="explore" />
</view>
