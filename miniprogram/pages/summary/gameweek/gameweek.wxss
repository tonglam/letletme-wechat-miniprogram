.summary-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

/* Tab strip — web Tabs pattern */
.tab-strip {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 8rpx;
  padding: 8rpx;
  border-radius: 12rpx;
  background: var(--track);
}

.tab-item {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 58rpx;
  border-radius: 8rpx;
  color: var(--muted-ink);
  font-size: 24rpx;
  font-weight: 700;
}

.tab-active {
  background: var(--card);
  color: var(--ink);
  box-shadow: 0 2rpx 6rpx var(--plum-a8);
}

.metric-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12rpx;
}

.metric-card {
  min-width: 0;
  padding: 18rpx;
  border-radius: 12rpx;
  background: var(--track);
}

.metric-label,
.row-meta,
.list-empty {
  color: var(--muted-ink);
  font-size: 22rpx;
}

.metric-value {
  display: block;
  margin-top: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: var(--ink);
  font-size: 30rpx;
  font-weight: 800;
}

.metric-meta {
  display: block;
  margin-top: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: var(--muted-ink);
  font-size: 20rpx;
}

.subsection {
  margin-top: 26rpx;
}

.summary-card {
  margin-bottom: 18rpx;
}

.section-title-small {
  margin-bottom: 14rpx;
  color: var(--ink);
  font-size: 28rpx;
  font-weight: 800;
}

.summary-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  min-height: 72rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.summary-row:last-child {
  border-bottom: 0;
}

.row-main {
  min-width: 0;
  flex: 1;
}

.row-title {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: var(--ink);
  font-size: 24rpx;
  font-weight: 700;
}

.row-value {
  flex-shrink: 0;
  color: var(--ink);
  font-size: 24rpx;
  font-weight: 800;
}

.row-value-good {
  color: var(--green-ink);
}

.row-value-bad {
  color: var(--danger);
}

.list-empty {
  padding: 22rpx 0;
  text-align: center;
}

.transfer-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 18rpx;
}

.transfer-card {
  min-width: 0;
}
.last-good-notice {
  margin: 16rpx 24rpx 0;
  padding: 14rpx 18rpx;
  border: 1rpx solid var(--warning);
  border-radius: 12rpx;
  background: var(--warning-tint);
  color: var(--warning);
  font-size: 24rpx;
}
