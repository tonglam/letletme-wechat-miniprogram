.summary-page {
  padding-bottom: 132rpx;
}

.summary-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

/* Tab strip — web Tabs pattern */
.tab-strip {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 8rpx;
  padding: 8rpx;
  border-radius: 12rpx;
  background: var(--track, #f1efe9);
}

.tab-item {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 58rpx;
  border-radius: 8rpx;
  color: var(--muted-ink, #6e5a72);
  font-size: 24rpx;
  font-weight: 700;
}

.tab-active {
  background: var(--card, #ffffff);
  color: var(--ink, #301333);
  box-shadow: 0 2rpx 6rpx rgba(56, 0, 60, 0.08);
}

.metric-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12rpx;
}

.metric-card {
  min-width: 0;
  padding: 18rpx;
  border-radius: 12rpx;
  background: var(--track, #f1efe9);
}

.metric-label,
.row-meta,
.list-empty {
  color: var(--muted-ink, #6e5a72);
  font-size: 22rpx;
}

.metric-value {
  display: block;
  margin-top: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: var(--ink, #301333);
  font-size: 30rpx;
  font-weight: 800;
}

.metric-meta {
  display: block;
  margin-top: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: var(--muted-ink, #6e5a72);
  font-size: 21rpx;
}

.subsection {
  margin-top: 26rpx;
}

.summary-card {
  margin-bottom: 18rpx;
}

.section-title-small {
  margin-bottom: 14rpx;
  color: var(--ink, #301333);
  font-size: 28rpx;
  font-weight: 800;
}

.summary-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  min-height: 72rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--line, #ddd4de);
}

.summary-row:last-child {
  border-bottom: 0;
}

.row-main {
  min-width: 0;
  flex: 1;
}

.row-title {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: var(--ink, #301333);
  font-size: 25rpx;
  font-weight: 700;
}

.row-value {
  flex-shrink: 0;
  color: var(--ink, #301333);
  font-size: 25rpx;
  font-weight: 800;
}

.row-value-good {
  color: var(--green-ink, #008545);
}

.row-value-bad {
  color: var(--danger, #c9183f);
}

.list-empty {
  padding: 22rpx 0;
  text-align: center;
}

.transfer-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 18rpx;
}

.transfer-card {
  min-width: 0;
}
