.control-card {
  padding-bottom: 18rpx;
}

.empty-state-section {
  margin-top: 8rpx;
}

.field-label {
  margin-bottom: 12rpx;
  color: var(--ink);
  font-size: 24rpx;
  font-weight: 700;
}

.picker-value {
  min-height: 72rpx;
  padding: 18rpx 20rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  border: 0;
  border-radius: 14rpx;
  background: var(--track);
  box-sizing: border-box;
  color: var(--ink);
  font-size: 26rpx;
  font-weight: 700;
}

.summary-card,
.ranking-card {
  margin-bottom: 18rpx;
}


.metric-meta {
  display: block;
  margin-top: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: var(--muted-ink);
  font-size: 22rpx;
}

.ranking-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-height: 94rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.ranking-row:last-child {
  border-bottom: 0;
}

/* Own row — pitch-green highlight */
.ranking-row-active {
  margin: 0 -12rpx;
  padding-right: 12rpx;
  padding-left: 12rpx;
  border-radius: 12rpx;
  background: var(--accent-tint);
}

.rank-badge {
  width: 76rpx;
  flex-shrink: 0;
  color: var(--ink);
  font-size: 24rpx;
  font-weight: 900;
}

.ranking-main {
  min-width: 0;
  flex: 1;
}

.ranking-title,
.ranking-subtitle,
.ranking-meta {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.ranking-title {
  color: var(--ink);
  font-size: 24rpx;
  font-weight: 800;
}

.ranking-subtitle,
.ranking-meta {
  margin-top: 4rpx;
  color: var(--muted-ink);
  font-size: 22rpx;
}

.ranking-score {
  min-width: 96rpx;
  flex-shrink: 0;
  text-align: right;
}

.score-main {
  color: var(--ink);
  font-size: 30rpx;
  font-weight: 900;
}

.points-sub {
  margin-top: 4rpx;
  color: var(--muted-ink);
  font-size: 20rpx;
}
