<view class="page page-tabbar">
  <view class="section">
    <view class="score-card scoreboard">
      <view class="score-top">
        <view class="score-identity">
          <view class="score-team">{{selectedTournamentName || '赛事回顾'}}</view>
          <view class="score-manager">{{headerSubtitle || '排名 · 净分 · 赛季表现'}}</view>
        </view>
        <gw-picker wx:if="{{tournaments.length}}" compact="{{true}}" dark="{{true}}" value="{{event}}" max="{{maxGw}}" bind:change="onEventChange" />
      </view>
    </view>
  </view>

  <view wx:if="{{tournaments.length}}" class="section card control-card">
    <view class="field-label">赛事</view>
    <picker mode="selector" range="{{tournamentNames}}" value="{{selectedTournamentIndex}}" bindchange="onTournamentChange">
      <view class="picker-value">{{selectedTournamentName || '请选择赛事'}}</view>
    </picker>
  </view>

  <app-error-state id="perf-primary-content" wx:if="{{error}}" message="{{error}}" workload="interactive" bind:retry="onRetry" />
  <app-loading wx:elif="{{loading}}" text="加载赛事回顾" />
  <view id="perf-primary-content" wx:elif="{{emptyState}}" class="section empty-state-section">
    <app-empty-state
      eyebrow="{{emptyEyebrow}}"
      title="{{emptyTitle}}"
      description="{{emptyDescription}}"
      actionText="{{emptyActionText}}"
      featured="{{true}}"
      bind:action="onEmptyAction"
    />
  </view>

  <block wx:else>
    <view class="section tab-strip">
      <view class="tab-item {{showOverview ? 'tab-active' : ''}}" data-tab="overview" catchtap="onTabTap" hover-class="hover-dim">总览</view>
      <view class="tab-item {{showRankings ? 'tab-active' : ''}}" data-tab="rankings" catchtap="onTabTap" hover-class="hover-dim">排名</view>
      <view class="tab-item {{showMetrics ? 'tab-active' : ''}}" data-tab="metrics" catchtap="onTabTap" hover-class="hover-dim">指标</view>
    </view>

    <view id="perf-primary-content" wx:if="{{showOverview}}" class="section">
      <app-empty-state
        wx:if="{{!hasOverview}}"
        title="GW{{event}} 总结还没准备好"
        description="比赛数据同步后会自动出现在这里"
        actionText="重新加载"
        bind:action="onRetry"
      />
      <block wx:else>
        <view wx:if="{{overviewStats.length}}" class="card summary-card">
          <view class="section-heading">我的表现</view>
          <view class="metric-grid">
            <view wx:for="{{overviewStats}}" wx:key="label" class="metric-card">
              <text class="metric-label">{{item.label}}</text>
              <text class="metric-value">{{item.value}}</text>
            </view>
          </view>
        </view>
        <view wx:if="{{tournamentStats.length}}" class="card summary-card">
          <view class="section-heading">赛事信息</view>
          <view class="metric-grid">
            <view wx:for="{{tournamentStats}}" wx:key="label" class="metric-card">
              <text class="metric-label">{{item.label}}</text>
              <text class="metric-value">{{item.value}}</text>
            </view>
          </view>
        </view>
      </block>
    </view>

    <view id="perf-primary-content" wx:if="{{showRankings}}" class="section">
      <app-empty-state
        wx:if="{{!hasRankings}}"
        title="本轮排名还没生成"
        description="赛事完成本轮数据同步后即可查看"
        actionText="重新加载"
        bind:action="onRetry"
      />
      <view wx:else class="card ranking-card">
        <view class="section-heading">本轮排名</view>
        <view wx:for="{{rankingRows}}" wx:key="id" class="ranking-row {{item.isMine ? 'ranking-row-active' : ''}}">
          <view class="rank-badge">#{{item.rank}}</view>
          <view class="ranking-main">
            <view class="ranking-title">{{item.entryName}}</view>
            <view class="ranking-subtitle">{{item.playerName}}</view>
            <view class="ranking-meta">OR {{item.overallRank}} · {{item.chip}}</view>
          </view>
          <view class="ranking-score">
            <view class="score-main">{{item.points}}</view>
            <view class="points-sub">净 {{item.netPoints}}</view>
          </view>
        </view>
        <view wx:if="{{hasMoreRankings}}" class="load-more" bindtap="loadMoreRankings" hover-class="hover-dim">
          <text class="action">加载更多</text>
        </view>
      </view>
    </view>

    <view id="perf-primary-content" wx:if="{{showMetrics}}" class="section">
      <app-empty-state
        wx:if="{{!hasMetrics}}"
        title="累计指标还没生成"
        description="产生比赛数据后，这里会展示身价、转会和板凳排名"
        actionText="重新加载"
        bind:action="onRetry"
      />
      <view wx:else class="card summary-card">
        <view class="section-heading">累计指标</view>
        <view class="metric-grid">
          <view wx:for="{{entryMetricStats}}" wx:key="label" class="metric-card">
            <text class="metric-label">{{item.label}}</text>
            <text class="metric-value">{{item.value}}</text>
            <text wx:if="{{item.meta}}" class="metric-meta">{{item.meta}}</text>
          </view>
        </view>
      </view>
    </view>
  </block>

  <bottomNavBar active="" />
</view>
