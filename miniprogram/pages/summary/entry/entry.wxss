.summary-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.header-text {
  min-width: 0;
  flex: 1;
}

.header-actions {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-shrink: 0;
}

.header-action {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  min-height: 64rpx;
  padding: 0 22rpx;
  border: 1rpx solid var(--line, #ddd4de);
  border-radius: 10rpx;
  background: var(--card, #ffffff);
  color: var(--ink, #301333);
  font-size: 24rpx;
  font-weight: 700;
}

.summary-card {
  margin-bottom: 18rpx;
}

/* Tab strip — web Tabs pattern */
.tab-strip {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 8rpx;
  padding: 8rpx;
  border-radius: 12rpx;
  background: var(--track, #f1efe9);
}

.tab-item {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 58rpx;
  border-radius: 8rpx;
  color: var(--muted-ink, #6e5a72);
  font-size: 24rpx;
  font-weight: 700;
}

.tab-active {
  background: var(--card, #ffffff);
  color: var(--ink, #301333);
  box-shadow: 0 2rpx 6rpx rgba(56, 0, 60, 0.08);
}

.metric-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
}

.metric-grid-three {
  grid-template-columns: repeat(3, minmax(0, 1fr));
}

.metric-card {
  min-width: 0;
  padding: 18rpx;
  border-radius: 12rpx;
  background: var(--track, #f1efe9);
}

.metric-label,
.row-meta {
  color: var(--muted-ink, #6e5a72);
  font-size: 22rpx;
}

.metric-value {
  display: block;
  margin-top: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: var(--ink, #301333);
  font-size: 30rpx;
  font-weight: 800;
}

.metric-value-bad,
.cost-bad {
  color: var(--danger, #c9183f);
}

.section-title-small {
  margin-bottom: 14rpx;
  color: var(--ink, #301333);
  font-size: 28rpx;
  font-weight: 800;
}

.summary-row,
.squad-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  min-height: 72rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--line, #ddd4de);
}

.summary-row:last-child,
.squad-row:last-child {
  border-bottom: 0;
}

.squad-row-bench {
  opacity: 0.72;
}

.row-main {
  min-width: 0;
  flex: 1;
}

.row-title,
.history-title {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: var(--ink, #301333);
  font-size: 25rpx;
  font-weight: 700;
}

.row-value {
  flex-shrink: 0;
  color: var(--ink, #301333);
  font-size: 25rpx;
  font-weight: 800;
}

.squad-meta {
  display: grid;
  grid-template-columns: 72rpx 58rpx 58rpx 72rpx;
  align-items: center;
  gap: 8rpx;
  flex-shrink: 0;
  text-align: center;
}

/* Layout-only badge shells; colours come from global position and role classes. */
.position-badge,
.role-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 36rpx;
  border-radius: 6rpx;
  font-size: 20rpx;
  font-weight: 800;
}

.role-starter {
  background: var(--accent-tint, #dcf6ea);
  color: var(--green-ink, #008545);
}

.role-bench {
  background: var(--track, #f1efe9);
  color: var(--muted-ink, #6e5a72);
}

.mini-stat,
.points-stat {
  color: var(--ink, #301333);
  font-size: 22rpx;
  font-weight: 700;
}

.points-stat {
  font-weight: 900;
}

.transfer-card {
  margin-bottom: 16rpx;
}

.transfer-head {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 10rpx;
  align-items: center;
  padding-bottom: 14rpx;
  border-bottom: 1rpx solid var(--line, #ddd4de);
  color: var(--ink, #301333);
  font-size: 24rpx;
  font-weight: 800;
}

.transfer-count,
.transfer-cost {
  text-align: right;
}

.empty-line {
  padding: 18rpx 0 4rpx;
  color: var(--muted-ink, #6e5a72);
  font-size: 24rpx;
}

.move-card {
  margin-top: 14rpx;
  padding: 16rpx;
  border: 1rpx solid var(--line, #ddd4de);
  border-radius: 12rpx;
  background: var(--card, #ffffff);
}

.move-text {
  color: var(--ink, #301333);
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.45;
}

.history-card {
  padding: 18rpx 0;
  border-bottom: 1rpx solid var(--line, #ddd4de);
}

.history-card:last-child {
  border-bottom: 0;
}

.history-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 10rpx;
  margin-top: 12rpx;
  color: var(--muted-ink, #6e5a72);
  font-size: 22rpx;
  line-height: 1.4;
}
