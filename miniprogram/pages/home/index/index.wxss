.home-header {
  padding: 8rpx 2rpx 4rpx;
  text-align: center;
}

/* Notice — soft pitch-green strip */
.notice-strip {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  padding: 18rpx 20rpx;
  background: var(--accent-tint);
  border: 1rpx solid var(--green-ink-a25);
  border-radius: 12rpx;
}

.notice-icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 30rpx;
  height: 30rpx;
  border-radius: 50%;
  background: var(--green-ink);
  color: var(--card);
  font-size: 20rpx;
  font-weight: 700;
}

.notice-text {
  flex: 1;
  color: var(--green-ink);
  font-size: 24rpx;
  line-height: 1.45;
}

.notice-close {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  min-width: 64rpx;
  min-height: 64rpx;
  margin: -16rpx -16rpx -16rpx 0;
  color: var(--green-ink);
  font-size: 30rpx;
  line-height: 30rpx;
  opacity: 0.75;
}

/* Deadline — scoreboard panel (dark fascia, electric edge via .scoreboard) */
.deadline-card {
  padding: 28rpx;
}

.deadline-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.deadline-label {
  font-size: 26rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  text-transform: uppercase;
}

.deadline-time {
  margin-top: 8rpx;
  color: var(--chalk-a60);
  font-size: 24rpx;
}

.countdown {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12rpx;
  margin-top: 28rpx;
}

.countdown-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 104rpx;
  background: var(--black-a25);
  border: 1rpx solid var(--white-a10);
  border-radius: 12rpx;
}

.countdown-value {
  color: var(--electric);
  font-size: 34rpx;
  font-weight: 800;
}

.countdown-label {
  margin-top: 4rpx;
  color: var(--chalk-a60);
  font-size: 20rpx;
}

.deadline-empty {
  margin-top: 24rpx;
  padding: 24rpx 0;
  border: 1rpx solid var(--white-a10);
  border-radius: 12rpx;
  background: var(--black-a25);
  color: var(--chalk-a60);
  font-size: 24rpx;
  text-align: center;
}

/* Section headers */
.section-title {
  color: var(--ink);
  font-size: 30rpx;
  font-weight: 700;
}

.section-subtitle {
  margin-top: 8rpx;
  color: var(--muted-ink);
  font-size: 24rpx;
}

.section-link {
  flex-shrink: 0;
  padding: 8rpx 14rpx;
  color: var(--green-ink);
  font-size: 24rpx;
  font-weight: 700;
}

.account-link-hint {
  margin-top: 12rpx;
  text-align: center;
}

.section-status {
  margin: 12rpx 0;
  color: var(--muted-ink);
  font-size: 22rpx;
}

/* Error variant — same shape as global .live-refresh-error */
.section-status-error {
  padding: 18rpx 22rpx;
  border: 1rpx solid var(--danger-a30);
  border-radius: 12rpx;
  background: var(--danger-tint);
  color: var(--danger);
  line-height: 1.45;
}

/* Price changes */
.price-card {
  padding-bottom: 20rpx;
}

.price-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 18rpx;
}

.price-groups {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
}

.price-group {
  min-width: 0;
  padding: 14rpx;
  border: 1rpx solid var(--line);
  border-radius: 12rpx;
  background: var(--track);
}

.price-rise {
  border-color: var(--green-ink-a30);
  background: var(--accent-tint);
}

.price-fall {
  border-color: var(--danger-a30);
  background: var(--danger-tint);
}

.price-group-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 10rpx;
  color: var(--ink);
  font-size: 24rpx;
  font-weight: 800;
}

.price-count {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 32rpx;
  height: 32rpx;
  padding: 0 8rpx;
  border-radius: 16rpx;
  background: var(--plum-a8);
  color: var(--muted-ink);
  font-size: 20rpx;
  box-sizing: border-box;
}

.price-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10rpx;
  padding: 12rpx 0;
  border-top: 1rpx solid var(--plum-a8);
}

.price-row-first {
  border-top: 0;
}

.price-empty {
  padding: 28rpx 0 18rpx;
  color: var(--muted-ink);
  font-size: 22rpx;
  text-align: center;
}

.price-player {
  min-width: 0;
  flex: 1;
}

.price-name-line {
  display: flex;
  align-items: center;
  gap: 6rpx;
  min-width: 0;
}

.price-name {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: var(--ink);
  font-size: 22rpx;
  font-weight: 700;
}

.price-team {
  display: block;
  margin-top: 4rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: var(--muted-ink);
  font-size: 20rpx;
}

.price-values {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.price-current {
  font-size: 22rpx;
  font-weight: 800;
}

.price-change {
  margin-top: 3rpx;
  font-size: 18rpx;
  font-weight: 700;
}

.price-up {
  color: var(--green-ink);
}

.price-down {
  color: var(--danger);
}

/* GW stats grid */
.gw-stats-head {
  margin-bottom: 18rpx;
}

.gw-stats-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12rpx;
}

.gw-stat-item {
  min-width: 0;
  padding: 18rpx;
  border-radius: 12rpx;
  background: var(--track);
}

.gw-stat-label {
  display: block;
  color: var(--muted-ink);
  font-size: 22rpx;
  line-height: 1.25;
}

.gw-stat-value {
  display: block;
  margin-top: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: var(--ink);
  font-size: 28rpx;
  font-weight: 800;
  line-height: 1.25;
}

/* Fixtures */
.fixture-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 16rpx;
}

.fixture-stepper {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 2rpx;
  flex-shrink: 0;
  width: auto;
}

.fixture-arrow {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 64rpx;
  min-height: 64rpx;
  padding: 0;
  margin: 0;
  border: 0;
  border-radius: 0;
  background: transparent;
  color: var(--ink);
  font-size: 28rpx;
  line-height: 40rpx;
  font-weight: 700;
}

.fixture-arrow::after {
  border: 0;
}

.fixture-arrow-disabled {
  color: var(--line);
}

.fixture-row {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 116rpx minmax(0, 1fr);
  align-items: center;
  gap: 12rpx;
  padding: 18rpx 0;
  border-top: 1rpx solid var(--line);
  font-size: 26rpx;
}

.fixture-team {
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.team-name {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: var(--ink);
  font-weight: 700;
}

.away-team {
  align-items: flex-end;
  text-align: right;
}

.fixture-center {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 70rpx;
  padding: 8rpx;
  border-radius: 10rpx;
  background: var(--track);
  box-sizing: border-box;
}

.fixture-vs {
  color: var(--ink);
  font-size: 22rpx;
  font-weight: 800;
  line-height: 1.1;
}

.fixture-time {
  margin-top: 6rpx;
  color: var(--muted-ink);
  font-size: 20rpx;
  line-height: 1.1;
  white-space: nowrap;
}

/* FDR badges — global .fdr scale (app.wxss), aligned per side */
.fixture-team .fdr {
  align-self: flex-start;
}

.away-team .fdr {
  align-self: flex-end;
}
