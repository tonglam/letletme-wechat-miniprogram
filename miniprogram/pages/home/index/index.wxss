.notice-strip {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  background: var(--accent-tint);
}

.notice-icon {
  display: inline-flex;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  width: 30rpx;
  height: 30rpx;
  border-radius: 50%;
  background: var(--green-ink);
  color: var(--chalk);
  font-size: 20rpx;
  font-weight: 700;
}

.notice-text {
  flex: 1;
  min-width: 0;
  color: var(--green-ink);
  font-size: 24rpx;
  line-height: 1.45;
  word-break: break-word;
}

.notice-close {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  width: 32rpx;
  height: 32rpx;
  color: var(--green-ink);
  font-size: 30rpx;
  line-height: 1;
  opacity: 0.7;
}

/* Deadline — scoreboard panel (dark fascia, electric edge via .scoreboard) */
.deadline-card {
  padding: 28rpx;
}

.deadline-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.deadline-label {
  font-size: 26rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  text-transform: uppercase;
}

.deadline-time {
  margin-top: 8rpx;
  color: var(--chalk-a60);
  font-size: 24rpx;
}

.deadline-side {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 12rpx;
  flex-shrink: 0;
}

/* Countdown share — dark-card companion to the light-card .tool-btn */
.deadline-share {
  display: inline-flex;
  align-items: center;
  padding: 10rpx 20rpx;
  border: 1rpx solid var(--electric-a28);
  border-radius: 12rpx;
  background: var(--black-a25);
}

.deadline-share-label {
  color: var(--electric);
  font-size: 22rpx;
  font-weight: 700;
}

.deadline-share.done .deadline-share-label {
  color: var(--chalk-a60);
}

.countdown {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12rpx;
  margin-top: 28rpx;
}

.deadline-live {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  margin-top: 28rpx;
  min-height: 104rpx;
  border: 1rpx solid var(--danger-a30);
  border-radius: 12rpx;
  background: var(--danger-tint);
}

.deadline-live-tag {
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  background: var(--danger);
  color: var(--chalk);
  font-size: 20rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
}

.deadline-live-text {
  color: var(--danger);
  font-size: 24rpx;
  font-weight: 700;
}

.countdown-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 104rpx;
  background: var(--black-a25);
  border: 1rpx solid var(--white-a10);
  border-radius: 12rpx;
}

.countdown-value {
  color: var(--electric);
  font-size: 34rpx;
  font-weight: 800;
}

.countdown-label {
  margin-top: 4rpx;
  color: var(--chalk-a60);
  font-size: 20rpx;
}

.deadline-empty {
  margin-top: 24rpx;
  padding: 24rpx 0;
  border: 1rpx solid var(--white-a10);
  border-radius: 12rpx;
  background: var(--black-a25);
  color: var(--chalk-a60);
  font-size: 24rpx;
  text-align: center;
}

/* Section headers */
.section-subtitle {
  margin-top: 8rpx;
  color: var(--muted-ink);
  font-size: 24rpx;
}

.section-link {
  flex-shrink: 0;
  padding: 8rpx 14rpx;
}

.account-link-hint {
  margin-top: 12rpx;
  text-align: center;
}

.bind-strip {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 22rpx 24rpx;
  border-radius: 12rpx;
  background: var(--track);
  box-sizing: border-box;
}

.bind-strip-account {
  margin-top: 12rpx;
  background: var(--accent-tint);
}

.bind-kicker {
  color: var(--muted-ink);
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.bind-strip-account .bind-kicker {
  color: var(--green-ink);
}

.bind-title {
  margin-top: 4rpx;
  color: var(--ink);
  font-size: 28rpx;
  font-weight: 800;
}

.bind-action {
  flex-shrink: 0;
}

.section-status {
  margin: 12rpx 0;
  color: var(--muted-ink);
  font-size: 22rpx;
}

/* Error variant — same shape as global .live-refresh-error */
.section-status-error {
  padding: 18rpx 22rpx;
  border: 1rpx solid var(--danger-a30);
  border-radius: 12rpx;
  background: var(--danger-tint);
  color: var(--danger);
  line-height: 1.45;
}

/* Transfer desk — web MarketTeaser */
.transfer-desk {
  padding-bottom: 20rpx;
}

.transfer-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 18rpx;
}

.transfer-head .section-title {
  margin-bottom: 6rpx;
}

.market-tabs {
  margin-bottom: 20rpx;
}

.transfer-subhead {
  margin: 8rpx 0 12rpx;
  color: var(--ink);
  font-size: 24rpx;
  font-weight: 800;
}

.transfer-note {
  margin: -4rpx 0 12rpx;
  color: var(--muted-ink);
  font-size: 22rpx;
}

.transfer-more {
  margin-top: 20rpx;
  text-align: center;
}

/* Dream team — same squad-pitch rendering as the gameweek summary page */
.dream-pitch-section {
  width: 100%;
  max-width: 100%;
  box-sizing: border-box;
}

.dream-pitch-section squad-pitch {
  display: block;
  width: 100%;
  max-width: 100%;
}

.live-pitch-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.live-pitch-actions {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.live-pitch-label {
  color: var(--muted-ink);
  font-size: 20rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
}

.transfer-empty,
.transfer-empty-inline {
  padding: 28rpx 16rpx;
  border: 1rpx dashed var(--line);
  border-radius: 12rpx;
  color: var(--muted-ink);
  font-size: 22rpx;
  text-align: center;
}

.transfer-empty-retry {
  margin-left: 12rpx;
}

.transfer-empty-inline {
  padding: 20rpx 12rpx;
}

.transfer-split {
  display: grid;
  grid-template-columns: 1fr;
  gap: 24rpx;
}

.transfer-col-head {
  margin-bottom: 12rpx;
  color: var(--muted-ink);
  font-size: 22rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
}

.transfer-col-head.transfer-up {
  color: var(--green-ink);
}

.transfer-col-head.transfer-down {
  color: var(--danger);
}

.transfer-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  min-height: 88rpx;
  padding: 14rpx 16rpx;
  border: 0;
  border-radius: 12rpx;
  background: var(--track);
  margin-bottom: 10rpx;
  box-sizing: border-box;
}

.transfer-player {
  min-width: 0;
  flex: 1;
}

.transfer-name-line {
  display: flex;
  align-items: center;
  gap: 8rpx;
  min-width: 0;
}

.transfer-name {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: var(--ink);
  font-size: 26rpx;
  font-weight: 700;
}

.transfer-meta {
  display: block;
  margin-top: 4rpx;
  color: var(--muted-ink);
  font-size: 20rpx;
}

.transfer-delta {
  flex-shrink: 0;
  font-size: 26rpx;
  font-weight: 800;
  font-variant-numeric: tabular-nums;
}

.transfer-up {
  color: var(--green-ink);
}

.transfer-down {
  color: var(--danger);
}

.transfer-watch {
  margin-top: 28rpx;
}

.watch-row {
  padding: 16rpx;
  border: 0;
  border-radius: 12rpx;
  background: var(--track);
  margin-bottom: 10rpx;
}

.watch-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.watch-status {
  flex-shrink: 0;
  padding: 4rpx 10rpx;
  border-radius: 8rpx;
  background: var(--track);
  color: var(--muted-ink);
  font-size: 18rpx;
  font-weight: 700;
}

.watch-injured,
.watch-unavailable,
.watch-suspended {
  background: var(--danger-tint);
  color: var(--danger);
}

.watch-doubtful {
  background: var(--warning-tint);
  color: var(--warning);
}

.watch-available {
  background: var(--accent-tint);
  color: var(--green-ink);
}

.watch-body {
  margin-top: 8rpx;
  color: var(--muted-ink);
  font-size: 22rpx;
  line-height: 1.4;
}

/* GW stats — dark broadcast band, same language as the team desk metric strip */
.gw-stats-head {
  margin-bottom: 18rpx;
}

.gw-stats-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  overflow: hidden;
  border-radius: 14rpx;
  background:
    radial-gradient(ellipse 120% 90% at 50% -30%, var(--plum-a70), rgba(56, 0, 60, 0) 60%),
    linear-gradient(180deg, var(--fascia-hi), var(--fascia));
}

.gw-stat-item {
  min-width: 0;
  padding: 20rpx 24rpx;
  box-sizing: border-box;
}

.gw-stat-tappable {
  position: relative;
}

.gw-stat-tappable::after {
  content: "›";
  position: absolute;
  top: 14rpx;
  right: 20rpx;
  color: var(--chalk-a60);
  font-size: 26rpx;
}

/* Odd counts: last tile spans the full row so the band stays balanced */
.gw-stat-item:last-of-type:nth-child(odd) {
  grid-column: 1 / -1;
}

.gw-stat-label {
  display: block;
  color: var(--chalk-a60);
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  line-height: 1.25;
}

.gw-stat-value {
  display: block;
  margin-top: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: var(--electric);
  font-size: 30rpx;
  font-weight: 800;
  font-variant-numeric: tabular-nums;
  line-height: 1.25;
}

/* Fixtures */
.fixture-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.fixture-head-copy {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 12rpx;
  min-width: 0;
}

.fixture-head-copy .section-title {
  margin-bottom: 0;
}

.fixture-head-tools {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  gap: 8rpx;
}

.fixture-live-link {
  color: var(--green-ink);
  font-size: 22rpx;
  font-weight: 700;
}

.fixture-stepper {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 2rpx;
  flex-shrink: 0;
}

.fixture-arrow {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 64rpx;
  min-height: 64rpx;
  padding: 0;
  margin: 0;
  border: 0;
  border-radius: 0;
  background: transparent;
  color: var(--ink);
  font-size: 28rpx;
  line-height: 40rpx;
  font-weight: 700;
}

.fixture-arrow::after {
  border: 0;
}

.fixture-arrow-disabled {
  color: var(--line);
}

.fixture-days {
  margin-bottom: 8rpx;
}

.fixture-row {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 140rpx minmax(0, 1fr);
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 0;
  border-top: 1rpx solid var(--line);
}

.fixture-row:first-of-type {
  border-top: 0;
}

.fixture-team {
  min-width: 0;
  overflow: hidden;
  color: var(--ink);
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.25;
}

.home-team {
  text-align: right;
}

.away-team {
  text-align: left;
}

.fixture-board {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 64rpx;
  padding: 8rpx 12rpx;
  border: 1rpx solid var(--electric-a28);
  border-radius: 10rpx;
  background: var(--plum);
  color: var(--electric);
  font-size: 24rpx;
  font-weight: 800;
  box-sizing: border-box;
}

.fixture-board.is-live {
  border-color: var(--danger-a30);
  color: var(--danger);
}

.fixture-live-pill {
  display: inline-flex;
  align-items: center;
  padding: 8rpx 16rpx;
  border: 1rpx solid var(--danger-a30);
  border-radius: 8rpx;
  background: var(--danger-tint);
  color: var(--danger);
  font-size: 22rpx;
  font-weight: 700;
}

.fixture-tz {
  margin-top: 12rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--line);
  color: var(--muted-ink);
  font-size: 20rpx;
  text-align: center;
}
