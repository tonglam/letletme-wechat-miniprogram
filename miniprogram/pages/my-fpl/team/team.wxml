<wxs module="pos">
  var map = {
    GKP: 'pos-gkp', GK: 'pos-gkp', GOALKEEPER: 'pos-gkp',
    DEF: 'pos-def', DEFENDER: 'pos-def',
    MID: 'pos-mid', MIDFIELDER: 'pos-mid',
    FWD: 'pos-fwd', FORWARD: 'pos-fwd'
  };
  function cls(p) {
    if (!p) return '';
    var key = String(p).toUpperCase();
    return map[key] || '';
  }
  module.exports = { cls: cls };
</wxs>
<view class="page">
  <view class="section summary-header">
    <view class="header-text">
      <view class="title">{{headerTitle}}</view>
      <view class="subtitle">{{headerSubtitle || '球队数据'}}</view>
    </view>
    <view class="header-actions">
      <gw-picker wx:if="{{emptyState !== 'entry'}}" value="{{event}}" max="{{maxGw}}" bind:change="onGwChange" />
    </view>
  </view>

  <view wx:if="{{phaseBanner === 'live'}}" class="section phase-banner" bindtap="onOpenLiveEntry">
    <text class="phase-banner-text">本轮比赛进行中，详细实时得分请前往实时球队</text>
    <text class="phase-banner-action">去看实时</text>
  </view>
  <view wx:elif="{{phaseBanner === 'settling'}}" class="section phase-banner phase-banner-muted">
    <text class="phase-banner-text">本轮结果结算处理中，最终结果以官方确认为准</text>
  </view>

  <app-error-state id="perf-primary-content" wx:if="{{error && !hasTeamData}}" message="{{error}}" bind:retry="onRetry" />
  <app-loading wx:elif="{{loading && !hasTeamData}}" text="加载球队数据" />
  <view id="perf-primary-content" wx:elif="{{emptyState && !hasTeamData}}" class="section">
    <app-empty-state
      eyebrow="{{emptyEyebrow}}"
      title="{{emptyTitle}}"
      description="{{emptyDescription}}"
      actionText="{{emptyActionText}}"
      featured="{{true}}"
      bind:action="onEmptyAction"
    />
  </view>

  <block wx:else>
    <data-status wx:if="{{error}}" status="stale" message="{{error}} · 当前显示上次成功结果" showRetry="{{true}}" bind:retry="onRetry" />
    <view id="perf-primary-content" class="section card summary-card">
      <view class="metric-grid metric-grid-three">
        <view wx:for="{{overviewStats}}" wx:key="label" class="metric-card">
          <text class="metric-label">{{item.label}}</text>
          <text class="metric-value">{{item.value}}</text>
        </view>
      </view>
    </view>

    <view class="section card summary-card">
      <view class="metric-grid">
        <view wx:for="{{eventStats}}" wx:key="label" class="metric-card">
          <text class="metric-label">{{item.label}}</text>
          <text class="metric-value metric-value-{{item.tone}}">{{item.value}}</text>
        </view>
      </view>
    </view>

    <view class="section tab-strip">
      <view class="tab-item {{showSquad ? 'tab-active' : ''}}" data-tab="squad" catchtap="onTabTap">阵容</view>
      <view class="tab-item {{showTransfer ? 'tab-active' : ''}}" data-tab="transfer" catchtap="onTabTap">转会</view>
      <view class="tab-item {{showChips ? 'tab-active' : ''}}" data-tab="chips" catchtap="onTabTap">开卡</view>
      <view class="tab-item {{showHistory ? 'tab-active' : ''}}" data-tab="history" catchtap="onTabTap">历史</view>
    </view>
    <app-loading wx:if="{{tabLoading}}" text="加载当前栏目" />
    <data-status wx:if="{{tabError && !tabLoading}}" status="partial" message="{{tabError}}" showRetry="{{true}}" bind:retry="onRetry" />

    <view wx:if="{{showSquad}}" class="section card">
      <app-empty-state
        wx:if="{{!hasSquad}}"
        title="GW{{event}} 阵容还没公布"
        description="球队阵容同步后，首发和替补会显示在这里"
        actionText="重新加载"
        bind:action="onRetry"
      />
      <block wx:else>
        <view wx:for="{{squadRows}}" wx:key="id" class="squad-row {{item.bench ? 'squad-row-bench' : ''}}">
          <view class="row-main">
            <view class="row-title">{{item.name}}</view>
            <view class="row-meta">{{item.teamName}}</view>
          </view>
          <view class="squad-meta">
            <text class="position-badge pos-badge {{pos.cls(item.position)}}">{{item.position}}</text>
            <text class="mini-stat">{{item.minutes}}'</text>
            <text class="points-stat">{{item.points}}</text>
            <text class="role-badge {{item.bench ? 'role-bench' : 'role-starter'}}">{{item.role}}</text>
          </view>
        </view>
      </block>
    </view>

    <view wx:if="{{showTransfer}}" class="section">
      <view wx:if="{{transferError && hasTransfers}}" class="inline-error">
        <text>{{transferError}} · 当前显示上次成功结果</text>
        <view class="inline-error-retry" bindtap="onRetry">重试</view>
      </view>
      <app-error-state wx:if="{{transferError && !hasTransfers}}" message="{{transferError}}" bind:retry="onRetry" />
      <app-empty-state wx:elif="{{!hasTransfers}}" title="还没有转会记录" description="产生转会后会按比赛周显示在这里" />
      <block wx:else>
        <view wx:for="{{transferRows}}" wx:key="id" class="card transfer-card">
          <view class="transfer-head">
            <text class="transfer-gw">{{item.gameweek}}</text>
            <text class="transfer-count">转会 {{item.transfers}}</text>
            <text class="transfer-cost {{item.hasCost ? 'cost-bad' : ''}}">扣分 {{item.cost}}</text>
          </view>
          <view wx:if="{{item.moves.length === 0}}" class="empty-line">{{item.emptyText}}</view>
          <view wx:for="{{item.moves}}" wx:for-item="move" wx:key="id" class="move-card">
            <view class="move-text">{{move.text}}</view>
            <view class="row-meta">{{move.costText}}</view>
          </view>
        </view>
      </block>
    </view>

    <view wx:if="{{showChips}}" class="section">
      <view class="card summary-card">
        <view class="metric-grid">
          <view wx:for="{{chipSummaryStats}}" wx:key="label" class="metric-card">
            <text class="metric-label">{{item.label}}</text>
            <text class="metric-value">{{item.value}}</text>
          </view>
        </view>
      </view>
      <view class="card summary-card">
        <view class="section-title-small">开卡统计</view>
        <app-empty-state wx:if="{{chipCountRows.length === 0}}" title="本赛季还没有开卡" description="使用特殊卡后会计入这里" />
        <view wx:for="{{chipCountRows}}" wx:key="id" class="summary-row">
          <view class="row-title">{{item.label}}</view>
          <text class="row-value">{{item.value}}</text>
        </view>
      </view>
      <view class="card summary-card">
        <view class="section-title-small">使用记录</view>
        <app-empty-state wx:if="{{chipUsageRows.length === 0}}" title="还没有特殊卡使用记录" description="首次使用后会显示比赛周与卡片类型" />
        <view wx:for="{{chipUsageRows}}" wx:key="id" class="summary-row">
          <view class="row-title">{{item.label}}</view>
          <text class="row-value">{{item.value}}</text>
        </view>
      </view>
    </view>

    <view wx:if="{{showHistory}}" class="section">
      <view class="card summary-card">
        <view class="section-title-small">GW 历史</view>
        <app-empty-state wx:if="{{historyRows.length === 0}}" title="本赛季还没有 GW 历史" description="完成一个比赛周后会开始累计记录" />
        <view wx:for="{{historyRows}}" wx:key="id" class="history-card">
          <view class="history-title">{{item.gameweek}}</view>
          <view class="history-grid">
            <text>得分 {{item.eventPoints}}</text>
            <text>净分 {{item.eventNetPoints}}</text>
            <text>GW排名 {{item.eventRank}}</text>
            <text>总分 {{item.overallPoints}}</text>
            <text>总排名 {{item.overallRank}}</text>
            <text>转会 {{item.eventTransfers}}</text>
            <text>扣分 {{item.eventTransfersCost}}</text>
            <text>身价 {{item.teamValue}}</text>
            <text>余额 {{item.bank}}</text>
          </view>
        </view>
      </view>
      <view class="card summary-card">
        <view class="section-title-small">赛季历史</view>
        <app-empty-state wx:if="{{seasonHistoryRows.length === 0}}" title="还没有往季记录" description="参加过的完整赛季会显示在这里" />
        <view wx:for="{{seasonHistoryRows}}" wx:key="id" class="summary-row">
          <view class="row-main">
            <view class="row-title">{{item.order}}. {{item.season}}</view>
            <view class="row-meta">总排名 {{item.overallRank}}</view>
          </view>
          <text class="row-value">{{item.totalPoints}}</text>
        </view>
      </view>
    </view>
  </block>

  <bottomNavBar active="myFpl" />
</view>
