<view class="page page-tabbar review-v2-page">
  <view class="section toolbar review-v2-toolbar">
    <view class="row">
      <picker wx:if="{{v2TournamentNames.length}}" class="league-picker" mode="selector" range="{{v2TournamentNames}}" value="{{v2SelectedTournamentIndex}}" bindchange="onTournamentChange">
        <view class="league-switch"><text class="league-name">{{v2SelectedTournament.name || '请选择赛事'}}</text></view>
      </picker>
      <view wx:elif="{{!v2TournamentNames.length}}" class="subtitle">{{emptyState === 'entry' ? '选择球队后加载赛事' : '赛事复盘待就绪'}}</view>
      <picker wx:if="{{v2EventIds.length}}" class="review-event-picker" mode="selector" range="{{v2EventIds}}" value="{{v2SelectedEventIndex}}" bindchange="onGwChange">
        <view class="review-event-pill">GW{{v2Event}}</view>
      </picker>
    </view>
    <view wx:if="{{v2Catalog && v2Catalog.adminReadAll}}" class="review-admin-scope" bindtap="onV2ScopeTap" hover-class="hover-dim">{{v2Scope === 'ALL' ? '管理员：只看我的赛事' : '管理员：查看全部赛事'}}</view>
    <button wx:if="{{v2Catalog && v2Catalog.pageInfo.hasNextPage}}" class="review-catalog-load-more" size="mini" loading="{{v2CatalogLoadingMore}}" disabled="{{v2Loading || v2CatalogLoadingMore}}" bindtap="onCatalogLoadMore">加载更多赛事</button>
  </view>

  <view wx:if="{{v2SelectedTournament}}" class="section tab-strip">
    <view class="tab-item {{showSeason ? 'tab-active' : ''}}" data-view="season" catchtap="onViewTap" hover-class="hover-dim">赛季</view>
    <view class="tab-item {{showGameweek ? 'tab-active' : ''}}" data-view="gameweek" catchtap="onViewTap" hover-class="hover-dim">单轮</view>
  </view>

  <data-status id="perf-primary-content" wx:if="{{v2Error}}" status="stale" message="{{v2Error}}" workload="interactive" transient="{{true}}" showRetry="{{true}}" bind:retry="onRetry" />
  <app-loading wx:if="{{v2Loading}}" text="加载赛事复盘" />
  <view id="perf-primary-content" wx:elif="{{!v2SelectedTournament && !v2Error}}" class="section">
    <app-empty-state
      eyebrow="{{emptyState === 'entry' ? emptyEyebrow : ''}}"
      title="{{emptyState === 'entry' ? emptyTitle : (v2State !== 'NOT_STARTED' ? v2StatusText : '暂无可复盘赛事')}}"
      description="{{emptyState === 'entry' ? emptyDescription : (v2State !== 'NOT_STARTED' ? '最新结算范围正在准备，点击重试检查状态。' : '创建或加入 LetLetMe 赛事并完成轮次结算后，会显示在这里。')}}"
      actionText="{{emptyState === 'entry' ? emptyActionText : (v2State !== 'NOT_STARTED' ? '重新检查' : '去网页版创建赛事')}}"
      bind:action="onEmptyAction"
    />
  </view>

  <block wx:elif="{{v2SelectedTournament}}">
    <view id="{{v2Error ? '' : 'perf-primary-content'}}" class="section card review-v2-header">
      <view class="review-v2-eyebrow">{{v2Format === 'H2H' ? 'H2H 对战' : (v2Format === 'KNOCKOUT' ? '淘汰赛' : (v2Format === 'POINTS' ? '积分赛' : '类型待发布'))}}</view>
      <view class="review-v2-title">{{v2SelectedTournament.name}}</view>
      <view class="review-v2-meta">{{v2SelectedTournament.totalTeamNum}} 支队伍 · {{v2StatusText}}</view>
      <view class="review-v2-hint">这是已结算快照复盘中心；未结算数据统一前往 Live。</view>
    </view>

    <view wx:if="{{v2State !== 'READY'}}" class="section card review-v2-state">
      <view class="section-heading">GW{{v2Event || '—'}} · {{v2StatusText}}</view>
      <view class="review-v2-hint">最新已结算轮次未就绪时不会回退到旧快照。完成结算后可重新进入查看。</view>
      <button wx:if="{{v2Event}}" size="mini" bindtap="onGoLive">前往 Live 查看未结算数据</button>
    </view>

    <view wx:if="{{showSeason && v2Season}}" class="section">
      <view class="section-heading">赛季竞争格局 · 截至 GW{{v2Season.throughEventId}}</view>
      <view class="phase-timeline">
        <view wx:for="{{v2Season.phases}}" wx:key="phaseId" data-phase-id="{{item.phaseId}}" bindtap="onPhaseTap" hover-class="hover-dim" class="phase-pill {{item.phaseId === v2SelectedPhaseId ? 'phase-active' : ''}} {{item.state === 'READY' ? 'phase-ready' : 'phase-pending'}}">
          <text>{{item.format}}</text><text> GW{{item.startEventId}}–{{item.endEventId}}</text>
        </view>
      </view>
      <view wx:if="{{v2SeasonSection && v2SeasonSection.points}}" class="review-v2-table">
        <view class="review-v2-table-head"><text>#</text><text>球队</text><text>Gross</text><text>Net</text></view>
        <view wx:for="{{v2SeasonSection.points.rows}}" wx:key="entryId" class="review-v2-table-row"><text>{{item.rank === null || item.rank === undefined ? '—' : item.rank}}</text><text class="review-v2-team">{{item.entryName}}</text><text>{{item.seasonGrossPoints === null || item.seasonGrossPoints === undefined ? '—' : item.seasonGrossPoints}}</text><text>{{item.seasonNetPoints === null || item.seasonNetPoints === undefined ? '—' : item.seasonNetPoints}}</text></view>
      </view>
      <view wx:if="{{v2SeasonSection && v2SeasonSection.h2h}}" class="review-v2-h2h-list"><view class="section-heading">对战积分榜</view><view class="review-v2-table"><view class="review-v2-table-head review-v2-h2h-row"><text>#</text><text>组</text><text>球队</text><text>积分</text><text>战绩</text></view><view wx:for="{{v2SeasonSection.h2h.standings}}" wx:key="entryId" class="review-v2-table-row review-v2-h2h-row"><text>{{item.rank}}</text><text>G{{item.groupId}}</text><text class="review-v2-team">{{item.entryName}}</text><text>{{item.matchPoints}} 分</text><text>{{item.won}}胜 {{item.drawn}}平 {{item.lost}}负</text></view></view></view>
      <view wx:if="{{v2SeasonSection && v2SeasonSection.knockout}}" class="review-v2-knockout"><view class="section-heading">淘汰赛晋级路径</view><view wx:for="{{v2SeasonSection.knockout.matches}}" wx:key="matchId" class="review-v2-match-card"><text>第{{item.round === null || item.round === undefined ? '—' : item.round}}轮 · {{item.name || '对阵'}}</text><view class="review-v2-match-score"><text class="{{item.home && item.home.entryId === item.winnerEntryId ? 'review-v2-match-winner' : ''}}">{{item.home ? item.home.entryName : '轮空'}} {{item.home && item.home.netPoints !== null && item.home.netPoints !== undefined ? item.home.netPoints : '—'}}{{item.home && item.home.entryId === item.winnerEntryId ? '（晋级）' : ''}}</text><text> — </text><text class="{{item.away && item.away.entryId === item.winnerEntryId ? 'review-v2-match-winner' : ''}}">{{item.away ? item.away.entryName : '轮空'}} {{item.away && item.away.netPoints !== null && item.away.netPoints !== undefined ? item.away.netPoints : '—'}}{{item.away && item.away.entryId === item.winnerEntryId ? '（晋级）' : ''}}</text></view></view></view>
      <view wx:if="{{v2SeasonSection && v2SeasonSection.pageInfo.hasNextPage}}" class="section review-v2-load-more"><button size="mini" loading="{{v2LoadingMore}}" disabled="{{v2Loading || v2LoadingMore}}" bindtap="onV2LoadMore">加载更多</button></view>
    </view>

    <view wx:if="{{showGameweek && v2Gameweek}}" class="section">
      <view class="section-heading">GW{{v2Event}} 单轮表现</view>
      <view wx:if="{{v2Gameweek.payload && v2Gameweek.payload.format === 'POINTS'}}" class="review-v2-stat-grid">
        <view class="review-v2-stat"><text wx:if="{{v2Gameweek.payload.points.headlineMetric !== 'net'}}">本轮积分（Gross）</text><text wx:else>本轮积分（Net）</text><text class="review-v2-stat-value">{{v2Gameweek.payload.points.headlineMetric === 'net' ? v2Gameweek.payload.points.netPointsTotal : v2Gameweek.payload.points.grossPointsTotal}}</text></view>
        <view class="review-v2-stat"><text>转会成本</text><text class="review-v2-stat-value">{{v2Gameweek.payload.points.grossPointsTotal - v2Gameweek.payload.points.netPointsTotal}}</text></view>
        <view class="review-v2-stat"><text>Net（赛事排名）</text><text class="review-v2-stat-value">{{v2Gameweek.payload.points.netPointsTotal}}</text></view>
      </view>
      <view wx:if="{{v2Gameweek.payload && v2Gameweek.payload.format === 'POINTS'}}" class="review-v2-table">
        <view class="review-v2-table-head"><text>#</text><text>球队</text><text>本轮 Gross</text><text>Cost / Net</text></view>
        <view wx:for="{{v2Gameweek.payload.points.rows}}" wx:key="entryId" class="review-v2-table-row"><text>{{item.rank === null || item.rank === undefined ? '—' : item.rank}}</text><text class="review-v2-team">{{item.entryName}}</text><text>{{item.grossPoints === null || item.grossPoints === undefined ? '—' : item.grossPoints}}</text><text>{{item.transferCost === null || item.transferCost === undefined ? '—' : item.transferCost}} / {{item.netPoints === null || item.netPoints === undefined ? '—' : item.netPoints}}</text></view>
      </view>
      <view wx:if="{{v2Gameweek.payload && v2Gameweek.payload.format === 'H2H'}}" class="review-v2-h2h-list"><view class="section-heading">本轮对战</view><view wx:for="{{v2Gameweek.payload.h2h.matches}}" wx:key="matchId" class="review-v2-match-card"><text>{{item.isBye ? '轮空' : '小组 G' + item.groupId}}</text><text>{{item.home && item.home.isAverage ? '平均队伍' : (item.home ? item.home.entryName : '轮空')}} {{item.home && item.home.netPoints !== null && item.home.netPoints !== undefined ? item.home.netPoints : '—'}} — {{item.away && item.away.isAverage ? '平均队伍' : (item.away ? item.away.entryName : '轮空')}} {{item.away && item.away.netPoints !== null && item.away.netPoints !== undefined ? item.away.netPoints : '—'}}</text></view></view>
      <view wx:if="{{v2Gameweek.payload && v2Gameweek.payload.format === 'KNOCKOUT'}}" class="review-v2-knockout"><view class="section-heading">淘汰赛对阵</view><view wx:for="{{v2Gameweek.payload.knockout.matches}}" wx:key="matchId" class="review-v2-match-card"><text>第{{item.round === null || item.round === undefined ? '—' : item.round}}轮 · {{item.name || '对阵'}}</text><view class="review-v2-match-score"><text class="{{item.home && item.home.entryId === item.winnerEntryId ? 'review-v2-match-winner' : ''}}">{{item.home ? item.home.entryName : '轮空'}} {{item.home && item.home.netPoints !== null && item.home.netPoints !== undefined ? item.home.netPoints : '—'}}{{item.home && item.home.entryId === item.winnerEntryId ? '（晋级）' : ''}}</text><text> — </text><text class="{{item.away && item.away.entryId === item.winnerEntryId ? 'review-v2-match-winner' : ''}}">{{item.away ? item.away.entryName : '轮空'}} {{item.away && item.away.netPoints !== null && item.away.netPoints !== undefined ? item.away.netPoints : '—'}}{{item.away && item.away.entryId === item.winnerEntryId ? '（晋级）' : ''}}</text></view></view></view>
      <view wx:if="{{v2Gameweek.payload && ((v2Gameweek.payload.format === 'H2H' && v2Gameweek.payload.h2h.hasNextPage) || (v2Gameweek.payload.format === 'KNOCKOUT' && v2Gameweek.payload.knockout.hasNextPage) || (v2Gameweek.payload.format === 'POINTS' && v2Gameweek.payload.points.hasNextPage))}}" class="section review-v2-load-more"><button size="mini" loading="{{v2LoadingMore}}" disabled="{{v2Loading || v2LoadingMore}}" bindtap="onV2LoadMore">加载更多</button></view>
    </view>
  </block>

  <view class="section"><view class="footnote" bindtap="onOpenWebsite" hover-class="hover-dim">创建、筹备和管理赛事请访问 LetLetMe 网页版</view></view>
</view>
<bottomNavBar active="myFpl" />
