/* League list — flush-inner card: global .card shell, rows own the padding */
.league-list {
  overflow: hidden;
  padding: 0;
}

.league-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 88rpx;
  padding: 24rpx;
  box-sizing: border-box;
}

.league-row + .league-row {
  border-top: 1rpx solid var(--line);
}

.league-main {
  flex: 1;
  min-width: 0;
}

.league-name {
  overflow: hidden;
  color: var(--ink);
  font-size: 28rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.league-meta {
  margin-top: 6rpx;
  overflow: hidden;
  color: var(--muted-ink);
  font-size: 24rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.league-action {
  flex-shrink: 0;
  min-width: 120rpx;
  min-height: 56rpx;
  line-height: 56rpx;
  margin-left: 16rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  border-radius: 999rpx;
  background: var(--track);
  color: var(--green-ink);
  font-size: 24rpx;
  font-weight: 700;
  text-align: center;
}

.footnote {
  color: var(--muted-ink);
  font-size: 22rpx;
  text-align: center;
}
