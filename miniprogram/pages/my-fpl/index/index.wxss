/* Module row — extends global .card with a row layout */
.module {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 88rpx;
}

.module-title {
  color: var(--ink);
  font-size: 28rpx;
  font-weight: 700;
}

.module-subtitle {
  margin-top: 6rpx;
  color: var(--muted-ink);
  font-size: 24rpx;
}

.module-arrow {
  flex-shrink: 0;
  color: var(--green-ink);
  font-size: 24rpx;
  font-weight: 700;
}
