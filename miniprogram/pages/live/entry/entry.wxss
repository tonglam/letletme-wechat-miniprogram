.live-summary {
  display: grid;
  grid-template-columns: 1fr;
  gap: 16rpx;
}

/* Extends global .scoreboard (border/radius/colors live there) */
.score-card {
  padding: 28rpx;
  box-sizing: border-box;
}

.score-label {
  color: var(--muted-ink);
  font-size: 24rpx;
}

.score-card .score-label {
  color: var(--chalk-a60);
}

.score {
  margin-top: 8rpx;
  color: var(--electric);
  font-size: 56rpx;
  font-weight: 800;
}

.score-sub {
  margin-top: 8rpx;
  color: var(--chalk-a60);
  font-size: 22rpx;
}

.summary-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12rpx;
}

.summary-tile {
  min-width: 0;
  padding: 18rpx 10rpx;
  border-radius: 12rpx;
  background: var(--track);
  text-align: center;
}

.tile-label {
  color: var(--muted-ink);
  font-size: 20rpx;
}

.tile-value {
  margin-top: 8rpx;
  color: var(--ink);
  font-size: 28rpx;
  font-weight: 800;
}

.info-card {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
}

.info-item {
  min-width: 0;
}

.info-value {
  margin-top: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: var(--ink);
  font-size: 28rpx;
  font-weight: 800;
}

.section-heading {
  margin-bottom: 8rpx;
  color: var(--ink);
  font-size: 28rpx;
  font-weight: 800;
}

.transfer-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.transfer-in {
  color: var(--ink);
  font-size: 26rpx;
  font-weight: 700;
}

.transfer-out {
  margin-top: 6rpx;
  color: var(--muted-ink);
  font-size: 22rpx;
}

.transfer-price {
  flex-shrink: 0;
  margin-left: 16rpx;
  color: var(--ink);
  font-size: 24rpx;
  font-weight: 800;
}
