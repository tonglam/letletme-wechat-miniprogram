.live-summary {
  display: grid;
  grid-template-columns: 1fr;
  gap: 16rpx;
}

.score-card {
  border-radius: 20rpx;
  padding: 28rpx;
  box-sizing: border-box;
}

.score-label {
  color: var(--muted-ink, #6e5a72);
  font-size: 24rpx;
}

.score-card .score-label {
  color: rgba(249, 247, 242, 0.6);
}

.score {
  margin-top: 8rpx;
  color: var(--electric, #00ff85);
  font-size: 56rpx;
  font-weight: 800;
}

.score-sub {
  margin-top: 8rpx;
  color: rgba(249, 247, 242, 0.6);
  font-size: 22rpx;
}

.summary-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12rpx;
}

.summary-tile {
  min-width: 0;
  padding: 18rpx 10rpx;
  border-radius: 12rpx;
  background: var(--track, #f1efe9);
  text-align: center;
}

.tile-label {
  color: var(--muted-ink, #6e5a72);
  font-size: 20rpx;
}

.tile-value {
  margin-top: 8rpx;
  color: var(--ink, #301333);
  font-size: 28rpx;
  font-weight: 800;
}

.info-card {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
}

.info-item {
  min-width: 0;
}

.info-value {
  margin-top: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: var(--ink, #301333);
  font-size: 28rpx;
  font-weight: 800;
}

.section-heading {
  margin-bottom: 8rpx;
  color: var(--ink, #301333);
  font-size: 28rpx;
  font-weight: 800;
}

.warning-strip {
  padding: 18rpx 22rpx;
  border-radius: 12rpx;
  background: var(--warning-tint, #f6ead9);
  color: var(--warning, #924a07);
  font-size: 24rpx;
}

.transfer-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--line, #ddd4de);
}

.transfer-in {
  color: var(--ink, #301333);
  font-size: 26rpx;
  font-weight: 700;
}

.transfer-out {
  margin-top: 6rpx;
  color: var(--muted-ink, #6e5a72);
  font-size: 22rpx;
}

.transfer-price {
  flex-shrink: 0;
  margin-left: 16rpx;
  color: var(--ink, #301333);
  font-size: 24rpx;
  font-weight: 800;
}
