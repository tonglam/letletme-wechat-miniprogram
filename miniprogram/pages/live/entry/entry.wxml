<view class="page page-tabbar">
  <view wx:if="{{viewOnly}}" class="section">
    <view class="subtitle">查看模式</view>
  </view>

  <view wx:if="{{!emptyState && event > 0}}" class="section live-toolbar">
    <view class="live-toolbar-status">
      <live-status-bar compact="{{true}}" state="{{displayState}}" lastChecked="{{lastUpdated}}" bind:refresh="onRetry" />
    </view>
    <gw-picker compact="{{true}}" value="{{event}}" max="{{maxGw}}" bind:change="onGwChange" />
  </view>

  <view wx:if="{{error && !hasData && !emptyState && !noPicks}}" id="perf-primary-content">
    <app-error-state message="{{error}}" bind:retry="onRetry" />
  </view>
  <app-loading wx:elif="{{loading && !hasData}}" text="加载实时积分" />
  <view wx:elif="{{emptyState === 'entry'}}" id="perf-primary-content" class="section">
    <app-empty-state
      eyebrow="需要球队"
      title="先选择我的球队"
      description="查找球队并设为我的球队后，即可显示实时阵容"
      actionText="去选择球队"
      featured="{{true}}"
      bind:action="onChooseEntry"
    />
  </view>
  <view wx:elif="{{emptyState === 'preseason'}}" id="perf-primary-content" class="section">
    <app-empty-state
      eyebrow="赛季准备中"
      title="当前赛季暂无实时比赛周"
      description="比赛周开始后，这里会显示实时阵容和得分"
      actionText="重新检查"
      featured="{{true}}"
      bind:action="onRetry"
    />
  </view>
  <view wx:elif="{{noPicks}}" id="perf-primary-content" class="section">
    <view wx:if="{{hasData}}" class="section live-summary">
      <view class="score-card scoreboard">
        <view class="score-top">
          <view class="score-identity">
            <view class="score-team"><text user-select="{{true}}">{{entryName || '我的球队'}}</text></view>
            <view wx:if="{{playerName}}" class="score-manager"><text user-select="{{true}}">{{playerName}}</text></view>
          </view>
          <view class="score-hero">
            <view class="score-label">{{scoreStatusText || '官方实时'}} · 总分</view>
            <view class="score">{{totalText}}</view>
          </view>
        </view>
        <view class="score-sub">{{scoreDetailText ? scoreDetailText + ' · ' : ''}}更新 {{lastUpdated || '-'}}{{refreshing ? ' · 刷新中' : ''}}</view>
      </view>
      <view class="summary-grid">
        <view wx:for="{{summaryTiles}}" wx:key="label" class="summary-tile">
          <view class="tile-label">{{item.label}}</view>
          <view class="tile-value">{{item.value}}</view>
        </view>
      </view>
    </view>
    <app-empty-state
      eyebrow="本轮未提交"
      title="GW{{event}} 未找到阵容"
      description="这不是 0 分；官方阵容同步或提交后再回来查看"
      actionText="重新检查"
      featured="{{true}}"
      bind:action="onRetry"
    />
  </view>
  <block wx:else>
    <data-status wx:if="{{error}}" status="stale" message="{{error}}，当前显示上次成功结果" transient="{{true}}" showRetry="{{true}}" bind:retry="onRetry" />
    <view id="perf-primary-content" class="section live-summary">
      <view class="score-card scoreboard">
        <view class="score-top">
          <view class="score-identity">
            <view class="score-team"><text user-select="{{true}}">{{entryName || '我的球队'}}</text></view>
            <view wx:if="{{playerName}}" class="score-manager"><text user-select="{{true}}">{{playerName}}</text></view>
          </view>
          <view class="score-hero">
            <view class="score-label">{{scoreStatusText || '官方实时'}} · 总分</view>
            <view class="score">{{totalText}}</view>
          </view>
        </view>
        <view class="score-sub">{{scoreDetailText ? scoreDetailText + ' · ' : ''}}更新 {{lastUpdated || '-'}}{{refreshing ? ' · 刷新中' : ''}}</view>
      </view>
      <view class="summary-grid">
        <view wx:for="{{summaryTiles}}" wx:key="label" class="summary-tile">
          <view class="tile-label">{{item.label}}</view>
          <view class="tile-value">{{item.value}}</view>
        </view>
      </view>
    </view>

    <view class="section card info-card">
      <view class="info-item">
        <view class="score-label">队长</view>
        <view class="info-value"><text user-select="{{true}}">{{captainText}}</text></view>
      </view>
      <view class="info-item">
        <view class="score-label">开卡</view>
        <view class="info-value"><text user-select="{{true}}">{{chipText}}</text></view>
      </view>
      <view class="info-item">
        <view class="score-label">已上场</view>
        <view class="info-value">{{playedText}}</view>
      </view>
    </view>

    <view wx:if="{{pitchPlayers.length}}" class="section live-pitch-section">
      <view class="live-pitch-bar">
        <text class="live-pitch-label">阵容图</text>
        <view
          class="tool-btn tool-btn-labeled {{shareBusy ? 'done' : ''}}"
          bindtap="onSharePitch"
          hover-class="hover-dim"
        >
          <text class="tool-label">{{shareBusy ? '生成中' : '分享图片'}}</text>
        </view>
      </view>
      <squad-pitch
        id="live-squad-pitch"
        players="{{pitchPlayers}}"
        benchPlayers="{{pitchBench}}"
        header="{{pitchHeader}}"
        benchBoost="{{pitchBenchBoost}}"
        bind:playertap="onPitchPlayerTap"
      />
    </view>

    <view class="section card lineup-card">
      <view class="lineup-head">
        <view class="section-heading">阵容</view>
        <view wx:if="{{hasData}}" class="tool-btn tool-btn-labeled {{shareCopied ? 'done' : ''}}" bindtap="onCopyShare" hover-class="hover-dim">
          <image wx:if="{{shareCopied}}" class="tool-icon" src="/assets/icons/check.svg" mode="aspectFit" />
          <image wx:else class="tool-icon" src="/assets/icons/copy.svg" mode="aspectFit" />
          <text class="tool-label">{{shareCopied ? '已复制' : '分享文字'}}</text>
        </view>
      </view>
      <app-empty-state
        wx:if="{{starters.length === 0 && bench.length === 0 && managers.length === 0}}"
        title="GW{{event}} 阵容还没公布"
        description="比赛周阵容同步后，首发和替补会显示在这里"
        actionText="重新加载"
        bind:action="onRetry"
      />
      <player-row wx:for="{{starters}}" wx:key="element" player="{{item}}" showTeam="{{true}}" showPoints="{{true}}" showLiveMeta="{{true}}" bind:open="onOpenPlayer" />
      <block wx:if="{{bench.length > 0}}">
        <view class="section-heading bench-heading">替补</view>
        <player-row wx:for="{{bench}}" wx:key="element" player="{{item}}" showTeam="{{true}}" showPoints="{{true}}" showLiveMeta="{{true}}" bind:open="onOpenPlayer" />
      </block>
    </view>

    <view wx:if="{{managers.length > 0}}" class="section card lineup-card">
      <view class="section-heading">教练</view>
      <player-row wx:for="{{managers}}" wx:key="element" player="{{item}}" showTeam="{{true}}" showPoints="{{true}}" showLiveMeta="{{true}}" bind:open="onOpenPlayer" />
    </view>

    <view class="section card lineup-card">
      <view class="section-heading">本周转会{{transfersLoading && transfers.length > 0 ? ' · 刷新中' : ''}}</view>
      <app-loading wx:if="{{transfersLoading && transfers.length === 0}}" text="加载本周转会" />
      <app-error-state wx:elif="{{transfersError}}" message="{{transfersError}}" bind:retry="onRetry" />
      <app-empty-state wx:elif="{{transfers.length === 0}}" title="本周保持原阵容" description="GW{{event}} 没有转会记录" />
      <view wx:for="{{transfers}}" wx:key="rowKey" class="swap-row">
        <view class="swap-side">
          <text class="swap-kicker">转出</text>
          <text class="swap-name" user-select="{{true}}">{{item.outName}}</text>
          <text wx:if="{{item.outTeam}}" class="swap-team">{{item.outTeam}}</text>
        </view>
        <view class="swap-mid">
          <view class="swap-mark"></view>
          <text class="swap-price">{{item.priceText}}</text>
        </view>
        <view class="swap-side swap-in">
          <text class="swap-kicker">转入</text>
          <text class="swap-name" user-select="{{true}}">{{item.inName}}</text>
          <text wx:if="{{item.inTeam}}" class="swap-team">{{item.inTeam}}</text>
        </view>
      </view>
    </view>
  </block>
  <player-live-sheet wx:if="{{!error && !loading}}" show="{{playerDetailOpen}}" detail="{{playerDetail}}" bind:close="onClosePlayer" />
  <copy-fallback show="{{shareSheetOpen}}" text="{{shareText}}" bind:close="onCloseShareSheet" />
  <bottomNavBar active="live" />
</view>
