<view class="page page-tabbar">
  <view wx:if="{{tournaments.length && !emptyState}}" class="section status-section">
    <live-status-bar compact="{{true}}" state="{{displayState}}" lastChecked="{{lastUpdated}}" retainedCount="{{retainedRowCount}}" bind:refresh="onRetry" />
    <view class="subtitle score-source-status">{{scoreStatusText}}</view>
  </view>

  <view wx:if="{{emptyState !== 'preseason'}}" class="section toolbar">
    <view class="row">
      <picker wx:if="{{classicTournamentNames.length}}" class="league-picker" mode="selector" range="{{classicTournamentNames}}" value="{{selectedClassicIndex}}" bindchange="onClassicTournamentChange">
        <view class="league-switch">
          <text class="league-name {{classicPickerActive ? '' : 'league-name-empty'}}">{{classicPickerText}}</text>
          <text class="league-action">切换</text>
        </view>
      </picker>
      <picker wx:if="{{h2hTournamentNames.length}}" class="league-picker" mode="selector" range="{{h2hTournamentNames}}" value="{{selectedH2HIndex}}" bindchange="onH2HTournamentChange">
        <view class="league-switch">
          <text class="league-name {{h2hPickerActive ? '' : 'league-name-empty'}}">{{h2hPickerText}}</text>
          <text class="league-action">切换</text>
        </view>
      </picker>
      <view wx:if="{{!tournaments.length}}">
        <view class="subtitle">{{emptyState === 'entry' ? '选择球队后加载赛事' : '赛事数据待就绪'}}</view>
      </view>
      <gw-picker wx:if="{{tournaments.length}}" compact="{{true}}" value="{{event}}" max="{{maxGw}}" bind:change="onGwChange" />
      <view wx:if="{{tournaments.length}}" class="tool-btn tool-btn-labeled detail-btn" bindtap="onOpenTournamentDetail" hover-class="hover-dim">
        <text class="tool-label">详情</text>
      </view>
    </view>
  </view>

  <app-error-state id="perf-primary-content" wx:if="{{tournamentListError && !hasData && !emptyState}}" message="{{tournamentListError}}" workload="interactive" bind:retry="onRetry" />
  <app-error-state id="perf-primary-content" wx:elif="{{error && !hasData && !emptyState}}" message="{{error}}" workload="{{errorWorkload}}" bind:retry="onRetry" />
  <app-loading wx:elif="{{loading && !hasData}}" text="加载实时赛事" />
  <view id="perf-primary-content" wx:elif="{{emptyState}}" class="section">
    <app-empty-state
      eyebrow="{{emptyEyebrow}}"
      title="{{emptyTitle}}"
      description="{{emptyDescription}}"
      actionText="{{emptyActionText}}"
      featured="{{true}}"
      bind:action="onEmptyAction"
    />
    <view wx:if="{{emptyState === 'tournaments'}}" class="manage-hint" bindtap="onCopyCompetitionLink" hover-class="hover-dim">创建和管理赛事请访问 LetLetMe 网页版 · 点击复制链接</view>
  </view>
  <block wx:else>
    <data-status
      wx:if="{{tournamentListError}}"
      status="stale"
      message="{{tournamentListError}}{{tournamentListErrorSuffix ? '，' + tournamentListErrorSuffix : ''}}"
      workload="interactive"
      transient="{{true}}"
      showRetry="{{true}}"
      bind:retry="onRetry"
    />
    <data-status
      wx:elif="{{error}}"
      status="stale"
      message="{{error}}{{errorSuffix ? '，' + errorSuffix : ''}}"
      workload="{{errorWorkload}}"
      transient="{{true}}"
      showRetry="{{true}}"
      bind:retry="onRetry"
    />

    <view wx:if="{{setupActive}}" class="section card setup-card">
      <view class="setup-title">{{setupFailed ? '赛事设置失败' : '正在准备准确的积分榜'}}</view>
      <view class="setup-desc">{{setupFailed ? '请联系赛事管理员处理；修复会复用已完成的数据，只处理缺失内容。' : '所有参赛球队的核心计分数据完整后，积分榜将自动开放。'}}</view>
      <view wx:if="{{!setupFailed}}" class="setup-phases">
        <view
          wx:for="{{setupPhases}}"
          wx:key="phase"
          class="setup-phase-row {{item.state}}"
        >
          <text class="setup-phase-icon">{{item.state === 'complete' ? '✓' : item.state === 'active' ? '●' : '○'}}</text>
          <text class="setup-phase-label">{{item.label}}</text>
          <text wx:if="{{item.progressText}}" class="setup-phase-progress">{{item.progressText}}</text>
        </view>
      </view>
      <view class="tool-btn tool-btn-labeled setup-retry" bindtap="onRetry" hover-class="hover-dim">
        <text class="tool-label">{{setupFailed ? '重试' : '刷新进度'}}</text>
      </view>
    </view>

    <block wx:elif="{{h2hActive}}">
      <view wx:if="{{h2hViewerRankText}}" class="section stat-strip">
        <view class="stat">
          <text class="stat-label">我的排名</text>
          <text class="stat-value">{{h2hViewerRankText}}</text>
        </view>
        <view class="stat">
          <text class="stat-label">对战积分</text>
          <text class="stat-value">{{h2hViewerMatchPointsText}}</text>
        </view>
        <view class="stat">
          <text class="stat-label">战绩</text>
          <text class="stat-value">{{h2hViewerRecordText}}</text>
        </view>
      </view>

      <view class="section sort-tabs">
        <view
          wx:if="{{h2hShowStandings}}"
          class="sort-tab {{h2hTab === 'standings' ? 'active' : ''}}"
          data-tab="standings"
          bindtap="onH2HTabTap"
          hover-class="hover-dim"
        >积分榜</view>
        <view
          class="sort-tab {{h2hTab === 'matches' ? 'active' : ''}}"
          data-tab="matches"
          bindtap="onH2HTabTap"
          hover-class="hover-dim"
        >本轮对阵</view>
        <view
          class="sort-tab {{h2hTab === 'mine' ? 'active' : ''}}"
          data-tab="mine"
          bindtap="onH2HTabTap"
          hover-class="hover-dim"
        >我的对阵</view>
      </view>

      <view class="section h2h-share-row">
        <view class="result-actions">
          <view class="tool-btn {{shareCopied ? 'done' : ''}}" bindtap="onCopyH2HShare" hover-class="hover-dim">
            <image wx:if="{{shareCopied}}" class="tool-icon" src="/assets/icons/check.svg" mode="aspectFit" />
            <image wx:else class="tool-icon" src="/assets/icons/copy.svg" mode="aspectFit" />
          </view>
          <view class="tool-btn {{shareImageBusy ? 'done' : ''}}" bindtap="onShareH2HImage" hover-class="hover-dim">
            <image class="tool-icon" src="/assets/icons/image.svg" mode="aspectFit" />
          </view>
        </view>
      </view>

      <view wx:if="{{h2hTab === 'standings' && h2hShowStandings}}" class="section">
        <app-empty-state
          wx:if="{{h2hStandings.length === 0}}"
          title="积分榜待发布"
          description="官方分数可追溯后显示 H2H 积分榜"
        />
        <view wx:else class="board h2h-board">
          <view class="board-head">
            <text class="col-rank">#</text>
            <text class="col-team">球队</text>
            <text class="col-num col-record">战绩</text>
            <text class="col-num col-pf">总得分</text>
            <text class="col-num col-mp">积分</text>
          </view>
          <view
            wx:for="{{h2hStandings}}"
            wx:key="entryId"
            class="board-row {{item.isMe ? 'me' : ''}}"
            data-entry-id="{{item.entryId}}"
            bindtap="onOpenEntry"
            hover-class="hover-dim"
          >
            <text class="col-rank {{item.topRank ? 'top3' : ''}}">{{item.rankText}}</text>
            <view class="col-team">
              <view class="team-line">
                <text class="team-name">{{item.entryName}}</text>
                <text wx:if="{{item.isMe}}" class="me-badge">我</text>
              </view>
              <view class="team-meta">
                <text wx:if="{{item.playerName}}">{{item.playerName}} · </text>
                <text>已赛 {{item.playedText}}</text>
              </view>
            </view>
            <text class="col-num col-record">{{item.recordText}}</text>
            <text class="col-num col-pf">{{item.pointsForText}}</text>
            <text class="col-num col-mp">{{item.matchPointsText}}</text>
          </view>
        </view>
      </view>

      <view wx:if="{{h2hTab === 'matches'}}" class="section">
        <view wx:if="{{h2hAwaitingSchedule}}" class="card h2h-await">正在等待 FPL 发布 GW{{event}} 本轮对阵。</view>
        <app-empty-state
          wx:elif="{{h2hMatches.length === 0}}"
          title="暂无对阵"
          description="赛程发布后显示本轮全部对阵"
        />
        <view wx:else class="h2h-match-list">
          <view
            wx:for="{{h2hMatches}}"
            wx:key="key"
            class="h2h-match {{item.involvesViewer ? 'viewer' : ''}}"
          >
            <view class="h2h-match-head">
              <text class="h2h-match-order">{{item.orderText}}</text>
              <text class="h2h-match-phase">{{item.phaseLabel}}</text>
              <text wx:if="{{item.isBye}}" class="h2h-bye">轮空</text>
              <text wx:if="{{item.involvesViewer}}" class="h2h-viewer-dot"></text>
            </view>
            <view class="h2h-match-body">
              <view class="h2h-side">
                <text class="h2h-side-name {{item.homeWon ? 'won' : ''}}">{{item.homeName}}</text>
                <text wx:if="{{item.homePlayer}}" class="h2h-side-player">{{item.homePlayer}}</text>
              </view>
              <view class="h2h-score">
                <block wx:if="{{item.hasScore}}">
                  <text class="h2h-score-num {{item.homeWon ? 'won' : ''}}">{{item.homeScoreText}}</text>
                  <text class="h2h-score-sep">—</text>
                  <text class="h2h-score-num {{item.awayWon ? 'won' : ''}}">{{item.awayScoreText}}</text>
                </block>
                <text wx:else class="h2h-vs">对阵</text>
              </view>
              <view class="h2h-side h2h-side-away">
                <text class="h2h-side-name {{item.awayWon ? 'won' : ''}}">{{item.awayName}}</text>
                <text wx:if="{{item.awayPlayer}}" class="h2h-side-player">{{item.awayPlayer}}</text>
              </view>
            </view>
            <view wx:if="{{item.tiebreakText}}" class="h2h-tiebreak">{{item.tiebreakText}}</view>
          </view>
        </view>
      </view>

      <view wx:if="{{h2hTab === 'mine'}}" class="section">
        <view wx:if="{{h2hMatchupsLoading}}" class="card h2h-await">正在加载我的对阵…</view>
        <view wx:elif="{{h2hMatchupsFailed}}" class="card h2h-await">我的对阵暂时无法获取。</view>
        <view wx:elif="{{h2hMatchups.length === 0}}" class="card h2h-await">暂无对阵记录。</view>
        <view wx:else class="h2h-match-list">
          <view
            wx:for="{{h2hMatchups}}"
            wx:key="key"
            class="h2h-match"
          >
            <view class="h2h-match-head">
              <text class="h2h-match-order">{{item.roundText}}</text>
              <text class="h2h-matchup-status {{item.statusClass}}">{{item.statusText}}</text>
            </view>
            <view class="h2h-match-body">
              <view class="h2h-side">
                <text class="h2h-side-name {{item.homeWon ? 'won' : ''}}">{{item.homeName}}</text>
                <text wx:if="{{item.homePlayer}}" class="h2h-side-player">{{item.homePlayer}}</text>
              </view>
              <view class="h2h-score">
                <block wx:if="{{item.hasScore}}">
                  <text class="h2h-score-num {{item.homeWon ? 'won' : ''}}">{{item.homeScoreText}}</text>
                  <text class="h2h-score-sep">—</text>
                  <text class="h2h-score-num {{item.awayWon ? 'won' : ''}}">{{item.awayScoreText}}</text>
                </block>
                <text wx:else class="h2h-vs">对阵</text>
              </view>
              <view class="h2h-side h2h-side-away">
                <text class="h2h-side-name {{item.awayWon ? 'won' : ''}}">{{item.awayName}}</text>
                <text wx:if="{{item.awayPlayer}}" class="h2h-side-player">{{item.awayPlayer}}</text>
              </view>
            </view>
          </view>
        </view>
      </view>
    </block>

    <block wx:else>
    <view class="section stat-strip">
      <view class="stat">
        <text class="stat-label">最高</text>
        <text class="stat-value">{{highestText}}</text>
      </view>
      <view class="stat">
        <text class="stat-label">平均</text>
        <text class="stat-value">{{averageText}}</text>
      </view>
      <view class="stat">
        <text class="stat-label">参赛</text>
        <text class="stat-value">{{entriesText}}</text>
      </view>
    </view>

    <view class="section card filter-card">
      <view class="filter-top">
        <filter-bar class="filter-search" keyword="{{keyword}}" placeholder="搜索球队或经理" actionText="查" bind:search="onKeyword" bind:submit="onSearch" bind:reset="onResetSearch" />
        <view class="filter-toggle {{activeFilterCount > 0 ? 'active' : ''}}" bindtap="onToggleAdvanced" hover-class="hover-dim">
          <text>筛选</text>
          <text wx:if="{{activeFilterCount > 0}}" class="filter-toggle-count">{{activeFilterCount}}</text>
        </view>
      </view>
    </view>

    <view class="section sort-tabs">
      <view
        wx:for="{{sortOptions}}"
        wx:key="key"
        class="sort-tab {{sortKey === item.key ? 'active' : ''}}"
        data-key="{{item.key}}"
        bindtap="onSortTap"
        hover-class="hover-dim"
      >{{item.label}}{{sortKey === item.key ? (sortDesc ? ' ↓' : ' ↑') : ''}}</view>
    </view>

    <view id="perf-primary-content" class="section">
      <view class="result-row">
        <view wx:if="{{compareMode}}" class="compare-hint">{{compareHint}}</view>
        <view wx:else class="result-count">{{displayedRows.length}} / {{filteredCount}} 支 · 共 {{rowCount}}</view>
        <view class="result-actions">
          <view class="tool-btn {{shareCopied ? 'done' : ''}}" bindtap="onCopyShare" hover-class="hover-dim">
            <image wx:if="{{shareCopied}}" class="tool-icon" src="/assets/icons/check.svg" mode="aspectFit" />
            <image wx:else class="tool-icon" src="/assets/icons/copy.svg" mode="aspectFit" />
          </view>
          <view wx:if="{{!compareMode}}" class="tool-btn {{shareImageBusy ? 'done' : ''}}" bindtap="onShareBoardImage" hover-class="hover-dim">
            <image class="tool-icon" src="/assets/icons/image.svg" mode="aspectFit" />
          </view>
          <block wx:if="{{compareMode}}">
            <text wx:if="{{compareLoading}}" class="action-muted">对比加载中</text>
            <text wx:if="{{compareIds.length === 2}}" class="action" bindtap="onOpenCompareSheet" hover-class="hover-dim">对比</text>
            <text class="action-muted" bindtap="onToggleCompare" hover-class="hover-dim">取消</text>
          </block>
          <view wx:else class="tool-btn tool-btn-labeled" bindtap="onToggleCompare" hover-class="hover-dim">
            <image class="tool-icon" src="/assets/icons/compare.svg" mode="aspectFit" />
            <text class="tool-label">对比</text>
          </view>
        </view>
      </view>
      <app-empty-state
        wx:if="{{displayedRows.length === 0}}"
        title="{{resultsEmptyTitle}}"
        description="{{resultsEmptyDescription}}"
        actionText="{{resultsEmptyActionText}}"
        bind:action="onEmptyResultsAction"
      />
      <view wx:else class="board {{compareMode ? 'is-compare' : ''}}">
        <view class="board-head">
          <view wx:if="{{compareMode}}" class="col-check"></view>
          <text class="col-rank">#</text>
          <text class="col-team">球队</text>
          <text class="col-num col-played">出场</text>
          <text class="col-num col-gw">GW</text>
          <text class="col-num col-hit">扣分</text>
          <text class="col-num">净</text>
          <text class="col-num col-total">总分</text>
        </view>
        <view
          wx:for="{{displayedRows}}"
          wx:key="entry"
          class="board-row {{item.isMe ? 'me' : ''}} {{item.pinned ? 'pinned' : ''}} {{item.compared ? 'compared' : ''}} {{item.compareDisabled ? 'locked' : ''}}"
          data-entry-id="{{item.entry}}"
          bindtap="onOpenEntry"
          hover-class="hover-dim"
        >
          <view wx:if="{{compareMode}}" class="col-check">
            <view class="row-check {{item.compared ? 'on' : ''}}">
              <image wx:if="{{item.compared}}" class="row-check-icon" src="/assets/icons/check.svg" mode="aspectFit" />
            </view>
          </view>
          <text class="col-rank {{item.topRank ? 'top3' : ''}}">{{item.eventPointsKnown ? (item.rank > 0 ? item.rank : item.visibleRank) : '—'}}</text>
          <view class="col-team">
            <view class="team-line">
              <text class="team-name">{{item.entryName || '-'}}</text>
              <text wx:if="{{item.isMe}}" class="me-badge">我</text>
            </view>
            <view wx:if="{{item.playerName || item.displayCaptain || item.chipCode}}" class="team-meta">
              <text wx:if="{{item.playerName}}">{{item.playerName}}</text>
              <text wx:if="{{item.playerName && item.displayCaptain}}"> · </text>
              <text wx:if="{{item.displayCaptain}}">{{item.displayCaptain}}</text>
              <text wx:if="{{item.chipCode}}" class="chip-badge chip-{{item.chipCode}}">{{item.chipCode}}</text>
            </view>
            <view wx:if="{{item.overallRankText || item.teamValueText}}" class="team-meta team-submeta">
              <text wx:if="{{item.overallRankText}}">总排 {{item.overallRankText}}</text>
              <text wx:if="{{item.overallRankText && item.teamValueText}}"> · </text>
              <text wx:if="{{item.teamValueText}}">队值 {{item.teamValueText}}</text>
            </view>
          </view>
          <text class="col-num col-played">{{item.playedText || '-'}}</text>
          <text class="col-num col-gw">{{item.displayLive}}</text>
          <text class="col-num col-hit {{item.transferCostKnown && item.transferCost > 0 ? 'hit' : ''}}">{{item.displayHit || '—'}}</text>
          <text class="col-num">{{item.displayNet}}</text>
          <text class="col-num col-total">{{item.displayTotal}}</text>
        </view>
        <view wx:if="{{hasMore}}" class="load-more" bindtap="loadMore" hover-class="hover-dim">再显示 20 队</view>
      </view>
    </view>
    </block>
  </block>

  <view wx:if="{{compareOpen && compareLeft && compareRight}}" class="cmp-root">
    <view class="cmp-mask" bindtap="onCloseCompare"></view>
    <view class="cmp-sheet">
      <view class="cmp-head">
        <view class="cmp-title">对比两队</view>
        <text class="compare-action" bindtap="onCloseCompare">关闭</text>
      </view>
      <scroll-view scroll-y class="cmp-body">
        <view class="cmp-grid">
          <text class="cmp-label"></text>
          <text class="cmp-side">{{compareLeft.entryName}}</text>
          <text class="cmp-side">{{compareRight.entryName}}</text>
          <text class="cmp-label">经理</text>
          <text>{{compareLeft.playerName || '-'}}</text>
          <text>{{compareRight.playerName || '-'}}</text>
          <text class="cmp-label">GW</text>
          <text>{{compareLeft.displayLive}}</text>
          <text>{{compareRight.displayLive}}</text>
          <text class="cmp-label">净分</text>
          <text>{{compareLeft.displayNet}}</text>
          <text>{{compareRight.displayNet}}</text>
          <text class="cmp-label">总分</text>
          <text>{{compareLeft.displayTotal}}</text>
          <text>{{compareRight.displayTotal}}</text>
          <text class="cmp-label">队长</text>
          <text>{{compareLeft.captainName || '-'}}</text>
          <text>{{compareRight.captainName || '-'}}</text>
          <text class="cmp-label">开卡</text>
          <text>{{compareLeft.chipCode || '无'}}</text>
          <text>{{compareRight.chipCode || '无'}}</text>
          <text class="cmp-label">上场</text>
          <text>{{compareLeft.playedText}}</text>
          <text>{{compareRight.playedText}}</text>
          <text class="cmp-label">扣分</text>
          <text>{{compareLeft.displayHit || '—'}}</text>
          <text>{{compareRight.displayHit || '—'}}</text>
        </view>

        <view class="cmp-lineup">
          <view class="cmp-lineup-head">
            <text class="cmp-lineup-title">阵容</text>
            <text class="cmp-lineup-count">{{compareLeftPickCount}}/15 · {{compareRightPickCount}}/15</text>
          </view>
          <block wx:if="{{compareLineupRows.length}}">
            <block wx:for="{{compareLineupRows}}" wx:key="slot">
              <view wx:if="{{item.sectionLabel}}" class="cmp-lineup-section">
                <view class="cmp-lineup-rule"></view>
                <text>{{item.sectionLabel}}</text>
                <view class="cmp-lineup-rule"></view>
              </view>
              <view class="cmp-lineup-row {{item.bench ? 'bench' : ''}}">
                <view wx:if="{{item.left}}" class="cmp-pick cmp-pick-left">
                  <view class="cmp-pick-primary">
                    <text class="cmp-pick-name">{{item.left.name}}</text>
                    <text wx:if="{{item.left.role}}" class="cmp-pick-role">{{item.left.role}}</text>
                  </view>
                  <view class="cmp-pick-meta">
                    <text class="cmp-pick-detail">{{item.left.meta || '-'}}</text>
                    <text class="cmp-pick-points">{{item.left.pointsText}}</text>
                  </view>
                </view>
                <view wx:else class="cmp-pick-empty">—</view>
                <text class="cmp-slot">{{item.slotLabel}}</text>
                <view wx:if="{{item.right}}" class="cmp-pick">
                  <view class="cmp-pick-primary">
                    <text class="cmp-pick-name">{{item.right.name}}</text>
                    <text wx:if="{{item.right.role}}" class="cmp-pick-role">{{item.right.role}}</text>
                  </view>
                  <view class="cmp-pick-meta">
                    <text class="cmp-pick-detail">{{item.right.meta || '-'}}</text>
                    <text class="cmp-pick-points">{{item.right.pointsText}}</text>
                  </view>
                </view>
                <view wx:else class="cmp-pick-empty">—</view>
              </view>
            </block>
          </block>
          <view wx:else class="cmp-lineup-empty">本轮阵容尚未同步</view>
        </view>
      </scroll-view>
    </view>
  </view>
  <view wx:if="{{filterSheetOpen}}" class="flt-root">
    <view class="flt-mask" bindtap="onCloseFilterSheet"></view>
    <view class="flt-sheet">
      <view class="flt-head">
        <view class="flt-title">筛选</view>
        <text class="flt-clear" bindtap="onClearAllFilters" hover-class="hover-dim">清除全部</text>
      </view>
      <scroll-view scroll-y class="flt-body">
        <view wx:if="{{filterOptionsLoading}}" class="filter-options-status">正在加载球员筛选选项…</view>
        <view wx:elif="{{filterOptionsError}}" class="filter-options-status error">{{filterOptionsError}}</view>
        <view class="filter-section flt-first">
          <view class="filter-section-head">
            <text class="filter-section-title">Chip</text>
            <text class="filter-section-summary">{{chipFilters.length ? chipFilters.join('、') : '未筛选'}}</text>
          </view>
          <view class="filter-tags">
            <view
              wx:for="{{chipOptions}}"
              wx:key="value"
              class="filter-tag {{item.on ? 'on' : ''}}"
              data-value="{{item.value}}"
              bindtap="onToggleChip"
              hover-class="hover-dim"
            >{{item.label}}</view>
          </view>
        </view>

        <view class="filter-section">
          <view class="filter-section-head">
            <text class="filter-section-title">队长</text>
            <text class="filter-section-summary">{{captainFilterNames.length ? captainFilterNames.join('、') : '未筛选'}}</text>
          </view>
          <view class="filter-tags">
            <view
              wx:for="{{captainOptions}}"
              wx:key="element"
              class="filter-tag {{item.on ? 'on' : ''}}"
              data-element="{{item.element}}"
              bindtap="onToggleCaptain"
              hover-class="hover-dim"
            >{{item.name}}</view>
          </view>
        </view>

        <view class="filter-section">
          <view class="filter-section-head">
            <text class="filter-section-title">球员持有</text>
            <text class="filter-section-summary">{{ownershipSummary}}{{ownershipMatchedText}}</text>
          </view>
          <view class="ownership-search">
            <input
              class="ownership-search-input"
              placeholder="输入球员名字搜索"
              placeholder-class="ownership-search-ph"
              value="{{ownershipSearch}}"
              confirm-type="search"
              bindinput="onOwnershipSearchInput"
            />
          </view>
          <view wx:if="{{ownershipSearchResults.length}}" class="ownership-results">
            <view
              wx:for="{{ownershipSearchResults}}"
              wx:key="element"
              class="ownership-result"
              data-element="{{item.element}}"
              bindtap="onOwnershipSearchPick"
              hover-class="hover-dim"
            >
              <text class="ownership-result-name">{{item.name}}</text>
              <text class="ownership-result-meta">{{item.meta}}</text>
            </view>
          </view>
          <view wx:elif="{{ownershipSearch}}" class="ownership-empty">赛事阵容里无匹配球员</view>
          <view class="ownership-picker-grid">
            <picker mode="selector" range="{{ownershipTeamNames}}" value="{{selectedOwnershipTeamIndex}}" bindchange="onOwnershipTeamChange">
              <view class="filter-picker">{{selectedOwnershipTeam ? selectedOwnershipTeam.name : '先选球队'}}</view>
            </picker>
            <picker mode="selector" range="{{ownershipPositionOptions}}" value="{{selectedOwnershipPositionIndex}}" bindchange="onOwnershipPositionChange">
              <view class="filter-picker {{selectedOwnershipTeam ? '' : 'disabled'}}">{{selectedOwnershipPosition || '再选位置'}}</view>
            </picker>
          </view>
          <picker mode="selector" range="{{ownershipAvailablePlayerNames}}" bindchange="onOwnershipPlayerChange">
            <view class="filter-picker {{selectedOwnershipPosition ? '' : 'disabled'}}">{{selectedOwnershipPosition ? '选择球员' : '先选择球队和位置'}}</view>
          </picker>
          <view wx:if="{{selectedOwnershipPlayers.length}}" class="selected-tags">
            <view
              wx:for="{{selectedOwnershipPlayers}}"
              wx:key="element"
              class="selected-tag"
              data-element="{{item.element}}"
              bindtap="onRemoveOwnershipPlayer"
              hover-class="hover-dim"
            >{{item.name}}{{item.meta ? ' · ' + item.meta : ''}} ×</view>
          </view>
          <view class="segmented">
            <view class="segment {{ownershipScope === 'any' ? 'active' : ''}}" data-scope="any" bindtap="onOwnershipScopeTap" hover-class="hover-dim">全部</view>
            <view class="segment {{ownershipScope === 'starter' ? 'active' : ''}}" data-scope="starter" bindtap="onOwnershipScopeTap" hover-class="hover-dim">首发</view>
            <view class="segment {{ownershipScope === 'bench' ? 'active' : ''}}" data-scope="bench" bindtap="onOwnershipScopeTap" hover-class="hover-dim">替补</view>
          </view>
          <view class="segmented">
            <view class="segment {{ownershipCaptainMode === 'any' ? 'active' : ''}}" data-mode="any" bindtap="onOwnershipCaptainTap" hover-class="hover-dim">任意</view>
            <view class="segment {{ownershipCaptainMode === 'captain' ? 'active' : ''}}" data-mode="captain" bindtap="onOwnershipCaptainTap" hover-class="hover-dim">队长</view>
            <view class="segment {{ownershipCaptainMode === 'vice' ? 'active' : ''}}" data-mode="vice" bindtap="onOwnershipCaptainTap" hover-class="hover-dim">副队</view>
          </view>
          <view wx:if="{{selectedOwnershipPlayers.length}}" class="filter-clear" bindtap="onClearOwnershipFilter" hover-class="hover-dim">清除球员持有筛选</view>
        </view>

        <view class="filter-section">
          <view class="filter-section-head">
            <text class="filter-section-title">球队人数</text>
            <text class="filter-section-summary">{{teamExposureSummary}}{{teamExposureMatchedText}}</text>
          </view>
          <view class="ownership-picker-grid">
            <picker mode="selector" range="{{teamExposureTeamNames}}" value="{{pendingExposureTeamIndex}}" bindchange="onTeamExposureTeamChange">
              <view class="filter-picker">{{pendingExposureTeam ? pendingExposureTeam.name : '选择球队'}}</view>
            </picker>
            <picker mode="selector" range="{{teamExposureCountNames}}" bindchange="onTeamExposureCountChange">
              <view class="filter-picker {{pendingExposureTeam ? '' : 'disabled'}}">{{pendingExposureTeam ? '恰好人数' : '先选球队'}}</view>
            </picker>
          </view>
          <view wx:if="{{teamExposureRules.length}}" class="selected-tags">
            <view
              wx:for="{{teamExposureRules}}"
              wx:key="teamShortName"
              class="selected-tag"
              data-shortname="{{item.teamShortName}}"
              bindtap="onRemoveTeamExposureRule"
              hover-class="hover-dim"
            >{{item.name}} · 恰好{{item.count}}人 ×</view>
          </view>
          <view class="segmented">
            <view class="segment {{teamExposureScope === 'any' ? 'active' : ''}}" data-scope="any" bindtap="onTeamExposureScopeTap" hover-class="hover-dim">全部</view>
            <view class="segment {{teamExposureScope === 'starter' ? 'active' : ''}}" data-scope="starter" bindtap="onTeamExposureScopeTap" hover-class="hover-dim">首发</view>
            <view class="segment {{teamExposureScope === 'bench' ? 'active' : ''}}" data-scope="bench" bindtap="onTeamExposureScopeTap" hover-class="hover-dim">替补</view>
          </view>
          <view wx:if="{{teamExposureRules.length}}" class="filter-clear" bindtap="onClearTeamExposureFilter" hover-class="hover-dim">清除球队人数筛选</view>
        </view>
      </scroll-view>
      <view class="flt-foot">
        <view class="flt-done" bindtap="onCloseFilterSheet" hover-class="hover-dim">完成</view>
      </view>
    </view>
  </view>
  <view wx:if="{{detailOpen}}" class="flt-root">
    <view class="flt-mask" bindtap="onCloseTournamentDetail"></view>
    <view class="flt-sheet">
      <view class="flt-head">
        <view class="flt-title">赛事信息</view>
        <text class="flt-clear" bindtap="onCloseTournamentDetail" hover-class="hover-dim">关闭</text>
      </view>
      <scroll-view scroll-y class="flt-body">
        <view wx:if="{{detailLoading}}" class="filter-options-status">正在加载赛事信息…</view>
        <view wx:elif="{{detailError}}" class="filter-options-status error">{{detailError}}</view>
        <block wx:else>
          <view class="filter-section flt-first">
            <view class="filter-section-head">
              <text class="filter-section-title">概览</text>
            </view>
            <view class="detail-grid">
              <view class="detail-item">
                <text class="detail-label">创建者</text>
                <text class="detail-value">{{detailCreator}}</text>
              </view>
              <view class="detail-item">
                <text class="detail-label">联赛类型</text>
                <text class="detail-value">{{detailLeagueTypeText}}</text>
              </view>
              <view class="detail-item">
                <text class="detail-label">参赛球队数</text>
                <text class="detail-value">{{detailParticipantCountText}}</text>
              </view>
            </view>
          </view>

          <view class="filter-section">
            <view class="filter-section-head">
              <text class="filter-section-title">赛事规则</text>
            </view>
            <view class="detail-rules">
              <view class="detail-rule">小组赛：{{detailGroupModeText}}</view>
              <view class="detail-rule">每组球队数：{{detailGroupTeamNumText}}</view>
              <view class="detail-rule">小组数：{{detailGroupNumText}}</view>
              <view class="detail-rule">小组赛轮次：{{detailGroupEventsText}}</view>
              <view class="detail-rule">淘汰赛：{{detailKnockoutModeText}}</view>
              <block wx:if="{{detailKnockout}}">
                <view class="detail-rule">淘汰赛球队数：{{detailKnockoutTeamNumText}}</view>
                <view class="detail-rule">淘汰赛轮数：{{detailKnockoutRoundsText}}</view>
                <view class="detail-rule">淘汰赛轮次：{{detailKnockoutEventsText}}</view>
              </block>
            </view>
          </view>

          <view class="filter-section">
            <view class="filter-section-head">
              <text class="filter-section-title">参赛名单</text>
              <text class="filter-section-summary">{{detailRosterCountText}}</text>
            </view>
            <view wx:if="{{detailRosterUnavailable}}" class="roster-empty">参赛名单暂不可用</view>
            <block wx:else>
              <view wx:if="{{detailRosterSearchable}}" class="ownership-search">
                <input
                  class="ownership-search-input"
                  placeholder="按球队或经理搜索…"
                  placeholder-class="ownership-search-ph"
                  value="{{detailRosterKeyword}}"
                  confirm-type="search"
                  bindinput="onDetailRosterSearchInput"
                />
              </view>
              <view class="roster-list">
                <view
                  wx:for="{{detailRosterRows}}"
                  wx:key="entryId"
                  class="roster-row {{item.isMe ? 'me' : ''}}"
                  data-entry-id="{{item.entryId}}"
                  bindtap="onOpenDetailRosterEntry"
                  hover-class="hover-dim"
                >
                  <view class="roster-names">
                    <text class="roster-name">{{item.entryName}}</text>
                    <text wx:if="{{item.isMe}}" class="me-badge">我</text>
                  </view>
                  <text wx:if="{{item.playerName}}" class="roster-player">{{item.playerName}}</text>
                </view>
                <view wx:if="{{detailRosterRows.length === 0}}" class="roster-empty">{{detailRosterKeyword ? '没有球队符合搜索条件。' : '暂无参赛名单'}}</view>
              </view>
              <view wx:if="{{detailRosterShownText}}" class="roster-foot">{{detailRosterShownText}}</view>
              <view class="roster-actions">
                <text wx:if="{{detailRosterMoreText}}" class="action" bindtap="onDetailRosterMore" hover-class="hover-dim">{{detailRosterMoreText}}</text>
                <text wx:if="{{detailRosterAllText}}" class="action" bindtap="onDetailRosterAll" hover-class="hover-dim">{{detailRosterAllText}}</text>
                <text wx:if="{{detailRosterCanCollapse}}" class="action-muted" bindtap="onDetailRosterCollapse" hover-class="hover-dim">收起</text>
              </view>
            </block>
          </view>
        </block>
      </scroll-view>
    </view>
  </view>
  <copy-fallback show="{{shareSheetOpen}}" text="{{shareText}}" bind:close="onCloseShareSheet" />
  <bottomNavBar active="live" />
</view>
