/* Flush-inner cards — extend global .card, inner rows own the padding */
.picker-card {
  overflow: hidden;
  padding: 0;
}

.picker-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 24rpx;
}

.picker-label {
  color: var(--muted-ink);
  font-size: 22rpx;
}

.picker-value {
  margin-top: 6rpx;
  color: var(--ink);
  font-size: 28rpx;
  font-weight: 800;
}

.picker-arrow {
  flex-shrink: 0;
  color: var(--green-ink);
  font-size: 24rpx;
  font-weight: 800;
}

.sort-tabs {
  display: flex;
  gap: 12rpx;
  overflow-x: auto;
  white-space: nowrap;
}

.sort-tab {
  flex-shrink: 0;
  padding: 12rpx 18rpx;
  border: 1rpx solid var(--line);
  border-radius: 10rpx;
  background: var(--card);
  color: var(--muted-ink);
  font-size: 22rpx;
  font-weight: 700;
}

.sort-tab.active {
  border-color: var(--plum);
  background: var(--plum);
  color: var(--chalk);
}

.filter-panel {
  overflow: hidden;
  padding: 0;
}

.filter-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 22rpx 24rpx;
}

.filter-title {
  color: var(--ink);
  font-size: 26rpx;
  font-weight: 900;
}

.filter-summary {
  max-width: 520rpx;
  margin-top: 6rpx;
  overflow: hidden;
  color: var(--muted-ink);
  font-size: 22rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.filter-toggle {
  flex-shrink: 0;
  color: var(--green-ink);
  font-size: 22rpx;
  font-weight: 800;
}

.filter-body {
  padding: 0 24rpx 22rpx;
  border-top: 1rpx solid var(--line);
}

.filter-picker {
  margin-top: 18rpx;
  padding: 18rpx 20rpx;
  border: 1rpx solid var(--line);
  border-radius: 12rpx;
  background: var(--track);
  color: var(--ink);
  font-size: 24rpx;
  font-weight: 800;
}

.filter-picker.disabled {
  color: var(--muted-ink);
}

.ownership-picker-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12rpx;
}

.selected-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}

.selected-tag {
  max-width: 100%;
  padding: 10rpx 14rpx;
  overflow: hidden;
  border-radius: 8rpx;
  background: var(--accent-tint);
  color: var(--green-ink);
  font-size: 22rpx;
  font-weight: 800;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* Segmented control — web Tabs pattern (muted track, white active) */
.segmented {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 8rpx;
  margin-top: 16rpx;
  padding: 6rpx;
  border-radius: 12rpx;
  background: var(--track);
}

.segment {
  min-width: 0;
  padding: 12rpx 8rpx;
  border-radius: 8rpx;
  color: var(--muted-ink);
  font-size: 22rpx;
  font-weight: 800;
  text-align: center;
}

.segment.active {
  background: var(--card);
  color: var(--ink);
  box-shadow: 0 2rpx 6rpx var(--plum-a8);
}

.filter-clear {
  margin-top: 16rpx;
  color: var(--danger);
  font-size: 22rpx;
  font-weight: 800;
  text-align: right;
}

.result-count {
  margin-bottom: 14rpx;
  color: var(--muted-ink);
  font-size: 22rpx;
  font-weight: 700;
}

.tournament-row {
  display: grid;
  grid-template-columns: 72rpx 1fr 112rpx;
  gap: 18rpx;
  align-items: center;
  margin-bottom: 16rpx;
}

.tournament-rank {
  color: var(--green-ink);
  font-size: 26rpx;
  font-weight: 900;
}

.tournament-main {
  min-width: 0;
}

.tournament-title,
.tournament-subtitle,
.tournament-meta {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.tournament-title {
  color: var(--ink);
  font-size: 28rpx;
  font-weight: 800;
}

.tournament-subtitle {
  margin-top: 4rpx;
  color: var(--ink);
  font-size: 22rpx;
}

.tournament-meta {
  margin-top: 8rpx;
  color: var(--muted-ink);
  font-size: 20rpx;
}

.tournament-score {
  text-align: right;
}

.score-main {
  color: var(--ink);
  font-size: 34rpx;
  font-weight: 900;
}

.score-sub {
  margin-top: 4rpx;
  color: var(--muted-ink);
  font-size: 20rpx;
}

.load-more {
  padding: 22rpx;
  color: var(--green-ink);
  font-size: 24rpx;
  font-weight: 800;
  text-align: center;
}

.manage-hint {
  margin-top: 8rpx;
  text-align: center;
  color: var(--green-ink);
  font-size: 24rpx;
  font-weight: 700;
}
