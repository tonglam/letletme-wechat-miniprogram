.live-hero {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  padding: 28rpx 0 8rpx;
}

.eyebrow {
  margin-bottom: 10rpx;
  color: #047857;
  font-size: 20rpx;
  font-weight: 800;
  letter-spacing: 0;
}

.gw-pill {
  flex-shrink: 0;
  padding: 10rpx 16rpx;
  border-radius: 8rpx;
  background: #111827;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 800;
}

.entry-strip {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 24rpx;
  border-radius: 8rpx;
  box-sizing: border-box;
}

.entry-strip.ready {
  background: #ecfdf3;
  color: #065f46;
}

.entry-strip.empty {
  background: #fff7ed;
  color: #9a3412;
}

.strip-label {
  font-size: 22rpx;
  font-weight: 700;
}

.strip-value {
  margin-top: 4rpx;
  font-size: 28rpx;
  font-weight: 800;
}

.strip-action {
  font-size: 24rpx;
  font-weight: 800;
}

.live-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
  border: 1rpx solid #eef2f7;
  box-shadow: 0 12rpx 32rpx rgba(15, 23, 42, 0.06);
}

.card-meta {
  margin-bottom: 8rpx;
  color: #047857;
  font-size: 20rpx;
  font-weight: 800;
}

.card-title {
  font-size: 30rpx;
  font-weight: 700;
}

.card-desc {
  margin-top: 8rpx;
  color: #667085;
  font-size: 24rpx;
}

.card-side {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  flex-shrink: 0;
  margin-left: 20rpx;
}

.status-pill {
  padding: 6rpx 10rpx;
  border-radius: 6rpx;
  background: #f2f4f7;
  color: #344054;
  font-size: 20rpx;
  font-weight: 700;
}

.open-arrow {
  margin-top: 16rpx;
  color: #111827;
  font-size: 44rpx;
  line-height: 36rpx;
}
