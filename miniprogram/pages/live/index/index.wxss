.live-hero {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  padding: 28rpx 0 8rpx;
}

.live-hero .chyron {
  margin-bottom: 12rpx;
}

.live-hero .gw-pill-dark {
  flex-shrink: 0;
}

.entry-strip {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 24rpx;
  border-radius: 12rpx;
  box-sizing: border-box;
}

.entry-strip.ready {
  background: var(--accent-tint);
  color: var(--green-ink);
}

.entry-strip.empty {
  background: var(--warning-tint);
  color: var(--warning);
}

.strip-label {
  font-size: 22rpx;
  font-weight: 700;
}

.strip-value {
  margin-top: 4rpx;
  font-size: 28rpx;
  font-weight: 800;
}

.strip-action {
  font-size: 24rpx;
  font-weight: 800;
}

.entry-lookup-notice {
  margin: -8rpx 0 20rpx;
  padding: 14rpx 18rpx;
  border-radius: 10rpx;
  background: var(--warning-tint);
  color: var(--warning);
  font-size: 22rpx;
  line-height: 1.5;
}

.entry-lookup-action {
  min-width: 176rpx;
  margin: 14rpx 0 0;
  padding: 10rpx 20rpx;
  border: 1rpx solid var(--warning-a45);
  border-radius: 12rpx;
  background: var(--card);
  color: var(--ink);
  font-size: 22rpx;
  line-height: 1.4;
}

.live-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.card-meta {
  margin-bottom: 8rpx;
  color: var(--green-ink);
  font-size: 20rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
}

.card-title {
  font-size: 30rpx;
  font-weight: 700;
}

.card-desc {
  margin-top: 8rpx;
  color: var(--muted-ink);
  font-size: 24rpx;
}

.card-side {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  flex-shrink: 0;
  margin-left: 20rpx;
}

.status-pill {
  padding: 6rpx 10rpx;
  border-radius: 6rpx;
  background: var(--track);
  color: var(--ink);
  font-size: 20rpx;
  font-weight: 700;
}

.open-arrow {
  margin-top: 16rpx;
  color: var(--plum);
  font-size: 48rpx;
  line-height: 36rpx;
}
