.live-hero {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  padding: 28rpx 0 8rpx;
}

.live-hero .chyron {
  margin-bottom: 12rpx;
}

.gw-pill {
  flex-shrink: 0;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  background: var(--plum, #38003c);
  color: var(--electric, #00ff85);
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.entry-strip {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 24rpx;
  border-radius: 12rpx;
  box-sizing: border-box;
}

.entry-strip.ready {
  background: var(--accent-tint, #dcf6ea);
  color: var(--green-ink, #008545);
}

.entry-strip.empty {
  background: var(--warning-tint, #f6ead9);
  color: var(--warning, #924a07);
}

.strip-label {
  font-size: 22rpx;
  font-weight: 700;
}

.strip-value {
  margin-top: 4rpx;
  font-size: 28rpx;
  font-weight: 800;
}

.strip-action {
  font-size: 24rpx;
  font-weight: 800;
}

.live-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.card-meta {
  margin-bottom: 8rpx;
  color: var(--green-ink, #008545);
  font-size: 20rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
}

.card-title {
  font-size: 30rpx;
  font-weight: 700;
}

.card-desc {
  margin-top: 8rpx;
  color: var(--muted-ink, #6e5a72);
  font-size: 24rpx;
}

.card-side {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  flex-shrink: 0;
  margin-left: 20rpx;
}

.status-pill {
  padding: 6rpx 10rpx;
  border-radius: 6rpx;
  background: var(--track, #f1efe9);
  color: var(--ink, #301333);
  font-size: 20rpx;
  font-weight: 700;
}

.open-arrow {
  margin-top: 16rpx;
  color: var(--plum, #38003c);
  font-size: 44rpx;
  line-height: 36rpx;
}
