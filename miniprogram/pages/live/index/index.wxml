<view class="page page-tabbar">
  <view class="section live-hero">
    <view>
      <view class="chyron">{{currentGw ? 'LIVE CENTRE' : '赛季准备中'}}</view>
      <view class="subtitle">{{currentGw ? '比赛进行时追踪球队、比赛和赛事。' : '开赛后可追踪实时阵容、比赛和赛事。'}}</view>
    </view>
    <view class="gw-pill-dark">{{currentGw ? 'GW ' + currentGw : (event ? '下轮 GW ' + event : '-')}}</view>
  </view>

  <view id="{{contextResolved ? 'perf-primary-content' : ''}}" wx:if="{{contextResolved}}" class="section entry-strip {{entryId ? 'ready' : 'empty'}}" bindtap="onOpenEntryStrip" hover-class="hover-dim">
    <view>
      <view class="strip-label">{{entryId ? '当前球队' : '还没有我的球队'}}</view>
      <view wx:if="{{entryId}}" class="strip-value">{{entryName || ('Entry #' + entryId)}}</view>
      <view wx:else class="strip-value">查找球队并设为我的球队</view>
    </view>
    <text class="strip-action">{{entryId ? '查看' : '选择'}}</text>
  </view>
  <view wx:if="{{entryId && entryLookupMessage}}" class="entry-lookup-notice" role="status">
    <view>{{entryLookupMessage}}</view>
    <button wx:if="{{entryLookupRetryable}}" class="entry-lookup-action" bindtap="onRetryEntryIdentity">重试球队查询</button>
    <button wx:else class="entry-lookup-action" bindtap="onChangeEntry">更换球队</button>
  </view>

  <view wx:for="{{cards}}" wx:key="url" class="card live-card" data-url="{{item.url}}" bindtap="onOpenCard" hover-class="hover-dim">
    <view>
      <view class="card-meta">{{item.meta}}</view>
      <view class="card-title">{{item.title}}</view>
      <view class="card-desc">{{item.description}}</view>
    </view>
    <view class="card-side">
      <text class="status-pill">{{item.status}}</text>
      <text class="open-arrow">›</text>
    </view>
  </view>
  <bottomNavBar active="live" />
</view>
