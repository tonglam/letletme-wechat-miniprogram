.page {
  padding-bottom: 168rpx;
}

.match-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
  margin-bottom: 22rpx;
}

.match-count {
  flex-shrink: 0;
  min-width: 112rpx;
  padding: 14rpx 16rpx;
  border: 1rpx solid var(--line, #ddd4de);
  border-radius: 12rpx;
  background: var(--card, #ffffff);
  text-align: center;
}

.match-count-number {
  display: block;
  color: var(--ink, #301333);
  font-size: 34rpx;
  font-weight: 900;
  line-height: 40rpx;
}

.match-count-label {
  display: block;
  margin-top: 2rpx;
  color: var(--muted-ink, #6e5a72);
  font-size: 20rpx;
  font-weight: 700;
}

.status-tabs {
  position: sticky;
  top: 0;
  z-index: 5;
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 8rpx;
  margin: 0 -4rpx 24rpx;
  padding: 8rpx 4rpx;
  background: var(--bg, #f9f8f4);
}

.status-tab {
  min-width: 0;
  padding: 16rpx 6rpx;
  border: 1rpx solid var(--line, #ddd4de);
  border-radius: 10rpx;
  background: var(--card, #ffffff);
  color: var(--muted-ink, #6e5a72);
  font-size: 22rpx;
  font-weight: 800;
  line-height: 28rpx;
  text-align: center;
}

.status-tab.active {
  border-color: var(--plum, #38003c);
  background: var(--plum, #38003c);
  color: var(--chalk, #f9f7f2);
}

.match-content {
  margin-bottom: 24rpx;
}

.match-group {
  margin-bottom: 28rpx;
}

.group-title {
  margin: 0 0 14rpx;
  color: var(--muted-ink, #6e5a72);
  font-size: 22rpx;
  font-weight: 900;
  letter-spacing: 2rpx;
}

.match-card {
  position: relative;
  margin-bottom: 18rpx;
  padding: 22rpx;
  border: 1rpx solid var(--line, #ddd4de);
  border-left: 8rpx solid var(--muted-ink, #6e5a72);
  border-radius: 16rpx;
  background: var(--card, #ffffff);
  box-shadow: 0 2rpx 8rpx rgba(56, 0, 60, 0.04);
  box-sizing: border-box;
}

/* Status edge colours — aligned to web semantics */
.match-card.status-playing {
  border-left-color: var(--green-ink, #008545);
}

.match-card.status-finished {
  border-left-color: var(--muted-ink, #6e5a72);
}

.match-card.status-waiting {
  border-left-color: var(--info, #82208a);
}

.match-card.status-next {
  border-left-color: var(--warning, #924a07);
}

.match-card-head {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 18rpx;
}

.status-pill {
  flex-shrink: 0;
  padding: 6rpx 12rpx;
  border-radius: 8rpx;
  background: var(--track, #f1efe9);
  color: var(--ink, #301333);
  font-size: 20rpx;
  font-weight: 900;
  line-height: 28rpx;
}

.status-playing .status-pill {
  background: var(--accent-tint, #dcf6ea);
  color: var(--green-ink, #008545);
}

.status-finished .status-pill {
  background: var(--track, #f1efe9);
  color: var(--muted-ink, #6e5a72);
}

.status-waiting .status-pill {
  background: #f0e3f2;
  color: var(--info, #82208a);
}

.status-next .status-pill {
  background: var(--warning-tint, #f6ead9);
  color: var(--warning, #924a07);
}

.scoregrid {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 132rpx minmax(0, 1fr);
  align-items: center;
  gap: 16rpx;
}

.team-side {
  min-width: 0;
}

.team-side.away {
  text-align: right;
}

.team-name {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: var(--ink, #301333);
  font-size: 28rpx;
  font-weight: 900;
  line-height: 36rpx;
}

.scoreline {
  min-height: 84rpx;
  padding: 8rpx 6rpx;
  border-radius: 10rpx;
  background: var(--track, #f1efe9);
  box-sizing: border-box;
  text-align: center;
}

.score {
  color: var(--ink, #301333);
  font-size: 36rpx;
  font-weight: 900;
  line-height: 44rpx;
}

.minute {
  margin-top: 2rpx;
  color: var(--green-ink, #008545);
  font-size: 20rpx;
  font-weight: 900;
  line-height: 26rpx;
}

.event-list {
  margin-top: 20rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--line, #ddd4de);
}

.event-title {
  margin-bottom: 8rpx;
  color: var(--ink, #301333);
  font-size: 22rpx;
  font-weight: 900;
}

.event-row {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  padding: 8rpx 0;
  font-size: 22rpx;
  line-height: 30rpx;
}

.event-label {
  flex-shrink: 0;
  width: 72rpx;
  color: var(--ink, #301333);
  font-weight: 900;
}

.event-value {
  min-width: 0;
  color: var(--muted-ink, #6e5a72);
  word-break: break-all;
}
