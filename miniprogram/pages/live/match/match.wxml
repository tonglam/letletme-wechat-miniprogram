<view class="page page-tabbar">
  <block wx:if="{{!scheduleEmpty}}">
    <view class="match-toolbar">
      <view class="match-toolbar-status">
        <live-status-bar compact="{{true}}" state="{{displayState}}" lastChecked="{{lastUpdated}}" bind:refresh="onRetry" />
      </view>
      <view class="match-count match-count-{{status}}">
        <text class="match-count-number">{{matches.length}}</text>
        <text class="match-count-label">{{activeStatusLabel}}</text>
      </view>
    </view>

    <view class="status-tabs">
      <view
        wx:for="{{statusTabs}}"
        wx:key="key"
        class="status-tab {{status === item.key ? 'active' : ''}}"
        data-status="{{item.key}}"
        bindtap="onStatusTap"
        hover-class="hover-dim"
      >{{item.label}} <text class="status-tab-count">{{item.count}}</text></view>
    </view>
  </block>

  <view wx:if="{{error && !hasData}}" id="perf-primary-content">
    <app-error-state message="{{error}}" workload="{{errorWorkload}}" bind:retry="onRetry" />
  </view>
  <app-loading wx:elif="{{loading && !hasData}}" text="加载比赛" />
  <view wx:elif="{{scheduleEmpty}}" id="perf-primary-content" class="section">
    <app-empty-state
      eyebrow="赛季准备中"
      title="当前赛季暂无赛程"
      description="赛程公布后，这里会显示比赛状态和比分"
      actionText="重新检查"
      featured="{{true}}"
      bind:action="onRetry"
    />
  </view>
  <view wx:else id="perf-primary-content" class="match-content">
    <data-status wx:if="{{fixtureStaleMessage}}" status="stale" message="{{fixtureStaleMessage}}" workload="fixtures" transient="{{true}}" showRetry="{{true}}" bind:retry="onRetry" />
    <data-status wx:elif="{{error}}" status="stale" message="{{error}}，当前显示上次成功结果" workload="{{errorWorkload}}" transient="{{true}}" showRetry="{{true}}" bind:retry="onRetry" />
    <app-empty-state
      wx:if="{{matches.length === 0}}"
      title="当前没有{{activeStatusLabel}}的比赛"
      description="{{emptyDescription}}"
      actionText="重新加载"
      bind:action="onRetry"
    />
    <view wx:for="{{groups}}" wx:key="title" class="match-group">
      <view class="group-title">{{item.title}}</view>
      <view wx:for="{{item.matches}}" wx:for-item="match" wx:key="matchId" class="card match-card {{match.statusClass}}">
        <view class="match-card-head">
          <view class="status-pill">{{match.statusText}}</view>
          <view class="match-card-actions">
            <view
              class="tool-btn tool-btn-labeled {{copiedMatchId === match.matchId ? 'done' : ''}}"
              data-matchid="{{match.matchId}}"
              catchtap="onCopyMatchShare"
              hover-class="hover-dim"
            >
              <image wx:if="{{copiedMatchId === match.matchId}}" class="tool-icon" src="/assets/icons/check.svg" mode="aspectFit" />
              <image wx:else class="tool-icon" src="/assets/icons/copy.svg" mode="aspectFit" />
              <text class="tool-label">{{copiedMatchId === match.matchId ? '已复制' : '分享文字'}}</text>
            </view>
            <view
              class="tool-btn tool-btn-labeled {{sharingImageMatchId === match.matchId ? 'on' : ''}} {{sharedImageMatchId === match.matchId ? 'done' : ''}}"
              data-matchid="{{match.matchId}}"
              catchtap="onShareMatchImage"
              hover-class="hover-dim"
            >
              <image wx:if="{{sharedImageMatchId === match.matchId}}" class="tool-icon" src="/assets/icons/check.svg" mode="aspectFit" />
              <image wx:else class="tool-icon" src="/assets/icons/image.svg" mode="aspectFit" />
              <text class="tool-label">{{sharingImageMatchId === match.matchId ? '生成中' : sharedImageMatchId === match.matchId ? '已打开' : '分享图片'}}</text>
            </view>
          </view>
        </view>

        <view class="scoregrid">
          <view class="team-side">
            <view class="team-name">{{match.homeTeamDisplay || '-'}}</view>
          </view>
          <view class="scoreline">
            <view class="score">{{match.scoreText}}</view>
            <view wx:if="{{match.minuteText}}" class="minute">{{match.minuteText}}</view>
          </view>
          <view class="team-side away">
            <view class="team-name">{{match.awayTeamDisplay || '-'}}</view>
          </view>
        </view>

        <view wx:if="{{match.eventSummary.length > 0}}" class="event-list">
          <view class="event-title">比赛事件</view>
          <view
            wx:for="{{match.eventSummary}}"
            wx:for-item="event"
            wx:key="kind"
            class="hl-row"
          >
            <view class="hl-badge hl-badge-{{event.kind}}">
              <view wx:if="{{event.kind === 'yellow' || event.kind === 'red'}}" class="card-glyph card-{{event.kind}}"></view>
              <image wx:else class="hl-icon" src="/assets/icons/hl-{{event.kind}}.svg" mode="aspectFit" />
            </view>
            <text class="hl-label hl-label-{{event.kind}}">{{event.label}}</text>
            <view class="hl-items">
              <view wx:for="{{event.items}}" wx:for-item="chip" wx:key="key" class="hl-item">
                <text class="hl-name">{{chip.name}}</text>
                <text wx:if="{{chip.team}}" class="hl-team">({{chip.team}})</text>
                <text wx:if="{{chip.display}}" class="hl-val hl-val-{{event.kind}}">{{chip.display}}</text>
              </view>
            </view>
          </view>
        </view>

        <view wx:if="{{match.statusText !== '未开始'}}" class="match-player-section">
          <view
            class="match-player-toggle"
            data-matchid="{{match.matchId}}"
            bindtap="onToggleMatchPlayers"
            hover-class="hover-dim"
          >
            <view>
              <view class="match-player-title">球员详细数据</view>
              <view class="match-player-subtitle">点击球员可查看得分明细</view>
            </view>
            <text class="match-player-toggle-label">{{expandedMatchId === match.matchId ? '收起' : '展开'}}</text>
          </view>

          <view wx:if="{{expandedMatchId === match.matchId}}" class="match-player-panel">
            <view class="match-player-tabs">
              <view
                class="match-player-tab {{expandedTeam === 'home' ? 'active' : ''}}"
                data-team="home"
                bindtap="onMatchPlayerTeam"
                hover-class="hover-dim"
              >{{match.homeTeamDisplay || match.homeTeamName || '主队'}} <text class="match-player-count">{{match.homeMatchPlayers.length}}</text></view>
              <view
                class="match-player-tab {{expandedTeam === 'away' ? 'active' : ''}}"
                data-team="away"
                bindtap="onMatchPlayerTeam"
                hover-class="hover-dim"
              >{{match.awayTeamDisplay || match.awayTeamName || '客队'}} <text class="match-player-count">{{match.awayMatchPlayers.length}}</text></view>
            </view>

            <view wx:if="{{expandedTeam === 'home'}}" class="match-player-list">
              <view wx:if="{{match.homeMatchPlayers.length === 0}}" class="match-player-empty">暂无主队实时球员数据</view>
              <view
                wx:for="{{match.homeMatchPlayers}}"
                wx:for-item="player"
                wx:key="element"
                class="match-player-row"
                data-matchid="{{match.matchId}}"
                data-element="{{player.element}}"
                bindtap="onOpenMatchPlayer"
                hover-class="hover-dim"
              >
                <view class="match-player-row-head">
                  <text class="match-player-name">{{player.webName || player.name || '-'}}</text>
                  <text class="match-player-points">{{player.totalPoints || player.points || player.livePoints || 0}}</text>
                </view>
                <view class="match-player-stats">
                  <text>分钟 {{player.minutes || 0}}</text>
                  <text>进球 {{player.goalsScored || 0}}</text>
                  <text>助攻 {{player.assists || 0}}</text>
                  <text>防守贡献 {{player.defensiveContribution || 0}}</text>
                  <text>BPS {{player.bps || 0}}</text>
                  <text>奖励 {{player.bonus || 0}}</text>
                  <text>扑救 {{player.saves || 0}}</text>
                  <text>牌 {{(player.yellowCards || 0) + (player.redCards || 0)}}</text>
                </view>
              </view>
            </view>

            <view wx:if="{{expandedTeam === 'away'}}" class="match-player-list">
              <view wx:if="{{match.awayMatchPlayers.length === 0}}" class="match-player-empty">暂无客队实时球员数据</view>
              <view
                wx:for="{{match.awayMatchPlayers}}"
                wx:for-item="player"
                wx:key="element"
                class="match-player-row"
                data-matchid="{{match.matchId}}"
                data-element="{{player.element}}"
                bindtap="onOpenMatchPlayer"
                hover-class="hover-dim"
              >
                <view class="match-player-row-head">
                  <text class="match-player-name">{{player.webName || player.name || '-'}}</text>
                  <text class="match-player-points">{{player.totalPoints || player.points || player.livePoints || 0}}</text>
                </view>
                <view class="match-player-stats">
                  <text>分钟 {{player.minutes || 0}}</text>
                  <text>进球 {{player.goalsScored || 0}}</text>
                  <text>助攻 {{player.assists || 0}}</text>
                  <text>防守贡献 {{player.defensiveContribution || 0}}</text>
                  <text>BPS {{player.bps || 0}}</text>
                  <text>奖励 {{player.bonus || 0}}</text>
                  <text>扑救 {{player.saves || 0}}</text>
                  <text>牌 {{(player.yellowCards || 0) + (player.redCards || 0)}}</text>
                </view>
              </view>
            </view>
          </view>
        </view>
      </view>
    </view>
  </view>
  <view class="match-share-slot">
    <canvas type="2d" id="live-match-share-canvas" class="match-share-canvas"></canvas>
  </view>
  <player-live-sheet show="{{playerDetailOpen}}" detail="{{playerDetail}}" shareable="{{true}}" shareBusy="{{playerShareBusy}}" bind:close="onClosePlayer" bind:shareimage="onSharePlayerImage" />
  <copy-fallback show="{{shareSheetOpen}}" text="{{shareText}}" bind:close="onCloseShareSheet" />
  <bottomNavBar active="live" />
</view>
