<view class="page page-tabbar">
  <block wx:if="{{!scheduleEmpty}}">
    <view class="match-toolbar">
      <view class="match-toolbar-status">
        <live-status-bar compact="{{true}}" state="{{displayState}}" lastChecked="{{lastUpdated}}" bind:refresh="onRetry" />
      </view>
      <view class="match-count match-count-{{status}}">
        <text class="match-count-number">{{matches.length}}</text>
        <text class="match-count-label">{{activeStatusLabel}}</text>
      </view>
    </view>

    <view class="status-tabs">
      <view
        wx:for="{{statusOptions}}"
        wx:key="key"
        class="status-tab {{status === item.key ? 'active' : ''}}"
        data-status="{{item.key}}"
        bindtap="onStatusTap"
        hover-class="hover-dim"
      >{{item.label}}</view>
    </view>
  </block>

  <view wx:if="{{error && !hasData}}" id="perf-primary-content">
    <app-error-state message="{{error}}" bind:retry="onRetry" />
  </view>
  <app-loading wx:elif="{{loading && !hasData}}" text="加载比赛" />
  <view wx:elif="{{scheduleEmpty}}" id="perf-primary-content" class="section">
    <app-empty-state
      eyebrow="赛季准备中"
      title="当前赛季暂无赛程"
      description="赛程公布后，这里会显示比赛状态和比分"
      actionText="重新检查"
      featured="{{true}}"
      bind:action="onRetry"
    />
  </view>
  <view wx:else id="perf-primary-content" class="match-content">
    <data-status wx:if="{{fixtureStaleMessage}}" status="stale" message="{{fixtureStaleMessage}}" transient="{{true}}" showRetry="{{true}}" bind:retry="onRetry" />
    <data-status wx:elif="{{error}}" status="stale" message="{{error}}，当前显示上次成功结果" transient="{{true}}" showRetry="{{true}}" bind:retry="onRetry" />
    <app-empty-state
      wx:if="{{matches.length === 0}}"
      title="当前没有{{activeStatusLabel}}的比赛"
      description="{{emptyDescription}}"
      actionText="重新加载"
      bind:action="onRetry"
    />
    <view wx:for="{{groups}}" wx:key="title" class="match-group">
      <view class="group-title">{{item.title}}</view>
      <view wx:for="{{item.matches}}" wx:for-item="match" wx:key="matchId" class="card match-card {{match.statusClass}}">
        <view class="match-card-head">
          <view class="status-pill">{{match.statusText}}</view>
          <view
            class="tool-btn tool-btn-labeled {{copiedMatchId === match.matchId ? 'done' : ''}}"
            data-matchid="{{match.matchId}}"
            catchtap="onCopyMatchShare"
            hover-class="hover-dim"
          >
            <image wx:if="{{copiedMatchId === match.matchId}}" class="tool-icon" src="/assets/icons/check.svg" mode="aspectFit" />
            <image wx:else class="tool-icon" src="/assets/icons/copy.svg" mode="aspectFit" />
            <text class="tool-label">{{copiedMatchId === match.matchId ? '已复制' : '分享'}}</text>
          </view>
        </view>

        <view class="scoregrid">
          <view class="team-side">
            <view class="team-name">{{match.homeTeamDisplay || '-'}}</view>
          </view>
          <view class="scoreline">
            <view class="score">{{match.scoreText}}</view>
            <view wx:if="{{match.minuteText}}" class="minute">{{match.minuteText}}</view>
          </view>
          <view class="team-side away">
            <view class="team-name">{{match.awayTeamDisplay || '-'}}</view>
          </view>
        </view>

        <view wx:if="{{match.eventSummary.length > 0}}" class="event-list">
          <view class="event-title">比赛事件</view>
          <view
            wx:for="{{match.eventSummary}}"
            wx:for-item="event"
            wx:key="kind"
            class="hl-row"
          >
            <view class="hl-badge hl-badge-{{event.kind}}">
              <view wx:if="{{event.kind === 'yellow' || event.kind === 'red'}}" class="card-glyph card-{{event.kind}}"></view>
              <image wx:else class="hl-icon" src="/assets/icons/hl-{{event.kind}}.svg" mode="aspectFit" />
            </view>
            <text class="hl-label hl-label-{{event.kind}}">{{event.label}}</text>
            <view class="hl-items">
              <view wx:for="{{event.items}}" wx:for-item="chip" wx:key="key" class="hl-item">
                <text class="hl-name">{{chip.name}}</text>
                <text wx:if="{{chip.team}}" class="hl-team">({{chip.team}})</text>
                <text wx:if="{{chip.display}}" class="hl-val hl-val-{{event.kind}}">{{chip.display}}</text>
              </view>
            </view>
          </view>
        </view>
      </view>
    </view>
  </view>
  <copy-fallback show="{{shareSheetOpen}}" text="{{shareText}}" bind:close="onCloseShareSheet" />
  <bottomNavBar active="live" />
</view>
