  "keywords": [
    "wechat-miniprogram",
    "fantasy-premier-league",
    "fpl",
    "graphql",
    "letletme"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@resvg/resvg-js": "^2.6.2",
    "eslint": "^10.2.1",
    "miniprogram-api-typings": "^2.8.3-1",
    "tsx": "^4.21.0",
    "typescript-eslint": "^8.59.1"
  },
  "main": "index.js",
  "type": "commonjs",
  "dependencies": {
    "@vant/weapp": "^1.11.7"
  }
}
