{
  "name": "letletme-wechat-miniprogram",
  "version": "1.0.0",
  "description": "Native WeChat Mini Program client for LetLetMe Fantasy Premier League live data, summaries, and statistics.",
  "scripts": {
    "lint": "eslint miniprogram/",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/**/*.test.mjs tests/**/*.test.ts",
    "check:style": "node scripts/check-style-drift.mjs",
    "assets:squad-pitch": "node scripts/convert-squad-pitch-assets.mjs",
    "package:check": "npm pack --dry-run",
    "prune:vant": "node scripts/prune-vant.mjs"
